    function LoadMenus() {
        $.ajax({
            type: 'GET',
            url: '/Home/GetMenus',
            datatype: JSON,
            success: function (data) {
                if ($.isArray(data)) {
                    CreateMenuItem(data);
                }
                else {
                    $('#renderBody').html(data);
                }
            }
        });
    }

    function OpenLI(mnuID) {
        if ($('#main').hasClass("sidebar-collapse")) {
            //WHEN MENU BAR IS CLOSED
            $("#IPMnu > li").attr("data-toggle", "push-menu");

            if ($('#IPMnu > #' + mnuID + '').hasClass("menu-open")) {
                $('#IPMnu > #' + mnuID + '').removeClass('menu-open');
                $('#IPMnu > #' + mnuID + ' > ul').css({ display: "none" });
            }
            else {
                $('#IPMnu > #' + mnuID + ' > ul').css({ display: "block" });
            }
        }
        else {
            //WHEN MENU IS OPEN, DO NOT CLOSE MENU BAR ON CLICK OF PARENT
            $('#IPMnu > li').attr("data-toggle", "");
        }
    }

        function CreateMenuItem(items, parentId) {
        $.each(items, function (index, column) {
            var mnuId = column.MnuId;
            var mnuTitle = column.MnuTitle;
            var mnuUrl = column.MnuHyperlink;
            var mnuParent = column.MnuParent;
            var mnuIcon = column.MnuIcon;
            var mnuTarget = column.MnuTarget;
            var rptCode = column.RptCode;
            var mnuType = column.MnuType;
            var MailTo = column.MailTo;
            //$('#EmailTo').attr('href', emailTo);
            //@*@ViewBag.id*@ = emailTo;
            //$('#email').append(emailTo);

            if (mnuUrl === '') {
                var html = '';

                if (mnuId === 0) {
                    html = "<li class = 'treeview' id='liParent" + mnuId + "' onclick='OpenLI(this.id);'>" +
                        "<a href='#' data-toggle='tooltip' title='" + mnuTitle + "'>" +
                        "<i class='" + mnuIcon + "'/></i>" +
                        "<span style='padding-left:5px;'>" + mnuTitle + "</span>" +
                        "<span class='pull-right-container'><i class='fa fa-angle-left pull-right'></i></span>" +
                        "</a><ul id='" + mnuId + "' class='treeview-menu'></ul></li>";
                }
                else if (site === '5' && mnuType === 'lcd') {  // Added by Tahir
                    html = "<li class='treeview' id='liParent" + mnuId + "' onclick='OpenLI(this.id);'>" +
                        "<a href='#' title='" + mnuTitle + "' data-toggle='tooltip'>" +
                        "<i class='" + mnuIcon + "' ></i>" +
                        "<span style='padding-left:5px;'>" + mnuTitle + "</span>" +
                        "<span class='pull-right-container'><i class='fa fa-angle-left pull-right'></i></span>" +
                        "</a><ul id='" + mnuId + "' class='treeview-menu'></ul></li>";
                }
                else if ((site === '8' || site === '9') && mnuType === 'itd') { // add site 9 for juarez (ITAD) show itad reports
                    html = "<li class='treeview' id='liParent" + mnuId + "' onclick='OpenLI(this.id);'>" +
                        "<a href='#' title='" + mnuTitle + "' data-toggle='tooltip'>" +
                        "<i class='" + mnuIcon + "' ></i>" +
                        "<span style='padding-left:5px;'>" + mnuTitle + "</span>" +
                        "<span class='pull-right-container'><i class='fa fa-angle-left pull-right'></i></span>" +
                        "</a><ul id='" + mnuId + "' class='treeview-menu'></ul></li>";
                }
                else if (mnuType !== 'lcd' && mnuType !== 'itd') {  // Added by Tahir
                    html = "<li class='treeview' id='liParent" + mnuId + "' onclick='OpenLI(this.id);'>" +
                        "<a href='#' title='" + mnuTitle + "' data-toggle='tooltip'>" +
                        "<i class='" + mnuIcon + "' ></i>" +
                        "<span style='padding-left:5px;'>" + mnuTitle + "</span>" +
                        "<span class='pull-right-container'><i class='fa fa-angle-left pull-right'></i></span>" +
                        "</a><ul id='" + mnuId + "' class='treeview-menu'></ul></li>";
                }
            }
            else {
                html = '<li id = "' + mnuId + '"><a onclick="Navigate(\'' + mnuTarget + '\', \''
                    + mnuUrl + '\',\'' + rptCode + '\',\'' + column.MnuTitleShort + '\',\''
                    + column.DesignedBy + '\',\'' + column.MailTo + '\');" ><i class="fa fa-circle-o"></i>' + mnuTitle + '</a></li>';

            }

            if (mnuParent == '') {
                $('#IPMnu').append(html);
            } else {
                $('#' + mnuParent).append(html);
            }

        });
    }

    function ActiveReport(rptCode, rptTitle) {
        $('#rptCode').val(rptCode);
        $('#rptTitle').val(rptTitle);
    }

    $(document).ready(function () {
        $('#Clear').click(function () {
                /*Clear all input type="text" box*/
                $('#input[type="text"]').val('');
                /*Clear textarea using id */
            $('#txtCmnt').val('');
            $('#lblMsg').empty();

        });
    });

    $('#MsgAlert').modal({
        backdrop: false,
        show: false
    });

    $('#MsgAlert').on('shown.bs.modal', function () {
        $('#MsgbtnNo').focus();
    });

    </script>

</body>
</html>
<script type="text/javascript">
    var old_browser_height = 0;
    function resize_grid_height() {
        var new_browser_height = window.innerHeight;
        var grid_height = $('.dataTables_scrollBody').height();
        if (isNaN(grid_height)) {
            return;
        }
        if (new_browser_height > old_browser_height) {
            var difference = new_browser_height - old_browser_height;
            grid_height += difference;
        }
        else {
            var difference = old_browser_height - new_browser_height;
            grid_height -= difference;
        }
        $('.dataTables_scrollBody').css('height', grid_height + 'px');
        old_browser_height = new_browser_height;
    }
    function get_initial_attributes() {
        old_browser_height = window.innerHeight;
    }

    var url = "@Url.Action("ActivityLog", "LogQueries")";

    function ShowLog() {
        var rptCode = $("#rptCode").val();
        var rptTitle = $("#rptTitle").val();
        window.open(url + "?rptCode=" + rptCode + "&rptTitle=" + rptTitle, '_blank');
    }

</script>