<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <title>Plus-RS</title>
    @System.Web.Optimization.Styles.Render("~/Content/css")

    <style>
        a {
            cursor: pointer;
        }

        .margin {
            margin: 4px;
            padding-top: 5px;
            color: white;
        }

        .dropdown {
            background-color: #29373D;
            color: white;
        }

        .modal-width {
            width: 80%;
            height: 80%;
            margin: 50px auto auto auto;
        }

        .modalcontent {
            height: 80%;
            border-radius: 0;
        }

        .logonUser {
            margin-top: 8px;
        }

        .settingIcon {
            margin-top: 2px;
        }

        /*Right Panel CSS*/

        .sidenav {
            height: 100%;
            width: 0;
            position: fixed;
            z-index: 1;
            top: 0;
            right: 0;
            background-color: #29373D;
            color: white;
            overflow-x: hidden;
            transition: 0.5s;
            padding-top: 50px;
            padding-left: 5px;
        }

        /*End Right Panel CSS*/

        .main-sidebar {
            width: 250px;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            overflow-x: hidden;
            overflow-y: auto
        }

        .ribbon {
            background-color: black;
            color: white;
            text-align: center;
            vertical-align: middle;
        }

        .skins {
            margin-top: 5px;
            padding: 5px;
        }

        .blueBall {
            color: #3C8DBC
        }

        .greenBall {
            color: #00A65A
        }

        .redBall {
            color: #DD4B39
        }

        .yellowBall {
            color: #F39C12
        }

        .aquaBall {
            color: #00C0EF
        }

        .close {
            font-size: 30px;
            font-weight: 500;
            padding-left: 2px;
            color: #FFFFFF !important;
            text-shadow: #FFFFFF !important;
        }

        .dropdown-menu {
            width: auto;
        }

        #ddCategory {
            color: black;
            margin-top: 5px;
            height: 21px;
            background-color: #EFEFEF;
        }

        option {
            background-color: #FFFFFF;
            color: #777777;
            font-size: 14px;
            font-family: Helvettica Neue, Arial, Helvetica, sans-serif;
        }

        .Dropdown {
            position: relative;
            display: inline-block;
            text-align: left;
            cursor: pointer;
            color: #000;
            transition: all 200ms ease;
        }

        #syncMessage {
            background-color: red;
            margin-top: 11px;
            margin-right: 2px;
            color: white;
            font-family: sans-serif;
            padding: 3px;
        }
    </style>
</head>
