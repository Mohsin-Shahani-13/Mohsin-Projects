<body style="background-color:#ECF0F5" onresize="resize_grid_height()" onload="get_initial_attributes()">
    <div id="wait" style="width:100%;height:100%;left:0px;top:0px; text-align:center; vertical-align:middle" class="modal">
        <img src='~/Content/images/loading2.gif' width="64" height="64" style="text-align:center; vertical-align:middle; margin-top:400px;" />
    </div>
    <div id="renderBody" class="container-fluid">
        @RenderBody()
    </div>
    <div id="option" class="modal fade" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <button type="button" id="btn_dismissclose" class="close full-opacity-hover" data-dismiss="modal">&times;</button>
                <div id="modalHeader" class="modal-header bg-blue-gradient option-title">

                </div>
                <div id="modalBody" class="modal-body">
                </div>
                <div id="modalFooter" class="modal-footer" style="color:gray; font-size:11px; text-align:left; ">
                    <span id="designedby"></span> | <a id="MailTo" href="" target="_blank" title="Click to report features and bugs">MailTo</a> |
                    <a id="ActivityLog" href="#" onclick="ShowLog()" title="Click to View Activity Log">Activity Log</a>
                </div>
            </div>
        </div>
    </div>

    <div id="wait"><img src='~/Content/images/loading2.gif' width="64" height="64" /></div>
    <div id="comments" class="modal fade" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div id="commentsheader" class="modal-header bg-blue-gradient option-title">

                </div>
                <div id="commentsbody" class="modal-body">
                </div>
            </div>
        </div>
    </div>
    <input class="desgndBy" type="hidden" />
    @System.Web.Optimization.Scripts.Render("~/bundles/jquery")
    @RenderSection("js", false)
</body>
</html>
