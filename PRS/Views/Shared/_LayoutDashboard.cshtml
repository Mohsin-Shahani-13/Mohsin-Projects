<script type="text/javascript">
    var old_browser_height = 0;
    function resize_grid_height() {
        var new_browser_height = window.innerHeight;
        var grid_height = $('.dataTables_scrollBody').height();
        if (isNaN(grid_height)) {
            return;
        }
        if (new_browser_height > old_browser_height) {
            var difference = new_browser_height - old_browser_height;
            grid_height += difference;
        }
        else {
            var difference = old_browser_height - new_browser_height;
            grid_height -= difference;
        }
        $('.dataTables_scrollBody').css('height', grid_height + 'px');
        old_browser_height = new_browser_height;
    }
    function get_initial_attributes() {
        old_browser_height = window.innerHeight;
    }

    $("#DDLDashboard").change(function () {
        var selectedVal = $(this).find(':selected').val();
        var selectedText = $(this).find(':selected').text();
        var programId = $('#DDSites :selected').val();
        var site = $('#DDSites :selected').text();
        var programName = '@HttpContext.Current.Session["DBProgram"].ToString()';

            if (selectedVal == '0') {
                OpenPage('\\dashboard\\DBIndex?');
            }
            else if (selectedVal == 'BigTv_DB' && selectedText != 'Total Shift Count') {
                OpenPage('\\MetaDiagDB\\Index?selected=' + selectedVal + '&selectedText=' + selectedText + '&programId=' + programId + '&site=' + site + '&programName=' + programName);
            }
            else if (selectedVal == 'BigTv_DB' && selectedText == 'Total Shift Count') {
                OpenPage('\\MetaDiagDB\\METACounterDB?selected=' + selectedVal + '&selectedText=' + selectedText + '&programId=' + programId + '&site=' + site + '&programName=' + programName);
            }
            else if (selectedVal == 'TrackingIssue') {
                OpenPage('\\DBTrackingIssue\\Index?selected=' + selectedVal);
            }
            else {
                OpenPage('\\dashboard\\DBIndex?');
            }

    });

    $("#DDSites").change(function () {
        var selectedVal = $('#DDLDashboard :selected').val();
        var selectedText = $('#DDLDashboard :selected').text();
        var programId = $('#DDSites :selected').val();
        var site = $('#DDSites :selected').text();
        var programName = '@HttpContext.Current.Session["DBProgram"].ToString()';

        if (selectedVal == '0') {
            OpenPage('\\dashboard\\DBIndex?');
        }
        else if (selectedVal == 'BigTv_DB' && selectedText != 'Total Shift Count') {
            OpenPage('\\MetaDiagDB\\Index?selected=' + selectedVal + '&selectedText=' + selectedText + '&programId=' + programId + '&site=' + site + '&programName=' + programName );
        }
        else if (selectedVal == 'BigTv_DB' && selectedText == 'Total Shift Count') {
            OpenPage('\\MetaDiagDB\\METACounterDB?selected=' + selectedVal + '&selectedText=' + selectedText + '&programId=' + programId + '&site=' + site + '&programName=' + programName);
        }
        else {
            OpenPage('\\dashboard\\DBIndex?');
        }

    })
