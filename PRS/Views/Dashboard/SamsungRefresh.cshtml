@model IP.Models.DashboardModel
@{
    ViewBag.Title = "Samsung Refresh";
    Layout = null;
}

<style>
    .lblFail {
        background: #DC143C;
        border: 1px solid #999999;
        color: white;
        /* font-family: Verdana; */
        text-align: center;
        padding-left: 4px;
        font-size: 40px;
    }

    .lblHold {
        background: #003f5c none repeat scroll 0 0;
        border: 1px solid #999999;
        color: white;
        /* font-family: Verdana; */
        text-align: center;
        font-size: 40px;
    }

    .ok {
        color: #30a501 !important;
    }

    .lblPass {
        /* font-family: Verdana; */
        font-size: 40px;
        font-weight: bold;
        color: #999999;
    }

    .Current {
        color: #ffa600 !important;
    }

    .cardTitle {
        color: #333333;
        /* font-family: verdana; */
        font-size: 25px;
        font-weight: bold;
        text-align: center;
        white-space: nowrap;
    }

    .firstColumn {
        display: table;
        float: left;
        margin-right: 1%;
        width: 100%;
    }

    .dashboardCosmetRight {
        float: left;
        height: 100%;
        margin: 0 1%;
        width: 33%;
    }

    .lbls {
        color: #666666;
        /* font-family: Calibri; */
        font-size: 17px;
        font-weight: bold;
        white-space: nowrap;
    }

    .card {
        margin-bottom: 20px;
    }
</style>

<head>
  
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/css/bootstrap.min.css" integrity="sha384-TX8t27EcRE3e/ihU7zmQxVncDAy5uIKz4rEkgIXeMed4M0jlfIDPvg6uqKI2xXr2" crossorigin="anonymous">
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/js/bootstrap.min.js" integrity="sha384-w1Q4orYjBQndcko6MimVbzY0tgp4pWB4lZ7lr30WKz0vr/aWKhXdBNmNb5D92v7s" crossorigin="anonymous"></script>
</head>

<div class="container-fluid" id="lst">
    <div class="col" style="padding-top:30px;">
        <div id="lstStations"></div>
        @if (Model.dtStations.Rows.Count > 0)
        {
            foreach (System.Data.DataRow row in Model.dtStations.Rows)
            {
                if (row["STATION"].ToString() == "FCT")
                {
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="card cardShadow p-3 mb-5 bg-white rounded">
                            <div class="card-block">
                                <table class="firstColumn">
                                    <tr>
                                        <td class="cardTitle" colspan="4" style="text-align:center;">@row["STATION"].ToString()</td>
                                    </tr>
                                    <tr>
                                        <td class="lbls">Current</td>
                                        <td class="lblPass Current">@row["crnt"].ToString()</td>
                                        <td class="lbls">Loss</td>
                                        <td class="lblFail">@row["LOSS"].ToString()</td>
                                    </tr>
                                    <tr>
                                        <td class="lbls">Pass</td>
                                        <td class="lblPass ok">  @row["PASS"].ToString()</td>
                                        <td class="lbls">Hold</td>
                                        <td class="lblHold">  @row["HOLD"].ToString()</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                else if (row["STATION"].ToString() == "WASH")
                {
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="card cardShadow p-3 mb-5 bg-white rounded">
                            <div class="card-block">
                                <table class="firstColumn">
                                    <tr>
                                        <td class="cardTitle" colspan="4" style="text-align:center;">@row["STATION"].ToString()</td>
                                    </tr>
                                    <tr>
                                        <td class="lbls">Current</td>
                                        <td class="lblPass Current">@row["crnt"].ToString()</td>
                                        <td class="lbls">Loss</td>
                                        <td class="lblFail">@row["LOSS"].ToString()</td>
                                    </tr>
                                    <tr>
                                        <td class="lbls">Pass</td>
                                        <td class="lblPass ok">  @row["PASS"].ToString()</td>
                                        <td class="lbls">Hold</td>
                                        <td class="lblHold">  @row["HOLD"].ToString()</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                else if (row["STATION"].ToString() == "QUICK_TEST")
                {
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="card cardShadow p-3 mb-5 bg-white rounded">
                            <div class="card-block">
                                <table class="firstColumn">
                                    <tr>
                                        <td class="cardTitle" colspan="4" style="text-align:center;">@row["STATION"].ToString()</td>
                                    </tr>
                                    <tr>
                                        <td class="lbls">Current</td>
                                        <td class="lblPass Current">@row["crnt"].ToString()</td>
                                        <td class="lbls">Loss</td>
                                        <td class="lblFail">@row["LOSS"].ToString()</td>
                                    </tr>
                                    <tr>
                                        <td class="lbls">Pass</td>
                                        <td class="lblPass ok">  @row["PASS"].ToString()</td>
                                        <td class="lbls">Hold</td>
                                        <td class="lblHold">  @row["HOLD"].ToString()</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                }

            }
        }


        <div class="col-12 col-sm-6 col-md-4">
            <div class="card cardShadow p-3 mb-5 bg-white rounded">
                <div class="card-block">
                    <table id="lastData" class="firstColumn" border="1" style="background-color:whitesmoke">
                        <tr>
                            <td rowspan="2" class="lblFail">Fail</td>
                            <td>&nbsp;</td>
                            <td class="lbls">Current</td>
                            <td class="lbls">Target</td>

                        </tr>
                        @if (Model.dtCurrent.Rows.Count > 0)
                        {
                            foreach (System.Data.DataRow row in Model.dtCurrent.Rows)
                            {
                                if (row["SHIFT"].ToString() == "1")
                                {
                                    <tr>
                                        <td style="text-align:center" class="lbls">Morning Shift</td>
                                        <td class="lbls" style="text-align:center">@row["CURRENT_UNIT"].ToString()</td>
                                        <td rowspan="4" class="lbls" style="text-align:center">12500</td>
                                    </tr>
                                }

                                if (row["SHIFT"].ToString() == "2")
                                {
                                    <tr>
                                        <td rowspan="2" class="lblHold">Hold</td>
                                        <td style="text-align:center" class="lbls">Afternoon Shift</td>
                                        <td style="text-align:center" class="lbls">@row["CURRENT_UNIT"].ToString()</td>

                                    </tr>
                                }
                                if (row["SHIFT"].ToString() == "3")
                                {
                                    <tr>
                                        <td style="text-align:center" class="lbls">Night Shift</td>
                                        <td style="text-align:center" class="lbls">@row["CURRENT_UNIT"].ToString()</td>
                                    </tr>
                                }
                            }
                        }
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    $(document).ready(function () {
        setInterval(function () {
            cache_clear()
        }, 3000);
    });
    function cache_clear() {
        // window.location.reload(true);
        OpenPage('\\Dashboard\\SamsungRefresh?');
        // window.location.reload(); use this if you do not remove cache
    }
</script>

