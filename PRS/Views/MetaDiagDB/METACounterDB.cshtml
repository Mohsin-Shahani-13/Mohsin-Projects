<script>

    $(document).ready(function () {
        setInterval(function () {
            LoaData();
        }, 300000);
    });

    ToggleDataList(false);
    LoaData();

    function LoaData() {

        var selectedVal = '@Request.QueryString["selected"]';
        var programId = '@Request.QueryString["programId"]';
        var selectedText = '@Request.QueryString["selectedText"]';
        var site = '@Request.QueryString["site"]';
        var programName = '@Request.QueryString["programName"]';


        $.ajax({
            cache: false,
            type: 'GET',
            url: '/MetaDiagDB/GetCounterDB',
            data: {
                selectedVal: selectedVal,
                selectedText: selectedText,
                programId: programId,
                site: site,
                programName: programName
            },
            datatype: JSON,
            success: function (response) {
                if (response.error) {
                    console.error("Error:", response.error);
                    return;
                }

                // Update HTML with DBTitle (optional)
                $('#DBTitle').text(response.DBTitle);

                // Populate HTML with data sections
                $.each(response.Data, function (section, values) {
                    $('#' + section.toLowerCase() + ' .operators').text(values.Operators);
                    $('#' + section.toLowerCase() + ' .qTotal').text(values.qTotal);
                    $('#' + section.toLowerCase() + ' .productivity').text(values.Productivity);
                });
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }

</script>
