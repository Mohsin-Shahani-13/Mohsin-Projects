<script>
    
    function DisplayImage(ImageDataID) {
        $.ajax({
            cache: false,
            type: 'GET',
            url: '/CodeTableListing/GetImage',
            data: {
                imageDataId: ImageDataID
            },
            datatype: JSON,
            success: function (data) {
                $('#commentsheader').html('Picture' + '<button type="button" class="close full-opacity-hover" data-dismiss="modal" style="margin-top:-7px;">&times;</button>');
                if (data.ImageBase64String !== null) {
                    $('#commentsbody').html('<img src="data:image/png;base64,' + data.ImageBase64String + '" width="100%" height="35%"/>');
                } else {
                    $('#commentsbody').html('Image not available.');
                }
                $('#comments').modal('show');
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
    function ShowData(item) {
        $('#datamodel').modal('show');
        $('.showdata').html('<textarea rows="15" cols="70" name="usrtxt" white-space: no-wrap;>"'+decodeURI(item)+ '"</textarea > ');
        //// $('#myFunction').modal('hide');
        $('#datamodel').modal();
    }

    function ShowDataForTrackingNumber(item) {
        $('#datamodel2').modal('show');
        $('.ShowDataForTrackingNumber').html('<textarea rows="15" cols="70" name="usrtxt" white-space: no-wrap;>"'+ item +'"</textarea > ');
        //// $('#myFunction').modal('hide');
        $('#datamodel2').modal();
    }

    $.fn.dataTable.render.ellipsisAdr1 = function (cutoff) {
        return function (data, type, row) {
            if (type === 'display') {
                var str = data.toString().replace(/(\r\n|\n|\r|'|)/gm, "");
                //str = str.replaceAll(/'/g, '"');
                //var header = data;
                return str.length < cutoff ?
                    str :
                    str.substr(0, cutoff - 1) + '<a href="#" onclick="ShowDataForTrackingNumber(\''+ str +'\')"> See More</a>';
            }
            // Search, order and type can use the original data
            return data;
        };
    };

    $.fn.dataTable.render.ellipsisAdr2 = function (cutoff) {
        return function (data, type, row) {
            if (type === 'display') {
                var str = data.toString().replace(/(\r\n|\n|\r|'|)/gm, "");
                //str = str.replaceAll(/'/g, '"');
                //var header = data;
                return str.length < cutoff ?
                    str :
                    str.substr(0, cutoff - 1) + '<a href="#" onclick="ShowData(\'' + str + '\')"> Show Data</a>';
            }
            // Search, order and type can use the original data
            return data;
        };
    };

