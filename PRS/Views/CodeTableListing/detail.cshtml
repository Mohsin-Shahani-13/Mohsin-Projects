<style>

    .Part_Undrln {
        text-decoration: underline;
    }

    .leftsection {
        text-align: center;
        /*padding-top: 50px;*/
    }

    /*remove sql doc button added by mohsin*/
    #showQuery {
        visibility: hidden;
        position: absolute;
    }

    .modal-backdrop.in {
        filter: alpha(opacity=0);
        opacity: .0;
    }

    .modal-backdrop {
        position: relative;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 1040;
        background-color: #000;
    }

    textarea {
        resize: none !important;
    }

    .notexport {
