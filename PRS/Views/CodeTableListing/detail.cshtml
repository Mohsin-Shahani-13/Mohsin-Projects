                    </div>
                </div>
                <div class="box-body">
                    <table id="lstData" class="table table-bordered table-striped text-sm">
                        <thead>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
