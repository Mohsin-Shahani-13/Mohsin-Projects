    <!-- Modal -->
    <div class="modal bd-example-modal-sm" tabindex="-1" id="myModal" role="dialog">
        <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content modal-sm">
                <div class="header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Forgot Password</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Username:</label>
                        <input type="text" class="form-control" id="name" placeholder="Enter Username" autofocus="autofocus" />
                    </div>
                    @*<div class="form-group">
                            <label>Vendor Id:</label>
                            <input type="text" class="form-control" id="ProgramId">
                        </div>*@
                </div>
                <div class="modal-footer">

                    <button id="btnSend" type="button" class="button">Reset Password</button>
                    <button id="btnCancel" data-dismiss="modal" class="cancel btn btn-default">Close</button>
                </div>
                <div class="optionMsg" style="text-align:center;height:20px;">
                    <label id="lblMsgEmail" class="optionMsg">
                    </label>
                </div>
            </div>
        </div>
    </div>
    <script src="~/Scripts/jquery.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>

</body>

<script>

    function Login() {

          if ($("#txtUserName").val()=="") {
                $("#lblMsg").html("Username is required");
                $("#txtUserName").focus();
                return false;
            }
            if ($("#txtPwd").val() == "") {
                $("#lblMsg").html("Password is required");
                $("#txtPwd").focus();
                return false;
            }
            else {

                $(document).ajaxStart(function () {
                    // Show image container
                    $("#load").show();
                });
            var data = {
                "username": $("#txtUserName").val(),
                "password": $("#txtPwd").val(),
                "ddlDomain": $("#ddlDomain").val()
            };
            $.ajax({
                url: "/Home/ValidateUser",
                type: "POST",
                data: JSON.stringify(data),
                dataType: "json",
                contentType: "application/json",
                success: function (status) {
                    $(document).ajaxComplete(function () {

                        // Hide image container
                        $("#load").hide();
                    });
                    $("#lblMsg").html(status.Message);
                    if (status.Success) {
                        window.location.href = '@Url.Action("Base","Home")';
                    }
                    else {
                        $("#lblMsg").html(status.Message);
                    }
                },
                error: function () {

            }
            });

            }

    }
    function getCurrentYear() {
        // Create a new Date object
        var currentDate = new Date();

        // Get the current year
        var currentYear = currentDate.getFullYear();
        var copyright = document.getElementById('copyright');
        copyright.innerHTML = 'Copyright ' + currentYear + ' © Reconext, All Rights Reserved.';
    }
    //When press Enter
    function GoLoginOnEnter() {

        if (event.keyCode == 13) {
            Login();
        }
    }

    $(document).ready(function () {
        getCurrentYear();
        $("#btnSubmit").click(function () {
            Login();
        });
    });
    const notes = document.querySelectorAll('.ani-boxes > div')

    for (var i = 0; i < notes.length; i++) {

        notes[i].addEventListener('mouseenter', function (e) {
            const ani = e.target.dataset.ani;
            e.target.classList.add('animated', 'infinite', ani);
            window.setTimeout(function () {
                e.target.classList.remove('animated', 'infinite', ani);
            }, 3000);
        });
    }
</script>

<script>

    $("#btnSend").attr("disabled", false).removeClass("forgotColor");
    function FieldsIsValid() {
        var _userName = $('#name').val();
        //var _ProgramId = $('#ProgramId').val();

        if (_userName.length == 0) {
            $('#lblMsgEmail').empty();
            $('#lblMsgEmail').append("Enter Userame");
            $('#lblMsgEmail').removeClass('SeaGreenColor');
            return false;
        }

        //if (_ProgramId.length == 0) {
        //    $('#lblMsgEmail').empty();
        //    $('#lblMsgEmail').append("Enter Vendor Id");
        //    $('#lblMsgEmail').removeClass('SeaGreenColor');
        //    return false;
        //}

        else {
            $('#lblMsgEmail').empty();
            return true;
        }
    }
    $(".cancel").click(function () {
        $('#myModal').on('hidden.bs.modal', function () {
            $("#btnSend").attr("disabled", false).removeClass("forgotColor");


            $('#name').val('');
            //$('#ProgramId').val('');
            $('#name').empty();
            //$('#ProgramId').empty();
            $('#name').removeAttr('style');
            //$('#ProgramId').removeAttr('style');
            $('#lblMsgEmail').empty();
        })
    });
    $("#btnSend").click(function () {

        var retVal = FieldsIsValid();

        if (retVal == true) {
            $("#btnSend").attr("disabled", true).addClass('forgotColor');
            $('#lblMsgEmail').empty();
            $('#name').text('');
            //$('#ProgramId').text('');
            var _userName = $('#name').val();
            //var _ProgramId = $('#ProgramId').val();

            var dateObj = new Date();
            var month = dateObj.getUTCMonth() + 1; //months from 1-12
            var day = dateObj.getUTCDate();
            var year = dateObj.getUTCFullYear();
            var time = dateObj.getHours() + ":" + dateObj.getMinutes() + ":" + dateObj.getSeconds();

            newdate = year + "/" + month + "/" + day + " " + time;

            $.ajax({
                type: 'GET',
                url: '@Url.Action("SendMail", "Home")',
                data: {
                    SignInId: _userName,
                    //ProgramId: _ProgramId,
                    requestedOn: newdate
                },
                datatype: JSON,
                success: function (data) {

                    $('#lblMsgEmail').empty();
                    if (data.EmailMessage == "Email sent.") {
                        $('#lblMsgEmail').append(data.EmailMessage);
                        $('#lblMsgEmail').addClass('SeaGreenColor');

                    }
                    else {
                        $('#lblMsgEmail').append(data.EmailMessage);
                        $('#lblMsgEmail').removeClass('SeaGreenColor');
                        $("#btnSend").attr("disabled", false).removeClass('forgotColor');
                    }
                }
            });
        }
    });

    $('#myModal').on('hidden.bs.modal', function () {
        $("#btnSend").attr("disabled", false).removeClass("forgotColor");

        $('#name').val('');
        //$('#ProgramId').val('');
        $('#name').empty();
        //$('#ProgramId').empty();
        $('#name').removeAttr('style');
        //$('#ProgramId').removeAttr('style');
        $('#lblMsgEmail').empty();

    })


</script>