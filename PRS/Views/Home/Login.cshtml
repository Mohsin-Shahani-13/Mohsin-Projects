<title>Plus-RS</title>
<body id="mainDiv" style="background-color:#F3F2EF">
    <!-- Modal HTML -->
    <div class="container center">

        <div class="row">
            <div class="col-md-12">
                <div class="app">
                    <div class="bg"></div>

                    <header>
                        @*<label style="position:relative;color:white;font-size:26px;">Sign in</label>*@
                        <div style="position:relative; margin-left:20px">
                            <img src="~/Content/Images/Plus.png" style=" height:40px;" />
                        </div>
                    </header>

                    <div class="inputs" style="padding-top:25px;">
                        <div class="form-group">
                            <div class="input-group">
                                <span class="input-group-addon"><i class="fa fa-user"></i></span>
                                @Html.TextBoxFor(model => model.SigninId, htmlAttributes: new { @autofocus = "autofocus", @class = "form-control", @placeholder = "Username", @id = "txtUserName" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="input-group">
                                <span class="input-group-addon"><i class="fa fa-lock"></i></span>
                                @Html.PasswordFor(model => model.Password, htmlAttributes: new { @class = "form-control", @placeholder = "Password", @id = "txtPwd", onkeydown = "GoLoginOnEnter()" })
                                @Html.ValidationMessageFor(model => model.Password)
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="input-group">
                                <span class="input-group-addon"><i class="fa fa-server"></i></span>
                                <select class="form-control select-input placeholder-active active focused" name="ddlDomain" id="ddlDomain">
                                    <option value="reconext">Reconext</option>
                                    <option value="teleplan">TGN</option>
                                    <option value="Valuout">Valuout</option>
                                </select>
                            </div>
                        </div>

                        @*<div align="center" style="font-size:13px;">

                                @Html.Captcha(5)
                            </div>*@
                        <br />
                        <br />
                        @*<label style="font-size:12px; white-space:nowrap;float:right;padding-top:15px;">
                                New user? <a title="Create new user" href="@Url.Action("Register", "Home")">Register</a>
                            </label>*@
                        <div class="form-group" style="padding-top:32px;">
                            <button id="btnSubmit" type="submit" class="btnLogin" onkeydown="GoLoginOnEnter()">Sign In</button>

                        </div>

                        @*<div style="text-align:right; font-size:12px;">
                                <a data-toggle="modal" href="#myModal">Forgot Password?</a>
                            </div>*@
                        <label id="copyright" style="font-size:12px; white-space:nowrap; padding-top:56px;">

                        </label>
                        @*<div class="form-group" style="padding-top:24px;">
                                <label style="font-size:10px; white-space:nowrap; text-align:center;">
                                    Copyright 2020 © Reconext, All Rights Reserved
                                </label>
                            </div>*@
                    </div>


                    <footer data-ani="pulse">
                        <div id="lblMsg" class="optionMsg" style="text-align:center; color:red">

                        </div>
                        <div id="load" style='display: none;'>
                            <img src='~/Content/images/Loading.gif' width="100" height="100" style="text-align:center; vertical-align:middle; margin-top:400px;" />
                        </div>
