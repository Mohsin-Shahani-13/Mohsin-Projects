@{
    ViewBag.Title = "Base";
    if (Request.QueryString["page"] == "list")
    { Layout = cCommon.SwitchToDetailPage(Request.Url.PathAndQuery); }
    else
    { Layout = "~/Views/Shared/_Layout.cshtml"; }
}

@section js{
    <script type="text/javascript">

        var IsReportViewer = '@Request.QueryString["IsReportViewer"]';

        if (IsReportViewer == '')
            OpenPage('/Dashboard/Index');
        else {
            LoadData();
        }

        function LoadData() {
            $.ajax({
                cache: false,
                type: 'GET',
                url: '/General/GetReport',
                data: { rptId: '@Request.QueryString["RptId"]', IsRpt: '@Request.QueryString["IsRpt"]' },
                datatype: JSON,
                success: function (data) {
                    data.Url = data.Url.replace('\\', '');
                    Navigate(data.Target, data.Url, data.RptCode, data.Name, data.DesignedBy, data.MailTo);
                },
                onerror: function (r) { r },
                failure: function (r) { r }
            });
        }

