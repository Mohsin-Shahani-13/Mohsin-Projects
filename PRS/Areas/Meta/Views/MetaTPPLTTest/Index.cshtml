@model IP.Areas.Meta.Models.MetaTPPLTTest
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<div id="parentDiv" class="container">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool">
                @*title="Option Page" onclick="$('#option').modal('show');"*@
                <span class="fa fa-list fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">
            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstMetaTPPLTTest" class="table table-bordered table-striped text-sm table-hover" width="100%">
                <thead class="sorted-asc">
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        @*<th></th>*@
                    </tr>
                </thead>
                @*<tbody id="tblBody"></tbody>*@
                <tfoot>
                    <tr>
                        @*<th>Total :</th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>*@
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>


    ToggleDataList(false);
    LoadData();
    function LoadData() {
        
        $('#tblBody').empty();

        $('#option').modal('hide');


        var isSingleRow = false;
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/MetaTPPLTTest/GetList',
            data: {
                programId: _programId,
                ProgramName: _ProgramName
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        //{ "data": "ID", "title": "ID", "width": "40px", "visible": false },
                        { "data": "ProgramID", "title": "Program ID", "width": "70px" },
                        { "data": "WorkstationDescription", "title": "Work Station Desc.", "width": "110px" },
                        { "data": "ID", "title": "ID", "width": "60px" },
                        {
                            "data": "partno", "title": "Part No.", "width": "80px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["partno"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SerialNo", "title": "Serial No.",
                            render: function (data, type, row) {
                                if (row["serialno"] == "*" || row["HAS_SN"] == 'N') {
                                    url = row["serialno"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["partno"] + '&page=list" target=_blank > ' + data + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "StatusDescription", "title": "Status Desc.", "width": "80px" },
                        { "data": "PalletBoxNo", "title": "Pallet Box No.", "width": "80px" },
                        { "data": "wdr", "title": "WDR", "width": "60px" },
                        { "data": "LocationNo", "title": "Location No.", "width": "80px" },
                        { "data": "TriageGrade", "title": "Triage Grade", "width": "70px" }
                    ];

                    ToggleDataList(true);
                    
                    MakeDataGrid('lstMetaTPPLTTest', data.lstMetaTPPLTTest, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }

</script>



