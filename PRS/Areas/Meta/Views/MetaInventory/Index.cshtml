@model IP.Areas.Meta.Models.MetaInventory
@{
    ViewBag.Title = "Index";
    Layout = null;
}


<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstMetaInventory" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        @*<th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>*@
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        @*<th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>*@
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>
    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');

        var isSingleRow = false;
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();
        var _partno = $('#PartNo').val();
       

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/MetaInventory/GetList',
            data: {
                programId: _programId,
                ProgramName: _ProgramName,
                PartNo: _partno

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [

                        { "data": "ID", "title": "Id", "width": "40px", "visible": false },
                        { "data": "ProgramID", "title": "Id", "width": "40px", "visible": false },
                        // { "data": "Region", "title": "Region", "width": "40px" },
                        { "data": "ProgramName", "title": "Program", "width": "40px" },
                       /* { "data": "Region", "title": "Region", "width": "40px" },*/
                        {
                            "data": "partno", "title": "PartNo.", "width": "90px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\RO\\Detail?Id=' + row["ID"] + '&PartNo.=' + row["Partno"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "UnitOfMeasure", "title": " Unit Of Measure", "width": "70px" },
                        { "data": "WareHouse", "title": "Ware House", "width": "70px" },
                        { "data": "location", "title": "Location", "width": "100px" },
                        { "data": "Total", "title": "Total", "width": "70px" },
                        { "data": "source", "title": "Source", "width": "100px" },
                        { "data": "timestamp", "title": "TimeStamp", "width": "90px" },
  
                        //{
                        //    "data": "PartNo", "title": "PartNo.", "width": "100px",
                        //    render: function (data, type, row) {
                        //        var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PART_NO"] + '&page=list" target=_blank > ' + data + '</a>';
                        //        return url;
                        //    }
                        //},
                        { "data": "DESCRIPTION", "title": "Part Description", "width": "220px" },
                        { "data": "Family", "title": "Family", "width": "100px" },
                        /*{ "data": "DockDate", "title": "Dock On", "width": "100px", "className": "text-right" },*/

                        //{
                        //    "data": "SERIAL_NO", "title": "SerialNo.", "width": "90px",
                        //    render: function (data, type, row) {
                        //        if (row["SERIAL_NO"] == "*" || row["HAS_SN"] == 'N') {
                        //            url = row["SERIAL_NO"];
                        //        }
                        //        else {
                        //            var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["SERIAL_NO"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PART_NO"] + '&page=list" target=_blank > ' + data + '</a>';
                        //        }
                        //        return url;
                        //    }

                        //},
                        { "data": "QUANTITY", "title": "Qty", "width": "40px", "className": "text-right" },
                        //// { "data": "WORK_TYPE_ID", "title": "Work Type Id", "width": "90px" },
                        //{ "data": "TYPE_DESIGNATION", "title": "Type Designation", "width": "90px" },
                        //{ "data": "RECEIVED_BY", "title": "Received By", "width": "90px" },




                        /* { "data": "DATE_TIME", "title": "Received On", "width": "110px", "className": "text-right" },*/
                        //{ "data": "DATE_APPLIED", "title": "On", "width": "110px", "className": "text-right" }


                    ];

                    ToggleDataList(true);
                   /* For Displaying  Footer Sum;*/
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(10).footer()).html(thousands_separators(api.column(10, { search: 'applied' }).data().sum()));
                    //    //  $(api.column(4).footer()).html(thousands_separators(api.column(4, { search: 'applied' }).data().sum()));

                        }
                        MakeDataGrid('lstMetaInventory', data.lstMetaInventory, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>