@model IP.Areas.Meta.Models.MetaTrackDataWipeCompliance

@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        /*width: 180px;*/
        padding: 10px 6px 15px;
    }
</style>
<table class="fullWidth">
    @*<tr>
            <td colspan="4" class="pad">
                @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
                @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
            </td>
        </tr>*@


    <tr>
        <td class="pad">

            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="dateFont" style="padding-left: 5px;">
            <div>
                <br />
                <label for="_isAllDate" style="font-size: 15px;">
                    <input type="checkbox" id="isAllDate" name="isAllDate" onclick="EnableDisableDateInput(this)" />
                    All
                </label>
            </div>
        </td>
        @*<td class="dateFont ">
                <div class="padding-top-6">
                    <br />
                    <label for="_DockAllDate" style="margin-left:0px">

                        <input type="checkbox" id="isAllDate" name="DockAllDate" onclick="EnableDisableDateInput(this)" />
                        All
                    </label>
                </div>
            </td>*@
    </tr>
    <tr>
        <td class="pad">
            <strong>Data Wipe Complete:</strong>
            <select class="form-control" id="TestFilter">
                <option selected value="All">All</option>
                <option value="Y">Y</option>
                <option value="N">N</option>
            </select>
        </td>
        <td class="pad">
            <strong>Data Wipe Test Performed 24 Hrs:</strong>
            <select class="form-control" id="DataWipeTestPerformed24HrsFilter">
                <option selected value="All">All</option>
                <option value="Y">Y</option>
                <option value="N">N</option>
            </select>
        </td>

    </tr>
    <tr>
        <td class="pad">
            <strong>Data Wipe Result:</strong>
            <select class="form-control" id="DataWipeResult">
                <option selected value="All">All</option>
                <option value="Pass">Pass</option>
                <option value="Test Not Performed">Test Not Performed</option>
                <option value="Fail">Fail</option>
            </select>
        </td>
        <td class="pad">
            <strong>FA Filter:</strong>
            <select class="form-control" name="" id="FAFilter">
                <option selected value="All">All</option>
                <option value="FA Unit">FA Unit</option>
                <option value="Non-FA Unit">Non-FA Unit</option>
            </select>
        </td>

    </tr>
    <tr>
        <td class="pad">
            <strong>Bounce Filter:</strong>
            <select class="form-control" id="BounceFilter">
                <option selected value="All">All</option>
                <option value="Bounce Unit">FA Bounce Unit</option>
                <option value="Non-Bounce Unit">Non-Bounce Unit</option>
            </select>
        </td>
        <td class="pad">
            <strong>Problem Log Filter:</strong>
            <select class="form-control" id="LogFilter">
                <option selected value="All">All</option>
                <option value="Problem Log">Problem Log</option>
                <option value="Not Problem Log">Not Problem Log</option>
            </select>
        </td>

    </tr>
    <tr>
        <td class="pad">
            <strong>Lock Device Filter:</strong>
            <select class="form-control" id="ListFilter">
                <option selected value="All">All</option>
                <option value="Lock Transaction Unit">Lock Transaction Unit</option>
                <option value="Normal Unit">Normal Unit</option>
            </select>
        </td>
        <td class="pad">
            @Html.LabelFor(model => model.model, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddModel", null, new { id = "ddModel", @name = "ddModel", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    
    <tr>
        <td colspan="2" class="pad">
            <strong>Docklog to Current Date TAT:</strong>
            <select class="form-control" id="IdleFilter">
                <option selected value="All">All</option>
                <option value="0-12">0-12 hours</option>
                <option value="12-16">12-16 hours</option>
                <option value="16-20">16-20 hours</option>
                <option value="20-24">20-24 hours</option>
                <option value="24-28">24-28 hours</option>
                <option value="28-32">28-32 hours</option>
                <option value="> 32">> 32 hours</option>
            </select>
        </td>
    </tr>
</table>
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<script>
    $('#option').on('shown.bs.modal', function () {

    });

    

    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {

        //debugger

        var date = new Date();
        var newdate = new Date();
        //For From Date
        newdate.setDate(newdate.getDate() - 14);

        //var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-14d',
        endDate: maxDate
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }
    function EnableDisableDateInput(isAllDate) {
        $('#lblMsg').empty();
        var isAllDate = $('#isAllDate').is(':checked');
        document.getElementById("fromDt").disabled = isAllDate;
        var nodes1 = document.getElementById("fromDt").getElementsByTagName('*');
        document.getElementById("toDt").disabled = isAllDate;
        var nodes1 = document.getElementById("toDt").getElementsByTagName('*');
        for (var i = 0; i < nodes1.length; i++) {
            nodes1[i].disabled = isAllDate;
        }
    };


    

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();

        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }
    }

    function Go() {

        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        //var programId = $('#ProgramID').val();
        //var ProgramName = $("#ProgramID option:selected").text();
        var faFilter = $('#FAFilter option:selected').val();
        var bounceFilter = $('#BounceFilter option:selected').val();
        var TestFilter = $('#TestFilter option:selected').val();
        var DataWipeTestPerformed24HrsFilter = $('#DataWipeTestPerformed24HrsFilter option:selected').val();
        var LogFilter = $('#LogFilter option:selected').val();
        var ListFilter = $('#ListFilter option:selected').val();
        var IdleFilter = $('#IdleFilter option:selected').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var DataWipeResult = $('#DataWipeResult option:selected').val();
        var Model = $('#ddModel option:selected').val();

        $('#option').modal('hide');
        OpenPage('\\Meta\\MetaTrackDataWipeCompliance\\Index?frmDt=' + fDate + ' &toDt=' + tDate + '&isAllDate=' + isAllDate + '&faFilter=' + faFilter + '&bounceFilter=' + bounceFilter + '&TestFilter=' + TestFilter + '&DataWipeTestPerformed24HrsFilter=' + DataWipeTestPerformed24HrsFilter + '&LogFilter=' + LogFilter + '&ListFilter=' + ListFilter + '&IdleFilter=' + IdleFilter + '&DataWipeResult=' + DataWipeResult + '&Model=' + Model + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>
