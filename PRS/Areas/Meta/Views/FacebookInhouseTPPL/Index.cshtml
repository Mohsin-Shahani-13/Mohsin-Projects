<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();
        //$('#lstROH').DataTable().clear();
        //$('#lstROH').DataTable().destroy();

        $('#option').modal('hide');
        var isSingleRow = false;
        //var fDate = $('#fromDt').val();
        //var tDate = $('#toDt').val();
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();
        var _partNo = $('#partNo').val();
        var _Warehouse = $('#ddlwarehouse').val().join(',');

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/FacebookInhouseTPPL/GetList',
            data: {
                //frmDt: fDate,
                //toDate: tDate,
                programId: _programId,
                ProgramName: _ProgramName,
                partNo: _partNo,
                warehouse: _Warehouse
            },
            datatype: JSON,
            success: function (data) {

                $('#filterString').append(data.filterString);
                //$('#lstROH').DataTable().clear();
                //$('#lstROH').DataTable().destroy();

                var columnDef = [
                    { "data": "ProgramID", "title": "Program ID", "width": "100px", "visible": false },
                    {
                        "data": "SerialNo", "title": "Serial No.", "width": "120px",
                        render: function (data, type, row) {

                            if (row["SerialNo"] == '*' || row["HAS_SN"] == 'N') {
                                url = row["SerialNo"];
                            }
                            else {
                                var url = '<a href= \\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                            }
                            return url;
                        }
                    },
                    { "data": "ServiceRequestNo", "title": "Service Req. No.", "width": "120px" },
                    { "data": "WOUnitId", "title": "WOUnitId", "width": "50px", "visible": false },
                    { "data": "RegDate", "title": "Reg. Date", "width": "90px", "className": "text-right" },
                    { "data": "state", "title": "State", "width": "80px" },

                    {
                        "data": "PartNo", "title": "Part No.", "width": "120px",
                        render: function (data, type, row) {
                            var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                            return url;
                        }
                    },
                    { "data": "Description", "title": "Description", "width": "220px" },
                    { "data": "ModelNo", "title": "Model No.", "width": "120px" },
                    { "data": "LocationNo", "title": "Location No.", "width": "120px" },
                    { "data": "PalletLocation", "title": "Pallet Location", "width": "90px" },
                    { "data": "Disposition", "title": "Disposition", "width": "90px" },
                    { "data": "Configuration", "title": "Configuration", "width": "90px" },
                    { "data": "WorkStationId", "title": "Work Station Id", "width": "90px", "visible": false },
                    { "data": "WorkCenterNo", "title": "Work Center No.", "width": "120px" },
                    { "data": "WorkstationDescription", "title": "Workstation Desc.", "width": "120px" },
                    { "data": "OrderNo", "title": "Order No.", "width": "70px" },
                    { "data": "TypeDesignation", "title": "Type Desg.", "width": "90px" },
                    { "data": "Qty", "title": "Qty", "width": "50px", "className": "text-right" },
                    //{ "data": "WorkTypeId", "title": "WorkTypeId", "visible": false  },
                    { "data": "Warehouse", "title": "Warehouse", "width": "80px" },
                    { "data": "OrderState", "title": "Order State", "width": "110px" },
                    { "data": "Wdr", "title": "Wdr", "width": "80px" },
                    { "data": "LastTestResult", "title": "Last Test Result", "width": "90px" },
                    { "data": "LastFaultTesterOrManual", "title": "Last Fault Tester Or Manual", "width": "150px" },
                    { "data": "TriageGrade", "title": "Triage Grade", "width": "70" },
                    { "data": "FinalGrade", "title": "Final Grade", "width": "70px" }
                ]
                //For Displaying  Footer Sum
                var footerfunc = function () {
                    var api = this.api();
                    $(api.column(14).footer()).html(thousands_separators(api.column(14, { search: 'applied' }).data().sum()));
                }



                ToggleDataList(true);
                MakeDataGrid('lstInhouseTPPL', data.lstInhouseTPPL, 0, columnDef, true, true, false);
                //MakeFrameGrid('lstInhouseTPPL', lstInhouseTPPL, 600, columnDef, false, true, true, false, false, false, false);
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });


    }
</script>