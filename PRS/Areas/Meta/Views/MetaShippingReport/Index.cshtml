@model IP.Areas.Meta.Models.MetaShippingReport
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstMetaShipping" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th  class="notexport"></th>
                        <th  ></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');

        var isSingleRow = false;
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();
        var _PartNo = $('#PartNo').val();
       
        $.ajax({

            cache: false,
            type: 'GET',
            url: '/MetaShippingReport/GetList',
            data: {

                programId: _programId,
                ProgramName: _ProgramName,
                PartNo: _PartNo
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ID", "title": "ID", "width": "40px", "visible": false },
                        { "data": "ProgramName", "title": "Program", "width": "40px" },
                        { "data": "TRANSACTION_ID", "title": " Transaction Id", "width": "70px" },
                        {
                            "data": "PART_NO", "title": " Part No.", "width": "70px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PART_NO"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                          
                        },
                        {
                            "data": "DESCRIPTION", "title": "Part Description", "width": "150px"
                          
                        },
                        {
                            "data": "SERIAL_NO", "title": "Serial No.", "width": "90px",
                            render: function (data, type, row) {
                                if (row["SERIAL_NO"] == "*" || row["HAS_SN"] == 'N') {
                                    url = row["SERIAL_NO"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["SERIAL_NO"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PART_NO"] + '&page=list" target=_blank > ' + data + '</a>';
                                }
                                return url;
                            }
                         
                        },
                        { "data": "DATE_APPLIED", "title": "Applied On", "width": "110px", "className": "text-right"},
                        { "data": "DATED", "title": "On", "width": "110px", "className": "text-right" }
                      

                    ];

                    ToggleDataList(true);
                    //For Displaying  Footer Sum
                    //var footerfunc = function () {
                    //    var api = this.api();
                    //    $(api.column(3).footer()).html(thousands_separators(api.column(3, { search: 'applied' }).data().sum()));
                    //    $(api.column(4).footer()).html(thousands_separators(api.column(4, { search: 'applied' }).data().sum()));

                    //}
                    MakeDataGrid('lstMetaShipping', data.lstMetaShipping, 0, columnDef, true, true);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>
