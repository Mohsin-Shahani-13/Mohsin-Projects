                        @*<th></th>*@

                        @*<th></th>*@


                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');

        var isSingleRow = false;
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var _RMARef = $('#RMARef').val();
        // var _Transaction = $('#Transaction').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/MetaReceivingReport/GetList',
            data: {
                frmDt: fDate,
                toDate: tDate,
                programId: _programId,
                ProgramName: _ProgramName,
                RMARef: _RMARef

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [

                        { "data": "ID", "title": "ID", "width": "40px", "visible": false },
                        { "data": "ProgramID", "title": "ID", "width": "40px", "visible": false },
                        // { "data": "Region", "title": "Region", "width": "40px" },
                        { "data": "ProgramName", "title": "PROGRAM", "width": "40px" },
                        { "data": "Region", "title": "REGION", "width": "40px" },
                        {
                            "data": "RMA_REF", "title": "RMA_REF", "width": "90px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\RO\\Detail?Id=' + row["ID"] + '&custRef=' + row["RMA_REF"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "TRANSACTION_ID", "title": "TRANSACTION_ID", "width": "70px" },
                        { "data": "TRANSACTION", "title": "TRANSACTION", "width": "70px" },
                        { "data": "PAYLOAD_ID", "title": "PAYLOAD_ID", "width": "70px" },
                        //{ "data": "WORK_TYPE_ID", "title": "WORK_TYPE_ID", "width": "100px" },
                        //{ "data": "ORDER_NO", "title": "ORDER_NO", "width": "70px" },

                        //{ "data": "Ordertype", "title": "Order Type", "width": "70px" },
                        { "data": "ORDER_TYPE", "title": "ORDER_TYPE", "width": "100px" },

                        { "data": "LINE_ID", "title": "LINE_ID", "width": "90px" },
                        //{ "data": "SecondCommodity", "title": "SECOND_COMMODITY", "width": "70px" },
                        {
                            "data": "PART_NO", "title": "PART_NO", "width": "100px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PART_NO"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "DESCRIPTION", "title": "DESCRIPTION", "width": "220px" },
                        //{ "data": "Family", "title": "FAMILY", "width": "100px" },
                        //{ "data": "DockDate", "title": "DOCK_DATE", "width": "100px", "className": "text-right" },
                        {
                            "data": "SERIAL_NO", "title": "SERIAL_NO", "width": "90px",
                            render: function (data, type, row) {
                                if (row["SERIAL_NO"] == "*" || row["HAS_SN"] == 'N') {
                                    url = row["SERIAL_NO"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["SERIAL_NO"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PART_NO"] + '&page=list" target=_blank > ' + data + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "QUANTITY", "title": "QUANTITY", "width": "40px", "className": "text-right" },
                        { "data": "WORK_TYPE_ID", "title": "WORK_TYPE_ID", "width": "90px" },
                        { "data": "TYPE_DESIGNATION", "title": "TYPE_DESIGNATION", "width": "90px" },
                        { "data": "RECEIVED_BY", "title": "RECEIVED_BY", "width": "90px" },
                        { "data": "DATE_TIME", "title": "DATE_TIME", "width": "120px", "className": "text-right" },
                        { "data": "APPLIED", "title": "DATE_APPLIED", "width": "120px", "className": "text-right" }


                    ];

                    ToggleDataList(true);
                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(13).footer()).html(thousands_separators(api.column(13, { search: 'applied' }).data().sum()));
                        //$(api.column(4).footer()).html(thousands_separators(api.column(4, { search: 'applied' }).data().sum()));

                    }
                    MakeDataGrid('lstMetaReceiving', data.lstMetaReceiving, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>
