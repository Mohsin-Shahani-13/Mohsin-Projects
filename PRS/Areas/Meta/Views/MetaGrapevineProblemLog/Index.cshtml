<script>

    $.fn.dataTable.render.ellipsisAdr1 = function (cutoff) {
        return function (data, type, row) {
            if (type === 'display') {
                var str = data.toString().replace(/(\r\n|\n|\r|\%|\*|\=|\:|\!|\'|\(|\)|\>|\")/gm, "");

                var header = "Subject";
                return str.length < cutoff ?
                    str :
                    str.substr(0, cutoff - 1) + '<a href="#" onclick="showModalForZPL(\'' + header + '\', \'' + str + '\')"> More</a>';
            }
            // Search, order and type can use the original data
            return data;
        };
    };

    $.fn.dataTable.render.ellipsisAdr2 = function (cutoff) {
        return function (data, type, row) {
            if (type === 'display') {
                var str = data.toString().replace(/(\r\n|\n|\r|\%|\*|\=|\:|\!|\'|\(|\)|\>|\")/gm, "");

                var header = "Description";
                return str.length < cutoff ?
                    str :
                    str.substr(0, cutoff - 1) + '<a href="#" onclick="showModalForZPL(\'' + header + '\', \'' + str + '\')"> More</a>';
            }
            // Search, order and type can use the original data
            return data;
        };
    };

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');

        var isSingleRow = false;
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();


        $.ajax({

            cache: false,
            type: 'GET',
            url: '/MetaGrapevineProblemLog/GetList',
            data: {

                programId: _programId,
                ProgramName: _ProgramName,


            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "Id", "title": "Id", "width": "40px", "visible": false },
                        { "data": "type", "title": "Type", "width": "50px" },
                        { "data": "priority", "title": "Priority", "width": "60px" },
                        { "data": "subject", "title": "Subject", "width": "170px", "render": $.fn.dataTable.render.ellipsisAdr1(20) },
                        { "data": "subject", "title": "Subject", "width": "170px", "visible": false },
                        { "data": "description", "title": "Description", "width": "170px", "render": $.fn.dataTable.render.ellipsisAdr2(20) },
                        { "data": "description", "title": "Description", "width": "170px", "visible": false },
                        { "data": "customerreference", "title": "Customer Ref.", "width": "80px" },
                        { "data": "RETURNTYPE", "title": "Return Type", "width": "60px" },
                        { "data": "ordertype", "title": "Order Type", "width": "60px" },
                        { "data": "parentserialno", "title": "Parent Serial No.", "width": "60px" },
                        { "data": "partno", "title": "Part No.", "width": "90px" },
                        { "data": "serialno", "title": "Serial No.", "width": "60px" },
                        { "data": "PARTNO2", "title": "Part No.2", "width": "100px" },
                        { "data": "SERIALNO2", "title": "Serial No.2", "width": "60px" },
                        { "data": "PARTNO3", "title": "Part No.3", "width": "100px" },
                        { "data": "SERIALNO3", "title": "Serial No.3", "width": "60px" },
                        { "data": "ReasonDESC", "title": "Reason Desc.", "width": "140px" },
                        { "data": "StatusDescription", "title": "Status Desc.", "width": "60px" },
                        { "data": "CUSTOMERCASEID", "title": "Customer Case Id", "width": "100px" },
                        { "data": "TrackingNumber", "title": "Tracking No.", "width": "60px" },
                        { "data": "assignedToUser", "title": "Assigned User", "width": "60px" },
                        { "data": "RESOLUTION", "title": "Resolution", "width": "70px" },
                        { "data": "createdate", "title": "Created On", "width": "100px", "className": "text-right" },
                        { "data": "lastactivitydate", "title": "Last Activity On", "width": "100px", "className": "text-right" },




                    ];

                    ToggleDataList(true);
                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        //    var api = this.api();


                    }
                    MakeDataGrid('lstMetaGrapevineProblemLog', data.lstMetaGrapevineProblemLog, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
  function showModalForZPL(head, str)
  {
   $('#commentsheader').html(head);
   $('#commentsbody').html('<text rows="15" cols="78" name="usrtxt" wrap="hard"> "' + str + '" </text> ');
   $('#comments').modal('show');    
  }
</script>


