@model IP.Areas.ListingReports.Models.PartsSerial
@{
    if (ViewBag.list != null)
    {
        Layout = null;
    }
    else
    {

        Layout = cCommon.SwitchToDetailPage(Request.Url.PathAndQuery);

    }
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box">
            @if (Layout == null)
            {

                <div class="box-header with-border bg-blue-gradient">
                    <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                        <span class="fa fa-filter fa-lg white"></span>
                    </button>
                    <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
                    <div id="buttons" class="box-tools pull-right">

                    </div>
                </div>
            }
            else
            {
                <input id="rptcode" type="hidden" value="007-SN" />
                <div class="box-header with-border bg-blue-gradient">
                    <button type="button" class="btn btn-box-tool">
                        <span class="fa fa-list fa-lg white"></span>
                    </button>
                    <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
                    <div id="buttons" class="box-tools pull-right">

                    </div>
                </div>
            }


            <div class="box-body" id="lstP">
                <table id="lstPartsSerial" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                    <thead class="sorted-asc">
                        <tr>
                            <th class="notexport"></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                    </thead>
                    <tbody id="tblBody"></tbody>
                </table>
            </div>
        </div>

    </div>
</div>
@{
    if (Layout == null)
    {
        <script>

            ToggleDataList(false);
        LoadData();
        function LoadData() {

            $('#tblBody').empty();
            $('#lstPartsSerial').DataTable().clear();
            $('#lstPartsSerial').DataTable().destroy();
            var isSingleRow = false;
                $('#option').modal('hide');
                    var fDate = $('#fromDt').val();
            var tDate = $('#toDt').val();
            var isAllDate = $('#isAllDate').is(':checked');
                    var _serialNo = $('#serialNo').val();
                    var _programId = '@Request.QueryString["ProgramID"]'
                    var _ProgramName = $("#ProgramID option:selected").text();
                    var _partNo = '@Request.QueryString["partNo"]'
                    var _locNo = '@Request.QueryString["locationId"]'
            var _palletNo = '@Request.QueryString["palletBoxNo"]'

                $.ajax({

                    cache: false,
                    type: 'GET',
                    url: '/PartsSerial/GetList',
                    data: {
                        frmDt: fDate,
                        toDate: tDate,
                        isAllDate: isAllDate,
                        serialNo: _serialNo,
                        programId: _programId,
                        ProgramName: _ProgramName,
                        partNo: _partNo,
                        locNo: _locNo,
                        palletNo: _palletNo
                    },
                    datatype: JSON,
                    success: function (data) {
                        $('#filterString').append(data.filterString);
                        $('#tblBody').empty();
                        $('#lstPartsSerial').DataTable().clear();
                        $('#lstPartsSerial').DataTable().destroy();
                        

                       
                            var columnDef = [
                                { "data": "ProgramID", "title": "ProgramID", "width": "100px", "visible": false },
                                { "data": "Program", "title": "Program" },
                                {
                                    "data": "SerialNo", "title": "Serial No.", "width": "120px",
                                    render: function (data, type, row) {
                                        var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                                        return url;
                                    }
                                },


                                {
                                    "data": "ParentSerialNo", "title": "Parent Serial No.", "width": "100px",
                                    render: function (data) {
                                        return data;
                                    }
                                },
                                { "data": "PalletBoxNo", "title": "Pallet Box No.", "width": "100px" },
                                {
                                    "data": "PartNo", "title": "Part No.", "width": "120px",
                                    render: function (data, type, row) {
                                        var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                        return url;
                                    }
                                },
                                { "data": "LocationNo", "title": "Location No.", "width": "140px" },

                                { "data": "Status", "title": "Status", "width": "70px" },
                                { "data": "Username", "title": "Created By", "width": "80px" },
                                { "data": "CreatedOn", "title": "Created On", "width": "80px", "className": "text-right" },
                                { "data": "LastActivityOn", "title": "Last Activity On", "width": "80px", "className": "text-right" }
                            ]

                            ToggleDataList(true);
                            MakeDataGrid('lstPartsSerial', data.lstPartsSerial, 0, columnDef, true, true, false);

                            if (data["ErrorMessage"] != null) {
                                $('.dataTables_empty > p').text(data["ErrorMessage"]);
                            }
                        
                    },
                    onerror: function (r) { r },
                    failure: function (r) { r }
                });


            }
        </script>
    }

    else
    {
        @section js
            {
            <script>

                ToggleDataList(false);
                LoadData();
                function LoadData() {
                    $('#tblBody').empty();
                    $('#lstPartsSerial').DataTable().clear();
                    $('#lstPartsSerial').DataTable().destroy();

                    $('#option').modal('hide');
                    var _isAllDate = false
                    var _serialNo = $('#serialNo').val();
                    var _programId = '@Request.QueryString["ProgramID"]'
                    var _ProgramName = $("#ProgramID option:selected").text();
                    var _partNo = '@Request.QueryString["partNo"]'
                    var _locNo = '@Request.QueryString["locationId"]'
                    var _config = '@Request.QueryString["config"]'
                    var _palletNo = '@Request.QueryString["palletBoxNo"]'
                    var _originFrom = '@Request.QueryString["originFrom"]'

                    $.ajax({

                        cache: false,
                        type: 'GET',
                        url: '/PartsSerial/GetList',
                        data: {
                            isAllDate: _isAllDate,
                            serialNo: _serialNo,
                            programId: _programId,
                            ProgramName: _ProgramName,
                            partNo: _partNo,
                            locNo: _locNo,
                            palletBoxNo: _palletNo,
                            config: _config,
                            originFrom: _originFrom
                        },
                        datatype: JSON,
                        success: function (data) {
                            $('#filterString').append(data.filterString);
                            $('#tblBody').empty();
                            $('#lstPartsSerial').DataTable().clear();
                            $('#lstPartsSerial').DataTable().destroy();

                            var columnDef = [
                                { "data": "ProgramID", "title": "ProgramID", "width": "100px", "visible": false },
                                { "data": "Program", "title": "Program" },
                                {
                                    "data": "SerialNo", "title": "Serial No.", "width": "120px",
                                    render: function (data, type, row) {
                                        var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                                        return url;
                                    }
                                },


                                {
                                    "data": "ParentSerialNo", "title": "Parent Serial No.", "width": "100px",
                                    render: function (data) {
                                        return data;
                                    }
                                },
                                { "data": "PalletBoxNo", "title": "Pallet Box No.", "width": "100px" },
                                {
                                    "data": "PartNo", "title": "Part No.", "width": "120px",
                                    render: function (data, type, row) {
                                        var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                        return url;
                                    }
                                },
                                { "data": "LocationNo", "title": "Location No.", "width": "140px" },

                                { "data": "Status", "title": "Status", "width": "70px" },
                                { "data": "Username", "title": "Created By", "width": "80px" },
                                { "data": "CreatedOn", "title": "Created On", "width": "80px", "className": "text-right" },
                                { "data": "LastActivityOn", "title": "Last Activity On", "width": "80px", "className": "text-right" }
                            ]

                            ToggleDataList(true);
                            MakeDataGrid('lstPartsSerial', data.lstPartsSerial, 0, columnDef, true, true, false);

                            if (data["ErrorMessage"] != null) {
                                $('.dataTables_empty > p').text(data["ErrorMessage"]);
                            }
                        },
                        onerror: function (r) { r },
                        failure: function (r) { r }
                    });


                }
            </script>
        }
    }
}

