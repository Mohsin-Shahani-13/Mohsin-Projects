        var isAllDate = $('#isAllDate').is(':checked');
        var serialNo = $('#serialNo').val();
        var programId = $('#ProgramID').val();
        var ProgramName = $("#ProgramID option:selected").text();


        $('#option').modal('hide');
        OpenPage('\\ListingReports\\PartsSerial\\Index?frmDt=' + fDate + ' &toDate=' + tDate + ' &isAllDate=' + isAllDate +'serialNo=' + serialNo + '&ProgramID=' + programId + '&ProgramName=' + ProgramName + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
