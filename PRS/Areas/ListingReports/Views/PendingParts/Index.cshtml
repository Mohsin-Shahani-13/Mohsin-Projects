@model IP.Areas.ListingReports.Models.PendingParts
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstPendingParts" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>
    var COLUMN_FORMAT =
    {
        formatDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(4));
        },
        formatTwoDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(2);
        },
        formatNumber: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(0));
        },

        formatNumberForZero: function (data, type, row) {
            var val = +data;
            return val === '0' ? '' : val.toFixed(0);
        },

    };
    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();
        var partNo = $('#partNo').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/PendingParts/GetList',
            data: {

                programId: _programId,
                ProgramName: _ProgramName,
                partNo: partNo,
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "ProgramID", "width": "40px", "visible": false },
                        { "data": "Name", "title": "Program", "width": "60px" },
                        { "data": "Reason", "title": "Reason", "width": "150px" },
                        { "data": "WorkOrderNo", "title": "Order No.", "width": "60px" },
                        { "data": "ID", "title": "ID", "width": "40px", "visible": false },
                        {
                            "data": "ROCustomerRef", "title": "RO Cust. Ref.", "width": "70px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\RO\\Detail?Id=' + row["ID"] + '&custRef=' + row["ROCustomerRef"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "70px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "80px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                if (row["HAS_SN"] == 'N' || row["SerialNo"] == "*") {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&Programid=' + row["ProgramID"] + '&partno=' + row["PartNo"] + '&page=list" target=_blank > ' + d + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "RepairType", "title": "Repair Type", "width": "120px" },
                        {
                            "data": "ComponentPartNo", "title": "Comp. Part No.", "width": "80px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["ComponentPartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "CompPartNoDesc", "title": "Comp. Part Desc." },
                        { "data": "By", "title": "By", "width": "70px" },
                        { "data": "ReceiveDate", "title": "Received On", "width": "90px", "className": "text-right" },
                        {
                            "data": "availqty", "title": "Qty Avail.", "width": "70px", "className": "text-right",
                            render: function (data, type, row) {

                                var val = COLUMN_FORMAT.formatNumberForZero(data);
                                return val;
                            }
                        },
                        { "data": "HoldDate", "title": "Hold On", "width": "90px", "className": "text-right" },
                        {
                            "data": "DaysinHold", "title": "Days in Hold", "width": "70px", "className": "text-right",
                            render: function (data, type, row) {

                                var val = COLUMN_FORMAT.formatNumberForZero(data);
                                return val;
                            }
                        },


                    ];

                    ToggleDataList(true);
                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(13).footer()).html(thousands_separators(api.column(13, { search: 'applied' }).data().sum()));

                    }
                    MakeDataGrid('lstPendingParts', data.lstPendingParts, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>


