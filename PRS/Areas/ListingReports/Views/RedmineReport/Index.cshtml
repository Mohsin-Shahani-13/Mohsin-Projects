<script>
    $(document).ready(function () {

        $('#lstRedmineReport').on('click', '.remarks-button', function () {
            var table = $('#lstRedmineReport').DataTable(); // Get the DataTable instance
            var $row = $(this).closest('tr'); // Get the closest row to the button
            var rowData = table.row($row).data(); // Get the data for the closest row

            var remarks = $(this).data('remarks'); // Get remarks from data-remarks attribute
            var redmineId = $(this).data('redmine'); // Get Redmine value from the row data
            var title = $(this).data('title'); // Get Title value from the row data

            showRemarksPopup(redmineId, remarks, title); // Call the popup function
        });
        // Disable save button by default
        $('#saveData').prop('disabled', true);

        // Function to enable save button on change events
        // Function to enable save button on change events and mark row as edited
        function markRowAsEdited(element) {
            var row = $(element).closest('tr');
            row.addClass('edited');
            $('#saveData').prop('disabled', false);
        }


        // Attach change event listeners to inputs
        $(document).on('change', '.priority-dropdown, .status-dropdown, #currOwner, .DevDueDate, .released-date, .closed-date, .yes-no-dropdown-Grpvn, .yes-no-dropdown-Prg, .yes-no-dropdown-Aus, .yes-no-dropdown-Jpn', function () {
            markRowAsEdited(this);
        });
        // Attach change event listeners to inputs
        $(document).on('click', '.remarks-button', function () {
            markRowAsEdited(this);
        });

        // Function to show the remarks popup
        function showRemarksPopup(redmineId, initialValue, title) {
            // You can use any modal or custom popup implementation here
            // For example, using Bootstrap modal

            // Clear any existing modal content or initialize a new modal
            $('#remarksModal').remove(); // Remove if exists to ensure clean state
            //$('#title').html(title)
            var modalHtml = `
            <div class="modal fade " id="remarksModal" tabindex="-1" role="dialog" aria-labelledby="remarksModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-md" role="document">
                    <div class="modal-content">
                        <div class="modal-header bg-blue-gradient">
                            <h5 class="modal-title d-content" id="remarksModalLabel">Remarks</h5>
                            <button type="button" class="close d-math" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                        <div class="field">
                        <label>Redmine: </label>
                        <input type="text" class="" disabled value="${redmineId}">
                        </div>
                        <div class="field">
                            <label>Title: </label>
                            <p id="title"></p>
                        </div>
                            <textarea id="remarksTextarea" class="form-control" rows="5" placeholder="Enter Remarks...">${initialValue}</textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-primary" id="saveRemarksBtn">Confirm</button>
                        </div>
                    </div>
                </div>
            </div>
        `;

            $('body').append(modalHtml); // Append modal HTML to body
            document.getElementById('title').innerText = title;

            // Show the modal
            $('#remarksModal').modal('show');

            //// Handle save button click
            $('#saveRemarksBtn').click(function () {

                //var redmineId = $('#redmineId').val();
                var remarks = $('#remarksTextarea').val()
                //console.log(redmineId)
                saveRemarks(redmineId, remarks);

                // You can update the remarks in your data structure or wherever needed
                //console.log('Updated Remarks:', updatedRemarks);

                // Close the modal
                $('#remarksModal').modal('hide');
            });

            // Cleanup on modal close
            $('#remarksModal').on('hidden.bs.modal', function () {
                $('#remarksModal').remove(); // Remove modal from DOM
            });
        }

        ToggleDataList(false);
        $('.dateCalendar').datepicker({
            format: 'yyyy.mm.dd',
            autoclose: true,
            startDate: '-180d',
            endDate: maxDate,
            readonlyDatepicker: true
        });
        LoadData();
    });

