</table>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
<script>
    function GoOnEnter() {
        if (event.keyCode == 13) {
            Go();
        }
    }
    $('#btnGo').click(function () {

            Go();
       
    });

    function Go() {

        var programId = $('#ddProgram').val();
        var programName = $("#ddProgram option:selected").text();
        //var fDate = $('#fromDt').val();
        //var tDate = $('#toDt').val();
        //var venType = $('#venType').val();
        //var venNo = $('#venNo').val();
        var status = $("#ddStatus option:selected").text();

        $('#option').modal('hide');
        OpenPage('\\ListingReports\\RedmineReport\\Index?programID=' + programId + '&programName=' + programName + '&status=' + status + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>




