@model IP.Areas.ListingReports.Models.RedmineReport
@{
    ViewBag.Title = "Option";
    Layout = null;
}
<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.status, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddStatus", null, new { id = "ddStatus", @name = "ddStatus", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
