@model IP.Areas.ListingReports.Models.BoseAWP
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" @*title="Option Page" onclick="$('#option').modal('show');"*@>
                <span class="fa fa-bars fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstBoseAWP" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th></th>
                        <th></th>
                        <th>Total: </th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>
    var COLUMN_FORMAT =
    {
        formatDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(4));
        },
        formatTwoDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(2);
        },
        formatNumber: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(0));
        },

        formatNumberForZero: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(0);
        },

    };

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');

        var isSinglerow = false;

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/BoseAWP/GetList',
            data: {

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);
                if (!isSinglerow) {

                    var columnDef = [
                        { "data": "ID", "title": "ID", "width": "70px", "visible": false },
                        { "data": "ProgramID", "title": "Program ID", "width": "70px", "visible": false },
                        { "data": "RMA", "title": "RMA", "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\WO\\Detail?Id=' + row["ID"] + '&custRef=' + row["RMA"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';

                                return url;
                            }
                        },
                        {
                            "data": "PartNo",
                            "title": "PartNo",
                            "width": "90px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "Description",
                            "title": "Description"
                            
                        },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "ComponentPartNo",
                            "title": "Comp. Part No.",
                            "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "ComponentDesc",
                            "title": "Component Desc.",
                            "width": "250px"

                        },
                        {
                            "data": "QtyRequested",
                            "title": "Qty Req.",
                            "width": "60px",
                            "className": "text-right",

                            render: function (data, type, row) {
                                var val = COLUMN_FORMAT.formatNumber(data);
                                return val;
                            }
                        },
                        { "data": "HoldDate", "title": "Hold Date", "width": "90px", "className": "text-right" },
                        { "data": "ReceiveDate", "title": "Receive Date", "width": "90px", "className": "text-right" }

                    ];

                    ToggleDataList(true);
                    //For Displaying footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(8).footer()).html(thousands_separators(api.column(8, { search: 'applied' }).data().sum()));
                    }

                    MakeDataGrid('lstBoseAWP', data.lstBoseAWP, 0, columnDef, true, true, footerfunc);

                }

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }

</script>