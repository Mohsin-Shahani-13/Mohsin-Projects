@model IP.Areas.ListingReports.Models.DriveInquiry
@{
    ViewBag.Title = "Option";
    Layout = null;
}


<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
    .modal-content{
        width: 850px;
    }
</style>
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12">
       
                <form id="myForm">
                    @*<div class="row">*@
                        <div class="col-md-6 ">
                            @for (int i = 1; i <= 20; i++)
                            {
                                <div class="form-group pad">
                                    <label for="pcbaSerialNo_@i" class="col-sm-4 control-label">PCBA Serial No. @i:</label>
                                    <div class="col-sm-7">
                                        <input type="text" class="form-control pcbaSerialNo" id="pcbaSerialNo_@i" data-index="@i" style="height:25px;" onkeydown="GoOnEnter()">
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="col-md-6 ">
                            @for (int i = 1; i <= 20; i++)
                            {
                                <div class="form-group pad">
                                    <label for="serialNo_@i" class="col-sm-3 control-label">Serial No. @i:</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control serialNo" id="serialNo_@i" data-index="@i" style="height:25px;" onkeydown="GoOnEnter()">
                                    </div>
                                </div>
                            }
                        </div>

                    @*</div>*@
                </form>

         
    </div>

</div>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
