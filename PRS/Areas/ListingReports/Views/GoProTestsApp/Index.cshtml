@model IP.Areas.ListingReports.Models.GoProTestsApp
@{
    ViewBag.Title = "Index";
    Layout = null;
}



<div id="parentDiv" class="container">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstGoProTestsApp" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                    </tr>

                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>

                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');

    var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var customer = $('#ddCustomer').val();
        var customerText = $("#ddCustomer option:selected").text();
        var app = $('#ddApp').val();
        var appText = $("#ddApp option:selected").text();
        var result = $("#result option:selected").val();
        var active = $("#active option:selected").val();


        $.ajax({

            cache: false,
            type: 'GET',
            url: '/GoProTestsApp/GetList',
            data: {
                frmDt: fDate,
                toDate: tDate,
                customer: customer,
                customerText: customerText,
                app: app,
                appText: appText,
                result: result,
                active: active

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);


                    var columnDef = [
                        { "data": "UnitResultId", "title": "Unit Result ID", "width": "80px" },
                        { "data": "SerialNumber", "title": "Serial No." },
                        { "data": "Result", "title": "Result", "width": "60px" },
                        { "data": "Customer", "title": "Customer", "width": "80px" },
                        { "data": "Area", "title": "Area", "width": "60px" },
                        { "data": "Active", "title": "Active", "width": "60px" },
                        { "data": "App", "title": "App", "width": "100px" },
                        { "data": "InsertedBy", "title": "Inserted By", "width": "120px" },
                        { "data": "InsertedOn", "title": "Inserted On", "width": "90px", "className": "text-right" },
                        { "data": "XML", "title": "XML", "width": "60px", "className": "text-center",
                            "render": function (data, type, row) {
                                var url = '<a id="openRequestXmlLink" onclick="openXmlInNewTab(\'' + encodeURIComponent(data) + '\');">View</a>';
                                return url;
                            }
                        },
                        
                        {  "data": "XML", "title": "XML", "width": "60px", "className": "text-left", "visible": false,

                            "render": function (data, type, row) {
                                return $('<div/>').text(data).html();
                            }
                        }
                        

                    ];

                    ToggleDataList(true);

                MakeDataGrid('lstGoProTestsApp', data.lstGoProTestsApp, 0, columnDef, true, true);



                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
    function openXmlInNewTab(xmlData) {
        var blob = new Blob([decodeURIComponent(xmlData)], { type: "application/xml" });

        var url = URL.createObjectURL(blob);

        window.open(url, '_blank');

    }

</script>