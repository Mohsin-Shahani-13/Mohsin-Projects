@model IP.Areas.ListingReports.Models.BoseLookupTool
@{
    ViewBag.Title = "Option";
    Layout = null;
}
<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr class="hidden">
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddlProgram", null, new { id = "ProgramID", @name = "ddlProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    <tr>
        <td colspan="2" class="pad">
            @Html.LabelFor(model => model.custRef, new { @class = "col-4 col-form-lebel" })
            <input type="text" class="form-control" id="custRef" name="custRef" autofocus onkeydown="GoOnEnter()" />
        </td>
  
        <td colspan="2" class="pad">
            @Html.LabelFor(model => model.SerialNo, new { @class = "col-4 col-form-lebel" })
            <input type="text" class="form-control" id="SerialNo" name="SerialNo" autofocus onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.InboundTracking, new { @class = "col-4 col-form-lebel" })
            <input type="text" class="form-control" id="InboundTracking" nameInboundTrackingSerialNo" autofocus onkeydown="GoOnEnter()" />
        </td>
    </tr>
</table>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
<script>
    $('#option').on('shown.bs.modal', function () {
        $('#custRef').focus();
    });


    function GoOnEnter() {
        if (event.keyCode == 13) {
            Go();
        }
    }
    $('#btnGo').click(function () {
        Go();
    });

    

    function Go() {
        var programId = $('#ProgramID').val();
        var ProgramName = $("#ProgramID option:selected").text();
        var custRef = $('#custRef').val();
        var SerialNo = $('#SerialNo').val();
        var InboundTracking = $('#InboundTracking').val();
          $('#option').modal('hide');
        OpenPage('\\ListingReports\\BoseLookupTool\\Index?ProgramID=' + programId + '&ProgramName=' + ProgramName + '&custRef=' + custRef + '&SerialNo=' + SerialNo + '&InboundTracking=' + InboundTracking + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>


