@model IP.Areas.ListingReports.Models.BoseLookupTool
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<style>
    textarea {
        resize: none;
    }
</style>
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">

        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>

        <div class="box-body" id="lstP">
            <table id="lstBoseLookupTool" class="table table-bordered table-striped text-sm table-hover">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>

                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
    $.fn.dataTable.render.ellipsisAdr1 = function (cutoff) {
        return function (data, type, row) {
            if (type === 'display') {
                var str = data.toString().replace(/(\r\n|\n|\r|'|)/gm, "");

                var header = "Message";

                return str.length < cutoff ?
                    str :
                    str.substr(0, cutoff - 1) + '<a href="#" onclick="showModalForZPL(\'' + header + '\', \'' + str + '\')"> More</a>';
            }
            // Search, order and type can use the original data
            return data;
        };
    };
    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var programId = $('#ProgramID').val();
        var ProgramName = $("#ProgramID option:selected").text();
        var custRef = $('#custRef').val();
        var SerialNo = $('#SerialNo').val();
        var InboundTracking = $('#InboundTracking').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/BoseLookupTool/GetList',
            data: {
                programId: programId,
                ProgramName: ProgramName,
                SerialNo: SerialNo,
                custRef: custRef,
                InboundTracking: InboundTracking
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);


                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "ProgramID", "width": "70px", "visible": false },
                        {
                            "data": "CURRENT_SKU", "title": "Current SKU", "width": "100px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["ORIGINAL_SKU"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "ORIGINAL_SKU", "title": "Original SKU", "width": "100px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["ORIGINAL_SKU"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },

                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "100px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["CURRENT_SKU"] + '&page=list" target=_blank > ' + d + '</a>';

                                return url;
                            }
                        },
                        { "data": "ORDER_TYPE", "title": "Order Type", "width": "100px" },
                        { "data": "RETURN_REASON", "title": "Return Reason", "width": "100px" },
                        { "data": "BLACKLIST", "title": "Blacklist", "width": "200px" },
                        { "data": "SYMPTOM", "title": "Symptom", "width": "220px" },
                        { "data": "CREDIT_DISPOSITION", "title": "Credit Disposition", "width": "120px" },
                        { "data": "LAST_STATUS", "title": "Last Status", "width": "110px" },
                        { "data": "LAST_LOCATION", "title": "Last Location", "width": "70px" },
                        { "data": "RMA_NO", "title": "RMA No.", "width": "120px" },
                        { "data": "DOCK_DATE", "title": "Dock Date", "width": "100px", "className": "text-right" },
                        { "data": "RECEIPT_DATE", "title": "Receipt Date", "width": "120px", "className": "text-right" },
                        { "data": "INBOUND_TRACKING", "title": "Inbound Tracking", "width": "120px" },
                        { "data": "CURRENT_REPAIR_STEP", "title": "Current Repair Step", "width": "130px" },
                        { "data": "LATEST_HOLD_DATE", "title": "Latest Hold Record", "width": "120px", "className": "text-right" },
                        { "data": "LATEST_HOLD_REASON", "title": "Latest Hold Reason", "width": "120px" },
                        { "data": "REPAIR_COMPLETE_DATE", "title": "Repair Complete Date", "width": "120px", "className": "text-right" },
                        { "data": "SHIP_ORDER_NO", "title": "Ship Order No.", "width": "120px" },
                        { "data": "OUTBOUND_TRACKING", "title": "Outbound Tracking", "width": "70px" }

                    ]


                    ToggleDataList(true);
                    MakeDataGrid('lstBoseLookupTool', data.lstBoseLookupTool, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
    function showModalForZPL(head, str) {
        $('#commentsheader').html(head);
        $('#commentsbody').html('<textarea rows="15" cols="77" name="usrtxt" wrap="hard"> "' + str + '" </textarea > ');
        $('#comments').modal('show');
    }
</script>
