@model IP.Areas.ListingReports.Models.DataWipeResult
@{
    ViewBag.Title = "Detail";
    Layout = cCommon.SwitchToDetailPage(Request.Url.PathAndQuery);
}

<style>
    .text-sm {
        padding-bottom: 2px;
    }

    .more-text {
        display: none;
        color: red;
    }

    .truncate {
        max-width: 1750px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
@*@{
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    serializer.MaxJsonLength = Int32.MaxValue;
    //var jsonModel = serializer.Serialize(Model.lstSerial);

}*@
<div id="parentDiv" class="container-fluid">
    <input id="rptcode" type="hidden" value="117" />
    <div id="datalist" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            @{
                
                if (Layout == null)
                {
                    <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                        <span class="fa fa-filter fa-lg white"></span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-box-tool">
                        <span class="fa fa-th-list fa-lg white"></span>
                    </button>
                }
            }
            <h6 class="box-title"><strong>Test Results Detail > Id = '@Request.QueryString["Id"]'</strong></h6>
            <div id="button" class="box-tools pull-right" style="margin-top:2PX;">
            </div>
        </div>
        <div id="topHeader" class="box-body row text-sm">
            <div class="col-md-12 text-sm">
                <table id="tblheader" class="table text-sm" style="margin-bottom:-5px; width:100%">
                    <tr>
                        <td style="width: 80px;"><strong>@Html.DisplayNameFor(m => m.serialNo)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.serialNo)</td>

                        <td style="width: 70px;"><strong>Start On:</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.fromDt)</td>

                        <td style="width: 120px;"><strong>@Html.DisplayNameFor(m => m.machineName)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.machineName)</td>

                        <td style="width: 100px;"><strong>@Html.DisplayNameFor(m => m.testArea)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.testArea)</td>

                        <td style="width: 120px;"><strong>@Html.DisplayNameFor(m => m.program)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.program)</td>

                    </tr>
                    <tr>
                        <td><strong>@Html.DisplayNameFor(m => m.partNo)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.partNo)</td>

                        <td><strong>End On:</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.toDt)</td>

                        <td><strong>@Html.DisplayNameFor(m => m.result)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.result)</td>

                        <td><strong>@Html.DisplayNameFor(m => m.cellNo)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.cellNo)</td>

                        <td><strong>@Html.DisplayNameFor(m => m.miscInfo)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.miscInfo)</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="baby-col-12 section-padding">
            <div class="box babygridheight" style="margin-top:4px;">
                <div class="box-header bg-blue-gradient">
                    <button type="button" class="btn btn-box-tool">
                        <span class="fa fa-th-list fa-lg white"></span>
                    </button>
                    <h6 class="box-title" id="line"><strong> Log Detail > Id = '@Request.QueryString["ID"]'</strong></h6>
                    <div id="btnLine" class="box-tools pull-right">
                        <span class="fa fa-th-list fa-lg white"></span>
                    </div>
                </div>
                <div class="box-body text-sm">
                    <table id="lstDetail" class="table table-bordered table-striped text-sm table-hover" style="width:100%;">
                        <thead>
                            <tr>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="tblBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
@{
