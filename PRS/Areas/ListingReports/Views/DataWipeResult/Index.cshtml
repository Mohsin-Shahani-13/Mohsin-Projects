    function DownloadFilesAsZip() {
        var contract = $('#ddProgram option:selected').val();
        var Program = $('#ddProgram option:selected').text();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var serialNo = $('#serialNo').val();
        var partNo = $('#partNo').val();
        $.ajax({
            type: 'GET',
            url: '/DataWipeResult/DownloadFilesAsZip',
            data: {
                //Program: Program,
                countCheck: true,
                frmDt: fDate,
                toDt: tDate,
                isAllDate: isAllDate,
                serialNo: serialNo,
                partNo: partNo,
                contract: contract,
                Program: Program,
            },
            datatype: JSON,
            success: function (data) {
                if (data.UrlsCount <= 0)
                {
                    alert("There are no XML records available to download!");
                }
                else
                {
                //var dataAvailableMsg = "Are you sure you want to download [ " + data.UrlsCount + " ] records!";
                //var nodataAvailableMsg = "There are no XML records available to download!";
                //$('#fileCount').text('File Count: ' + data.Count);
                    if (confirm("Are you sure you want to download [ " + data.UrlsCount + " ] records!")) {
                        var url = '/DataWipeResult/DownloadFilesAsZip?countCheck=false' + '&frmDt=' + fDate + '&toDt=' + tDate + '&isAllDate=' + isAllDate + '&serialNo=' + serialNo + '&partNo=' + partNo + '&Program=' + Program + '&contract=' + contract;
                    window.location.href = url;
                }
                else
                        return false;
                }
            },
            error: function () {
                //$('#fileCount').text('Error occurred.');
            }
        });
    }
