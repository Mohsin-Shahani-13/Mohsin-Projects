@model IP.Areas.ListingReports.Models.DailyProductionReview
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstDailyProductionReview" class="table table-bordered table-striped text-sm table-hover" @*style="width:100%"*@>
                <thead class="sorted-asc">
                    @{

                                        <tr>
                                            <th class="notexport"></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>

                                            @if (ViewBag.ProgramName == "BOSE")
                                            {
                                                <th class="notexport"></th>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                                <th></th>

                                            }

                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>


                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                        </tr>
                    }
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    @*<tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>*@
                </tfoot>
            </table>

        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var Workstation = $('#Workstation').val();
        var _programId = $('#ddProgram').val();
        var _ProgramName = $("#ddProgram option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/DailyProductionReview/GetList',
            data: {
                frmDt: fDate,
                toDate: tDate,
                Workstation: Workstation,
                programId: _programId,
                ProgramName: _ProgramName
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [];
                    if (_ProgramName == "BOSE") {
                        columnDef = [
                            { "data": "ProgramID", "title": "Program ID", "width": "40px", "visible": false },
                            { "data": "woheaderid", "title": "WO Header Id", "width": "80px" },
                            //{ "data": "serialno", "title": "Serial No.", "width": "90px" },
                            {
                                "data": "serialno", "title": "Serial No.", "width": "80px",
                                render: function (data, type, row) {
                                    var d = data.toString();
                                    if (row["HAS_SN"] == 'N' || row["serialno"] == "*") {
                                        url = row["serialno"];
                                    }
                                    else {
                                        var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["serialno"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["Model"] + '&page=list" target=_blank > ' + d + '</a>';
                                    }
                                    return url;
                                }
                            },
                            { "data": "RMA/SN", "title": "RMA / SN", "width": "110px" },
                            {
                                "data": "Model", "title": "Model", "width": "110px",
                                render: function (data, type, row) {
                                    var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["Model"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                    return url;
                                }
                            },
                            { "data": "ORDER_TYPE", "title": "Order Type", "width": "110px" },
                            { "data": "Family", "title": "Family", "width": "70px" },
                            { "data": "Technology", "title": "Technology", "width": "70px" },
                            { "data": "Ispass", "title": "Is Pass", "width": "40px", "className": "text-center" },
                            { "data": "FAULT", "title": "Fault", "width": "40px", "visible": false },
                            { "data": "FCM1", "title": "Fault Code", "width": "220px" },
                            { "data": "FCM2", "title": "Fault Code 2", "width": "200px" },
                            { "data": "FCM3", "title": "Fault Code 3", "width": "180px" },
                            { "data": "FCM4", "title": "Fault Code 4", "width": "100px" },
                            { "data": "FCM5", "title": "Fault Code 5", "width": "100px" },
                            { "data": "iteration", "title": "Iteration", "width": "60px" },
                            { "data": "Workstation", "title": "Work Station", "width": "100px" },
                            { "data": "ToWorkStation", "title": "To Work Station", "width": "100px" },
                            { "data": "Day", "title": "Day", "width": "60px", "className": "text-right" },
                            { "data": "Time", "title": "Time", "width": "65px", "className": "text-right" },
                            { "data": "Shift", "title": "Shift", "width": "30px" },
                            { "data": "Hour", "title": "Hour", "width": "30px", "className": "text-right" },
                            { "data": "UserName", "title": "User Name", "width": "80px" },
                            { "data": "Technician", "title": "Technician", "width": "80px" },
                            { "data": "createdate", "title": "Created On", "width": "90px", "className": "text-right" },
                            { "data": "lastactivitydate", "title": "Last Activity On", "width": "90px", "className": "text-right" },
                            { "data": "RepairLevel", "title": "Repair Level", "width": "70px", "className": "text-right" }


                        ]

                    }
                    else {

                        columnDef = [
                            { "data": "ProgramID", "title": "Program ID", "width": "40px", "visible": false },
                            { "data": "woheaderid", "title": "WO Header Id", "width": "80px" },
                            //{ "data": "serialno", "title": "Serial No.", "width": "90px" },
                            {
                                "data": "serialno", "title": "Serial No.", "width": "80px",
                                render: function (data, type, row) {
                                    var d = data.toString();
                                    if (row["HAS_SN"] == 'N' || row["serialno"] == "*") {
                                        url = row["serialno"];
                                    }
                                    else {
                                        var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["serialno"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["Model"] + '&page=list" target=_blank > ' + d + '</a>';
                                    }
                                    return url;
                                }
                            },
                            { "data": "RMA/SN", "title": "RMA / SN", "width": "110px", },
                            {
                                "data": "Model", "title": "Model", "width": "110px",
                                render: function (data, type, row) {
                                    var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["Model"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                    return url;
                                }
                            },
                            { "data": "Family", "title": "Family", "width": "70px" },
                            { "data": "Technology", "title": "Technology", "width": "70px" },
                            { "data": "Ispass", "title": "Is Pass", "width": "40px", "className": "text-center" },
                            { "data": "iteration", "title": "Iteration", "width": "60px" },
                            { "data": "Workstation", "title": "Work Station", "width": "100px" },
                            { "data": "ToWorkStation", "title": "To Work Station", "width": "100px" },
                            { "data": "Day", "title": "Day", "width": "60px", "className": "text-right" },
                            { "data": "Time", "title": "Time", "width": "65px", "className": "text-right" },
                            { "data": "Shift", "title": "Shift", "width": "30px" },
                            { "data": "Hour", "title": "Hour", "width": "30px", "className": "text-right" },
                            { "data": "UserName", "title": "User Name", "width": "80px" },
                            { "data": "Technician", "title": "Technician", "width": "80px" },
                            { "data": "createdate", "title": "Created On", "width": "90px", "className": "text-right" },
                            { "data": "lastactivitydate", "title": "Last Activity On", "width": "90px", "className": "text-right" },
                            { "data": "RepairLevel", "title": "Repair Level", "width": "70px", "className": "text-right" }


                        ]
                    }

                    //For Displaying  Footer Sum
                    //var footerfunc = function () {
                    //    var api = this.api();
                    //    $(api.column(8).footer()).html(thousands_separators(api.column(8).data().sum()));
                    //}

                    ToggleDataList(true);
                    MakeDataGrid('lstDailyProductionReview', data.lstDailyProductionReview, 0, columnDef, true, true);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>


