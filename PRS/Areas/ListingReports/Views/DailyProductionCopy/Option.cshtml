@model IP.Areas.ListingReports.Models.DailyProductionCopy

@{
    ViewBag.Title = "Option";
    Layout = null;
}
<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>

<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    @*<tr>
            <td colspan="4" class="pad">
                @Html.LabelFor(model => model.WOheaderId, htmlAttributes: new { @class = "col-4 col-form-lable" })
                @Html.DropDownList("ddId", null, new { id = "ddId", @name = "ddId", @class = "form-control", @onkeydown = "GoOnEnter()" })
            </td>
        </tr>*@

    <tr>
        <td class="pad">
            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.Workstation, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="Workstation" name="Workstation" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.serialNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="serialNo" name="serialNo" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            <div>
                <label>
                    @Html.CheckBoxFor(model => model.isChecked, new { @class = "form-check-input", id = "isChecked" }) PASS
                </label>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            <div>
                <label>
                    @Html.CheckBoxFor(model => model.notChecked, new { @class = "form-check-input", id = "notChecked" }) FAIL
                </label>
            </div>
        </td>
    </tr>
    <tr>
        <td>
            <div id="checkBoxMsg" class="optionMsg">
            </div>
        </td>
    </tr>
</table>
<br />
@*/////OPTION PAGE BUTTONS///////*@
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value="@Request.QueryString["rptCode"]" />

<script>

    $('#isChecked').change(function () {

        $('#notChecked').prop("checked", false);

    })

    $('#notChecked').change(function () {

            $('#isChecked').prop("checked", false);

    })


    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }

    $('#btnGo').click(function () {

        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });


    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 1);

        //var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-365d',
        endDate: maxDate
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var checkbox1 = $('#isChecked').is(':checked');
        var checkbox2 = $('#notChecked').is(':checked');

        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }

        if (checkbox1 != true && checkbox2 != true) {

            $('#lblMsg').append('Select 1 checkbox');
            return false;
        }

        else {

            $('#lblMsg').empty();
            return true;
        }
    }



    function Go() {
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var Workstation = $('#Workstation').val();
        var serial_no = $('#serialNo').val();
        var programId = $('#ddProgram').val();
        var ProgramName = $('#ddProgram option:selected').text();
        var WoHeader_ID = $('#ddId').val();
        var checkbox1 = $('#isChecked').is(':checked');
        var checkbox2 = $('#notChecked').is(':checked');

          $('#option').modal('hide');
        OpenPage('\\ListingReports\\DailyProductionCopy\\Index?frmDt=' + fDate + ' &toDate=' + tDate + '&Workstation=' + Workstation + '&serialNo=' + serial_no + '&ProgramID=' + programId + '&ProgramName=' + ProgramName + '&WoHeaderId=' + WoHeader_ID + '&IsChecked=' + checkbox1 + '&NotChecked=' + checkbox2 + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>


