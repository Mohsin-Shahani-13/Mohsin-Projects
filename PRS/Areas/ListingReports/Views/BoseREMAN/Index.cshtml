@model IP.Areas.ListingReports.Models.BoseREMAN
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<style>
    .Part_Undrln {
        text-decoration: underline;
    }

    .leftsection {
        text-align: center;
        padding-top: 50px;
        height: 25%;
    }

    .hideColumn {
        display: none;
    }
</style>
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="panel panel-default">
        <div class="row">
            <div class="col-md-6">
                <div class="box-header with-border bg-blue-gradient">
                    @{
                        if (ViewBag.Option == "op")
                        {
                            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                                <span class="fa fa-filter fa-lg white"></span>
                            </button>
                            <input id="rptCode" type="hidden" value="011" />
                        }
                        else
                        {
                            <button type="button" id="opp" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                                <span class="fa fa-filter fa-lg white"></span>
                            </button>
                            <input id="rptCode" type="hidden" value="239" />
                            <input id="rptTitle" type="hidden" value="REMAN" />

                        }
                    }
                    <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
                    <div id="buttons" class="box-tools pull-right">
                    </div>
                </div>
                <div class="box-body">
                    <table id="lstData" class="table table-bordered table-striped text-sm" width="100%">
                        <thead>
                        </thead>
                        <tbody></tbody>
                        @*<tfoot></tfoot>*@
                    </table>
                </div>
            </div>
            <div id="left_panel_Bottom" class="col-md-6">
                <div id="left_bot_section" class="box panel panel-default leftsection" style="height:100%">
                    <h4>Click hyperlinks on left section to load Detail.</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {

        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var programId = '@Request.QueryString["programId"].ToString()';
        var programName = '@Request.QueryString["programName"].ToString()';

        var _lstData = @Html.Raw(Json.Encode(Model.lstBoseREMAN));  //datatable wiplist
        var _lstDataColumn = @Html.Raw(Json.Encode(Model.lstData)); // column headers
        var ProgramID = '@ViewBag.ProgramID';

        var conType = '@HttpContext.Current.Session["CONN_TYPE"].ToString()';
        var Program = '@ViewBag.ProgramName';

        //console.log(conType + "" + Program)

        var th = '<tr>'; //create th for headers
        var tft = '<tr>'; //create th for footers



            $.each(_lstDataColumn, function (index, value) {

                if (index == 0) {
                    th += '<th id=idx' + index + ' >' + value + ' </th>'; // for table headers
                }
                else {
                    th += '<th id=idx' + index + '>' + value + ' </th>'; // for table headers
                }

                if (index == 0) {
                    tft += '<th Style="text-align:left">Total :</th>';
                }
                else if (index == 4) {
                    tft += '<th></th>';
                    //for table footer show total.
                }
                else {
                    tft += '<th></th>'; // for table footers
                }

            });




            th += '</tr>'; // th end
            tft += '</tr>' // th footer end
            $('#lstData >thead').append(th); // th header append to thead
            $('#lstData >tfoot').append(tft); // th footer append to footer



        var columnDef = [];


    //// hyperlink on in_wip units
    //for (i = 0; i <= _lstDataColumn.length - 1; i++) {

    //    columnDef.push({

    //        "className": "text-center", "width": "70px", "targets": i });
    //}

        // Define columns and add hyperlink logic
        for (var i = 0; i < _lstDataColumn.length; i++) {
            if (i === 0) { // Assuming column 0 contains the rows that need hyperlinks
                columnDef.push({
                    "className": "text-center",
                    "width": "70px",
                    "targets": i,
                    "render": function (data, type, row, meta) {
                        if (row[0] === "DURAN" || row[0] === "MALCOLM" || row[0] === "PRINCE" || row[0] === "SCOTTY" || row[0] === "SMALLS" || row[0] === "STEVIE" || row[0] === "Other") {
                            // Create hyperlink
                            //return '<a href="your-link-here/' + encodeURIComponent(data) + '">' + data + '</a>';
                            var url = '<a href="#" class="Part_Undrln" onclick="OpenView(\'/ListingReports/BoseREMAN/GetDetail?ProgramID=' + encodeURIComponent(programId) + '&RemanValue=' + row[0] + '&frmDt=' + encodeURIComponent(fDate) + '&toDt=' + encodeURIComponent(tDate) + '\',\'left_panel_Bottom\')">' + data + '</a>';
                            return url;
                        }
                        return data; // Return plain text for other rows
                    }
                });
            } else {
                columnDef.push({
                    "targets": i,
                    "className": "text-center",
                    "width": "70px"
                });
            }
        }


        //ToggleDataList(true);
        ToggleDataList(true);
        var h = getHeight(88);
        //MakeFrameGrid('lstData', _lstData, h, columnDef, 'lstWIP', true, false, footerfunc);

        MakeDataGrid('lstData', _lstData, 0, columnDef, true, true, false);

    }

</script>
