                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');


        $.ajax({

            cache: false,
            type: 'GET',
            url: '/DellOpenOrderRepair/GetList',
            data: {
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                    var columnDef = [
                        { "data": "RTV Order Number", "title": "RTV Order Number", "width": "140px" },
                        { "data": "RMA Number", "title": "Partner", "width": "120px" },
                        { "data": "Dell Order Number", "title": "Dell Order Number", "width": "80px" },
                        { "data": "SPMOrderID", "title": "SPM Order ID", "width": "80px" },
                        { "data": "RTV Order Status", "title": "RTV Order Status", "width": "90px" },
                        { "data": "RTV Order Creation Date", "title": "RTV Order Creation Date", "width": "130px", "className": "text-right" },
                        { "data": "Line Item Number", "title": "Line Item Number", "width": "120px" },
                        { "data": "Item Number", "title": "Item Number", "width": "80px" },
                        { "data": "Item Description", "title": "Item Description", "width": "150px" },
                        { "data": "Item Revision", "title": "Item Revision", "width": "150px" },
                        { "data": "Item Family", "title": "Item Family", "width": "100px" },
                        { "data": "Quantity Ordered", "title": "Quantity Ordered", "width": "100px", "className": "text-right" },
                        { "data": "Quantity Received", "title": "Quantity Received", "width": "100px", "className": "text-right" },
                        { "data": "Inbound Way Bill", "title": "Inbound Way Bill", "width": "90px" },
                        { "data": "Inbound Carrier Code", "title": "Inbound Carrier Code", "width": "120px" },
                        { "data": "Owner", "title": "Owner", "width": "80px" },
                        { "data": "ShipmentDate", "title": "Shipment Date", "width": "90px", "className": "text-right" },
                        { "data": "Outbound Way Bill", "title": "Outbound Way Bill", "width": "100px" },
                        { "data": "Outbound Carrier", "title": "Outbound Carrier", "width": "100px" },
                        { "data": "ETA Closure", "title": "ETA Closure", "width": "80px" },
                        { "data": "Comments", "title": "Comments", "width": "130px" },
                        { "data": "Sub-Comments", "title": "Sub-Comments", "width": "130px" }
                ];

                //For Displaying  Footer Sum
                var footerfunc = function () {
                    var api = this.api();
                    $(api.column(11).footer()).html(thousands_separators(api.column(11, { search: 'applied' }).data().sum()));
                    $(api.column(12).footer()).html(thousands_separators(api.column(12, { search: 'applied' }).data().sum()));

                }
                    ToggleDataList(true);
                MakeDataGrid('lstDellOpenOrderRepair', data.lstDellOpenOrderRepair, 0, columnDef, true, true, footerfunc);

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>