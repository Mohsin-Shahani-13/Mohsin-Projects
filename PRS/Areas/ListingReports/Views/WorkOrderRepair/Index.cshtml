@model IP.Areas.ListingReports.Models.WorkOrderRepair
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstWorkOrderRepair" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                       

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                       

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>

    </div>
</div>

<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var frmDt = $('#frmDt').val();
        var toDt = $('#toDt').val();
        var custRef = $('#custRef').val();
        var ProgramId = $('#ddProgram').val();
        var ProgramName = $("#ddProgram option:selected").text();


        $.ajax({
            cache: false,
            type: 'GET',
            url: '/WorkOrderRepair/GetList',
            data: {
                frmDt: frmDt,
                toDt: toDt,
                custRef: custRef,
                ProgramId: ProgramId,
                ProgramName: ProgramName,

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                 if (!isSingleRow) {
                    var columnDef = [

                        { "data": "ID", "title": "ID", "width": "40px", "visible": false },
                        { "data": "ProgramID", "title": "Program ID", "width": "40px", "visible": false },
                        { "data": "Program", "title": "Program", "width": "50px", "visible": false },
                        {
                            "data": "CustomerReference", "title": "Customer Ref.", "width": "80px", 
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\WO\\Detail?Id=' + row["ID"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';

                                return url;
                            }
                        },
                        { "data": "ROCustomerReference", "title": "RO Customer Ref.", "width": "80px" },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "120px",
                            render: function (data, type, row) {
                                if (row["SerialNo"] == "*" || row["HAS_SN"] == 'N') {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "InCommingPartNo", "title": "Incomming Part No.", "width": "90px" },
                        { "data": "OutgoingPartNo", "title": "Outgoing Part No.", "width": "90px" }, 
                       

                        { "data": "RepairType", "title": "Repair Type", "width": "90px" },
                        { "data": "FamilyAttribute", "title": "Family", "width": "90px" },
                        { "data": "WorkstationID", "title": "Workstation Id", "width": "90px", "visible": false },
                        { "data": "Workstation", "title": "Work Station", "width": "90px" },
                        { "data": "StatusDESC", "title": "SNStatus", "width": "80px" },
                        { "data": "CO5_RightAlign", "title": "Requested", "width": "50px", "className": "text-right"},
                        { "data": "CO6_RightAlign", "title": "Consumed", "width": "50px", "className": "text-right" },
                        { "data": "CreatedBy", "title": "Created By", "width": "100px" },
                        { "data": "CreatedOn", "title": "Created On", "width": "90px", "className": "text-right"},
                        { "data": "LastActivityOn", "title": "Last Activity On", "width": "90px", "className": "text-right" }

                    ]
                     ToggleDataList(true);
                     //For Displaying  Footer Sum
                     var footerfunc = function () {
                         var api = this.api();
                         //$(api.column(11).footer()).html(thousands_separators(api.column(11, { search: 'applied' }).data().sum()));
                         $(api.column(14).footer()).html(thousands_separators(api.column(14, { search: 'applied' }).data().reduce(function (a, b) {
                             return Number(a) + Number(b);
                         }, 0)));
                         $(api.column(15).footer()).html(thousands_separators(api.column(15, { search: 'applied' }).data().reduce(function (a, b) {
                             return Number(a) + Number(b);
                         }, 0, 2)));
                     }
                 }



                MakeDataGrid('lstWorkOrderRepair', data.lstWorkOrderRepair, 0, columnDef, true, true, footerfunc);

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>