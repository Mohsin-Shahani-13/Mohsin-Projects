@model IP.Areas.ListingReports.Models.WorkOrderRepair
@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    <tr>
        <td class="pad">

            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.frmDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.custRef, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="custRef" name="custRef" autofocus
                   onkeydown="GoOnEnter()" />
        </td>

    </tr>
</table>
<table style="width:100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<script>
    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });
    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 1);

        var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('frmDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-365d',
        endDate: maxDate
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }
    $(document).ready(function () {

        $("#lstWorkOrderRepair").change(function () {
            $('#lblMsg').empty();
        });
    });

    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });
    //function GoOnEnter() {
    //    if (event.keyCode == 13) {
    //        var retVal = OptionsIsValid();
    //        if (retVal == true) {
    //            Go();
    //        }
    //    }
    //}
    //$('#btnGo').click(function () {
    //    var retVal = OptionsIsValid();
    //    if (retVal == true) {
    //        Go();
    //    }
    //});

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var frmDt = $('#frmDt').val();
        var toDt = $('#toDt').val();

        if (frmDt.length <= 0 || toDt.length <= 0 || !isDate(frmDt) || !isDate(toDt) || frmDt > toDt) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }
    }

        function Go() {

        var frmDt = $('#frmDt').val();
        var toDt = $('#toDt').val();
        var custRef = $('#custRef').val();
        var ProgramId = $('#ddProgram').val();
        var ProgramName = $("#ddProgram option:selected").text();

        $('#option').modal('hide');
        OpenPage('\\ListingReports\\WorkOrderRepair\\Index?frmDt=' + frmDt + '&toDt=' + toDt + '&custRef=' + custRef + '&ProgramID=' + ProgramId + '&ProgramName=' + ProgramName + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>