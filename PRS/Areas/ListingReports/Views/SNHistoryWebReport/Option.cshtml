    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.serialNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="serialNo" name="serialNo" placeholder="Specify atleast 4 characters for Serial No." autofocus
