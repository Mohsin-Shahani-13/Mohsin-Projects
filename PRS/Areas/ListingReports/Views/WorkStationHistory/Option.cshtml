@model IP.Areas.ListingReports.Models.WorkStationHistory
@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">
            @Html.Action("GetProgramBySite", "Home", new { id = "ProgramID", @name = "ProgramID", area = "" })
        </td>
    </tr>
    <tr>
        <td class="pad">

            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="dateFont ">
            <div>
                <br />
                <br />
                <label for="_isAllDate" style="margin-left:2px">
                    <input type="checkbox" id="isAllDate" name="isAllDate" onclick="EnableDisableOrdCreat(this)" />
                    All
                </label>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">

            <div>
                <label class="hidden">
                    @Html.CheckBoxFor(model => model.ischecked, new { @class = "form-check-input" }) No Problem Found
                </label>
            </div>
        </td>

    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.serialNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="serialNo" name="serialNo"  autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
</table>
<br />
<table style="width:100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td align="center">
            <span id="myValidationMessage" class="optionMsg"></span>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
<script>

    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });

    function EnableDisableOrdCreat(isAllDate) {
        var isAllDate = $('#isAllDate').is(':checked');
        if ($('#ischecked').prop("checked", false)) {
            $('#lblMsg').empty();
        }
        document.getElementById("fromDt").disabled = isAllDate;
        var nodes1 = document.getElementById("fromDt").getElementsByTagName('*');
        document.getElementById("toDt").disabled = isAllDate;
        var nodes1 = document.getElementById("toDt").getElementsByTagName('*');
        for (var i = 0; i < nodes1.length; i++) {
            nodes1[i].disabled = isAllDate;
        }
    };
   


    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 3);

        //var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-365d',
        endDate: maxDate
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var SerialNo = $('#serialNo').val();
        var isAllDate = $('#isAllDate').is(':checked');

        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }

        if (isAllDate == true && SerialNo.length < 1) {
            $('#lblMsg').text('Please Enter Serial No.');
            //$("#lblMsg").css("color", 'red');
            return false;
        }
      
        else {
            $('#lblMsg').empty();
            return true;
        }
    }

    function Go() {
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var programId = $('#ProgramID').val();
        var SerialNo = $('#serialNo').val();
        var ProgramName = $("#ProgramID option:selected").text();
        var ischecked = $('#ischecked').is(':checked');
        var isAllDate = $('#isAllDate').is(':checked');

        $('#option').modal('hide');
        OpenPage('\\ListingReports\\WorkStationHistory\\Index?frmDt=' + fDate + ' &toDate=' + tDate + '&ProgramID=' + programId + '&ProgramName=' + ProgramName + '&ischecked=' + ischecked + '&isAllDate=' + isAllDate + '&serialNo=' + SerialNo + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>

