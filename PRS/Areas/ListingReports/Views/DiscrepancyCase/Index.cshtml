@model IP.Areas.ListingReports.Models.DiscrepancyCase
@{
    ViewBag.Title = "Index";
    Layout = null;
}


<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">

          
                <div class="box-header with-border bg-blue-gradient">
                    <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                        <span class="fa fa-filter fa-lg white"></span>
                    </button>
                    <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
                    <div id="buttons" class="box-tools pull-right">

                    </div>
                </div>
                <div class="box-body" id="lstP">
                    <table id="lstDiscrepancyCase" class="table table-bordered table-striped text-sm table-hover" width="100%">
                        <thead>
                            <tr>
                                <th class="notexport"></th>
                                <th class="notexport"></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th class="notexport"></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="tblBody"></tbody>
                    </table>
                </div>
       
        </div>
    </div>




<script>
    function showModalForZPL(head, str) {
        $('#commentsheader').html(head);
        $('#commentsbody').html('<textarea rows="15" cols="78" name="usrtxt" wrap="hard"> "' + str + '" </textarea > ');
        $('#comments').modal('show');
    }
    $.fn.dataTable.render.ellipsisAdr = function (cutoff, header) {
        return function (data, type, row) {
            if (type === 'display') {
                var str = data.toString().replace(/(\r\n|\n|\r)/gm, "");

                //var header = "Reported Problem";
                return str.length < cutoff ?
                    str :
                    str.substr(0, cutoff - 1) + '<a href="#" onclick="showModalForZPL(\'' + header + '\', \'' + str + '\')"> See More</a>';
            }
            // Search, order and type can use the original data
            return data;
        };
    };
    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;



        var _programId = $('#ddProgram').val();
        var _ProgramName = $("#ddProgram option:selected").text();
      
        var queue = $("#ddqueue option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/DiscrepancyCase/GetList',
            data: {
                programID: _programId,
                programName: _ProgramName,
                queue: queue
              
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "id", "title": "id", "visible": false },
                        { "data": "ProgramID", "title": "ProgramId", "visible": false },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "80px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "120px",

                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "Subject", "title": "Subject" },
                        { "data": "Plus Case Status", "title": "Plus Case Status", "width": "100px" },
                        { "data": "CustomerStatus", "title": "Customer Status", "width": "150px" },
                        { "data": "CustomerCaseId", "title": "Customer Case Id", "width": "100px" },
                        { "data": "Queue", "title": "Queue", "width": "150px" },
                        { "data": "createdate", "title": "Create Date", "width": "90px", "className": "text-right" },
                        { "data": "Description", "title": "Description", "width": "250px", "render": $.fn.dataTable.render.ellipsisAdr(30, "Description") },
                        { "data": "Description", "title": "Description", "visible": false }
                    ];

                    ////For Displaying  Footer Sum
                    //var footerfunc = function () {
                    //    var api = this.api();
                    //    $(api.column(4).footer()).html(thousands_separators(api.column(4, { search: 'applied' }).data().sum()));
                    //}

                    ToggleDataList(true);
                    MakeDataGrid('lstDiscrepancyCase', data.lstDiscrepancyCase, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>
