@model IP.Areas.ListingReports.Models.DiscrepancyCase

@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
   
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.queue, new { @class = "col-4 col-form-label" })
            <select id="ddqueue" class="form-control" name="ddOrderType" onkeydown="GoOnEnter()">
                <option value="All">All</option>
                <option value="RXT Dallas-ERS Esc">RXT Dallas-ERS Esc</option>
                <option value="RXT Dallas-ERS No Stock">RXT Dallas-ERS No Stock</option>
                <option value="RXT Dallas-MRA Homeless">RXT Dallas-MRA Homeless</option>
                <option value="RXT Dallas-MRA Esc">RXT Dallas-MRA Esc</option>

            </select>
        </td>
    </tr>
</table>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
<script>
  

    function GoOnEnter() {
        if (event.keyCode == 13) {
            Go();
        }
    }

    $('#btnGo').click(function () {
        Go();
    });



    

    function Go() {
    var programId = $('#ddProgram').val();
    var ProgramName = $("#ddProgram option:selected").text();
    var queue = $("#ddqueue option:selected").text();

    $('#option').modal('hide');
        OpenPage('\\ListingReports\\DiscrepancyCase\\Index?programID=' + programId + '&programName=' + ProgramName + '&queue=' + queue + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
}


</script>
