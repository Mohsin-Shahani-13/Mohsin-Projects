                    { "data": "attributes", "title": "Attributes", "visible": false }
                ]


                ToggleDataList(true);
                MakeDataGrid('lstExceptionReport', data.lstExceptionReport, 0, columnDef, true, true, false);

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
    function showModal(head, str) {
        $('#commentsheader').html(head);
        $('#commentsbody').html('<textarea rows="15" cols="77" name="usrtxt" wrap="hard"> "' + str + '" </textarea > ');
        $('#comments').modal('show');
    }
    $.fn.dataTable.render.ellipsisAdr = function (cutoff, header) {
        return function (data, type, row) {
            if (type === 'display') {
                var str = data.toString().replace(/(\r\n|\n|\r|%|;|'|\/|"|<|>)/gm, "");
                return str.length < cutoff ?
                    str :
                    str.substr(0, cutoff - 1) + '<a href="#" onclick="showModal(\'' + header + '\', \'' + str + '\')"> See More</a>';
                str += "'";
            }
            return data;
        };
    };
