<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');

        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var statusDescription = $('#statusDescription').val();
        var _ProgramId = $('#ddProgram').val();
        var _ProgramName = $("#ddProgram option:selected").text();
        var serialNo = $('#serialNo').val();
        //var isArchive = $('#isArchive').is(':checked');
        var status = $('.btn-check:checked').attr('id');

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/ExceptionsReport/GetList',
            data: {
                frmDt: fDate,
                toDt: tDate,
                isAllDate: isAllDate,
                statusDescription: statusDescription,
                ProgramID: _ProgramId,
                ProgramName: _ProgramName,
                serialNo: serialNo,
                //isArchive: isArchive
                status: status

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').text(data.filterString);


                var columnDef = [
                    { "data": "id", "title": "ID", "width": "80px", "visible": false },
                    { "data": "programid", "title": "Program ID", "width": "80px", "visible": false },
                    { "data": "dataentryscriptid", "title": "Data Entry Script Id", "width": "80px" },
                    { "data": "DataEntryScriptName", "title": "Data Entry Script Name", "width": "300px" },
                    { "data": "StatusDescription", "title": "Status Desc.", "width": "100px" },
                    { "data": "message", "title": "Message", "width": "300px" },
                    { "data": "username", "title": "Username", "width": "120px" },
                    { "data": "batchid", "title": "Batch Id", "width": "70px" },
                    { "data": "createdate", "title": "Create Date", "width": "90px", "className": "text-right" },
                    { "data": "lastactivitydate", "title": "Last Activity Date", "width": "100px", "className": "text-right" },
                    { "data": "FieldNames", "title": "Field Names", "width": "270px", "render": $.fn.dataTable.render.ellipsisAdr(32, "Field Names") },
                    { "data": "FieldNames", "title": "Field Names", "width": "270px", "visible": false},
                    { "data": "c01", "title": "c01", "width": "80px" },
                    { "data": "c02", "title": "c02", "width": "80px" },
                    { "data": "c03", "title": "c03", "width": "80px" },
