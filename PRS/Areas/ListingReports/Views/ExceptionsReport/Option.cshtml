@model IP.Areas.ListingReports.Models.ExceptionsReport
@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.ProgramID, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    <tr>
        <td class="pad">
            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="dateFont ">
            <div>
                <br />
                <br />
                <label for="_isAllDate" style="margin-left:0px">
                    <input type="checkbox" id="isAllDate" name="isAllDate" onclick="EnableDisableOrdCreat(this)" />
                    All
                </label>
            </div>
        </td>
    </tr>

    @*<tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.statusDescription, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="statusDescription" name="statusDescription" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>*@
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.serialNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="serialNo" name="serialNo" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        @*<td colspan="4" class="pad">
                <label class="form-check-label">Search From Archive</label>
                <input class="form-check-input" type="checkbox" id="isArchive" name="isArchive">
            </td>*@
        @*<td colspan="4" class="pad">
                <label>
                    @Html.CheckBoxFor(model => model.isArchive, new { @class = "radio-option2", @id = "isArchive", @onclick = "isArchive(this)" })  Search within the archive:
                </label>
            </td>*@

        <td colspan="4" class="pad">
            <label class="col-4 col-form-label" for="statusDescription">Status:</label>
            
                <div class="form-check">
                    <label>
                        @Html.RadioButtonFor(model => model.status, "All", new { @class = "form-check-input btn-check", @id = "ALL" }) All
                    </label>
                </div>
                <div class="form-check">
                    <label>
                        @Html.RadioButtonFor(model => model.status, "Error", new { @class = "form-check-input btn-check", @id = "ERROR", @checked = "checked" }) Error
                    </label>
                </div>
                <div class="form-check">
                    <label>
                        @Html.RadioButtonFor(model => model.status, "OK", new { @class = "form-check-input btn-check", @id = "OK" }) OK
                    </label>
                </div>

        </td>
    </tr>
</table>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
<script>

    $('#option').on('shown.bs.modal', function () {
        $('#statusDescription').focus();
    });
    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });


    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 1);

        //var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-365d',
        endDate: maxDate
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();

        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }
    }

    function EnableDisableOrdCreat(isAllDate) {
        var isAllDate = $('#isAllDate').is(':checked');
        document.getElementById("fromDt").disabled = isAllDate;
        var nodes1 = document.getElementById("fromDt").getElementsByTagName('*');
        document.getElementById("toDt").disabled = isAllDate;
        var nodes1 = document.getElementById("toDt").getElementsByTagName('*');
        for (var i = 0; i < nodes1.length; i++) {
            nodes1[i].disabled = isAllDate;
        }
    };


    function Go() {
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var statusDescription = $('#statusDescription').val();
        var ProgramId = $('#ddProgram').val();
        var ProgramName = $("#ddProgram option:selected").text();
        var serialNo = $('#serialNo').val();
        var status = $('.btn-check:checked').attr('id');
        //var isArchive = $('#isArchive').is(':checked');
          $('#option').modal('hide');
        OpenPage('\\ListingReports\\ExceptionsReport\\Index?frmDt=' + fDate + ' &toDate=' + tDate + ' &isAllDate=' + isAllDate + '&statusDescription=' + statusDescription + '&ProgramID=' + ProgramId + '&ProgramName=' + ProgramName + '&serialNo=' + serialNo + '&status=' + status + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>


