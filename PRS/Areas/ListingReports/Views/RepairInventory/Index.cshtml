@model IP.Areas.ListingReports.Models.RepairInventory
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<style>
    /*tr {
        white-space:nowrap;
    }*/
</style>

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" onclick="LoadData();">
                <span class="fa fa-list fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle</strong><strong id="filterString"></strong><strong id="refreshDate"></strong></h6>

            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstRepairInventory" class="table table-bordered table-striped text-sm table-hover" width="100%">
                <thead class="sorted-asc">
                    <tr>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>
    

    function RunJob() {
        $.ajax({
            cache: false,
            type: 'GET',
            url: '/RepairInventory/RunJob',
            datatype: JSON,
            success: function (data) {
                console.log(data.Status)
                if (data.Status) {
                    alert("Pakage Run successfully. New Data Will be available after few minutes.");
                    //setTimeout(LoadData, 15000);
                }
                else if (data.Message.includes("already running")) {
                    alert("The job is already running.");
                }
            },
        });
    }


    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var serialNo = $('#serialNo').val();
        $.ajax({

            cache: false,
            type: 'GET',
            url: '/RepairInventory/GetList',
            data: {
                serialNo: serialNo
            },
            datatype: JSON,
            success: function (data) {
            
                $('#filterString').append(data.filterString);
                $('#refreshDate').html(data.refreshDate);

                    var columnDef = [
                        { "data": "Location", "title": "Location", "width": "140px" },
                        { "data": "Location Desc", "title": "Location Desc", "width": "170px", "render": $.fn.dataTable.render.ellipsisAdr(18, "Location Description") },
                        { "data": "Location Desc", "title": "Location Desc", "width": "260px", "visible": false }, //for excel export
                        { "data": "Item Number", "title": "Item Number", "width": "110px" },
                        {
                            "data": "Description", "title": "Description"
                            , "render": $.fn.dataTable.render.ellipsisAdr(18, "Description")
                        },
                        {
                            "data": "Description", "title": "Description", "visible": false
                            
                        }, //for excel export
                        { "data": "Serial Number", "title": "Serial Number", "width": "110px" },
                        { "data": "Good Quantity", "title": "Good Quantity", "width": "80px", "className": "text-right"},
                        { "data": "Bad Quantity", "title": "Bad Quantity", "width": "80px", "className": "text-right" },
                        { "data": "Good Reserve Quantity", "title": "Good Reserve Quantity", "width": "90px", "className": "text-right" },
                        { "data": "Bad Reserve Quantity", "title": "Bad Reserve Quantity", "width": "90px", "className": "text-right" },
                        { "data": "Total Reserve Quantity", "title": "Total Reserve Quantity", "width": "90px", "className": "text-right" },
                        { "data": "Total Quantity", "title": "Total Quantity", "width": "90px", "className": "text-right" },
                        { "data": "Last Transaction Date", "title": "Last Transaction Date", "width": "90px", "className": "text-right" },
                        { "data": "InsertDate", "title": "Insert Date", "width": "90px", "className": "text-right" }

                    ];

                    ToggleDataList(true);
                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(7).footer()).html(thousands_separators(api.column(7, { search: 'applied' }).data().sum()));
                        $(api.column(8).footer()).html(thousands_separators(api.column(8, { search: 'applied' }).data().sum()));
                        $(api.column(9).footer()).html(thousands_separators(api.column(9, { search: 'applied' }).data().sum()));
                        $(api.column(10).footer()).html(thousands_separators(api.column(10, { search: 'applied' }).data().sum()));
                        $(api.column(11).footer()).html(thousands_separators(api.column(11, { search: 'applied' }).data().sum()));
                        $(api.column(12).footer()).html(thousands_separators(api.column(12, { search: 'applied' }).data().sum()));

                }
                
                MakeDataGrid('lstRepairInventory', data.lstRepairInventory, 0, columnDef, true, true, footerfunc);
                qrytool = '<a id="runJob"  class="btn-header btn-box-tool" onclick="RunJob();" title="Click to Reload Grid Data" >';
                qrytool += '<span class="fa-stack"><i class="fa fa-circle fa-stack-2x" style="color: #000;"></i><i class="fas fa-redo-alt fa-stack-1x" style="color: white;"></i></span>';
                qrytool += '</a>';
                $('.dt-buttons').prepend(qrytool);
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
    function showModalForZPL(head, str) {
        $('#commentsheader').html(head);
        $('#commentsbody').html('<textarea rows="15" cols="78" name="usrtxt" wrap="hard"> "' + str + '" </textarea > ');
        $('#comments').modal('show');
    }
    $.fn.dataTable.render.ellipsisAdr = function (cutoff, header) {
        return function (data, type, row) {
            if (type === 'display') {
                var str = data.toString().replace(/(\r\n|\n|\r|%|;|'|\/|"|=|<|>)/gm, "");
                // var str = data.toString();
                //var header = "Batch Text";
                return str.length < cutoff ?
                    str :
                    str.substr(0, cutoff - 1) + '<a href="#" onclick="showModalForZPL(\'' + header + '\', \'' + str + '\')"> See More</a>';
                str += "'";
            }
            // Search, order and type can use the original data
            return data;
        };
    };
</script>
