@model IP.Areas.ListingReports.Models.DELLWIPSnapshot
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<div id="parentDiv" class="container">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool">
                @*title="Option Page" onclick="$('#option').modal('show');"*@
                <span class="fa fa-list fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">
            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstDELLWIPSnapshot" class="table table-bordered table-striped text-sm table-hover" width="100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>

                        @*<th></th>*@
                    </tr>
                </thead>
                @*<tbody id="tblBody"></tbody>*@
                <tfoot>
                    <tr>
                        <th></th>
                        <th></th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        @*<th></th>*@
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>


    ToggleDataList(false);
    LoadData();
    function LoadData() {

        $('#tblBody').empty();

        var isSingleRow = false;

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/DELLWIPSnapshot/GetList',
            data: {
                
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "Program ID", "width": "70px", "visible": false },
                        { "data": "ProgramName", "title": "Program", "width": "40px", "visible": false },
                        { "data": "REGION", "title": "Region", "width": "110px" },
                        { "data": "PARTNER_NAME", "title": "Partner Name", "width": "140px" },
                        {
                            "data": "partno", "title": "Part No.", 
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["partno"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        //{
                        //    "data": "SerialNo", "title": "Serial No.",
                        //    render: function (data, type, row) {
                        //        if (row["serialno"] == "*" || row["HAS_SN"] == 'N') {
                        //            url = row["serialno"];
                        //        }
                        //        else {
                        //            var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["partno"] + '&page=list" target=_blank > ' + data + '</a>';
                        //        }
                        //        return url;
                        //    }
                        //},
                        { "data": "WIP", "title": "WIP", "width": "80px", "className":"text-right" }
                    ];
                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(5).footer()).html(thousands_separators(api.column(5).data().sum()));
                    }
                    ToggleDataList(true);

                    MakeDataGrid('lstDELLWIPSnapshot', data.lstDELLWIPSnapshot, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }

</script>



