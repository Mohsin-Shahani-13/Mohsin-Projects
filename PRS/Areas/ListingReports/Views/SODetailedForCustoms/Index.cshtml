</div>

<script>
    $.fn.dataTable.render.ellipsisAdr1 = function (cutoff) {
        return function (data, type, row) {
            if (type === 'display') {
                var str = data.toString().replace(/(\r\n|\n|\r|'|)/gm, "");

                var header = "Message";

                return str.length < cutoff ?
                    str :
                    str.substr(0, cutoff - 1) + '<a href="#" onclick="showModalForZPL(\'' + header + '\', \'' + str + '\')"> More</a>';
            }
            // Search, order and type can use the original data
            return data;
        };
    };
    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var SerialNo = $('#SerialNo').val();
        var OrderNo = $('#OrderNo').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/SODetailedForCustoms/GetList',
            data: {
                frmDt: fDate,
                toDt: tDate,
                SerialNo: SerialNo,
                OrderNo: OrderNo
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);


                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ID", "title": "Program Id", "width": "0px", "visible": false },
                        { "data": "SOHeaderID", "title": "SO Header Id", "width": "0px", "visible": false },
                        { "data": "Program", "title": "Program", "width": "50px" },
                        {
                            "data": "Ship Order Number", "title": "Ship Order No.", "width": "150px",
                            render: function (data, type, row) {

                                var url = '<a href= "\\SupplyChain\\SO\\Detail?ID=' + row["SOHeaderID"] + '&custRef=' + row["Ship Order Number"] + '&ProgramId=' + row["ID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "150px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "Family/Cell", "title": "Family/Cell", "width": "100px" },
                        { "data": "Ship To Address", "title": "Ship To Address", "width": "200px" },
                        { "data": "State", "title": "State", "width": "70px" },
                        { "data": "Country", "title": "Country", "width": "70px" },
                        { "data": "Zip", "title": "Zip Code", "width": "110px" },
                        { "data": "Carrier", "title": "Carrier", "width": "70px" },
                        { "data": "TrackingNo", "title": "Tracking No.", "width": "120px" },
                        { "data": "Box ID", "title": "Box Id", "width": "80px" },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "100px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + d + '</a>';

                                return url;
                            }
                        },
                        { "data": "Ship Date", "title": "Shipped On", "width": "120px", "className": "text-right" },
                        { "data": "Ship Type", "title": "Ship Type", "width": "120px" },
                        { "data": "COO", "title": "COO", "width": "90px" },
                        { "data": "HTS MX", "title": "HTS MX", "width": "100px" },
                        { "data": "HTS US", "title": "HTS US", "width": "100px" },
                        { "data": "weight", "title": "Weight", "width": "90px" },
                        { "data": "Quantity", "title": "Qty", "width": "60px", "className": "text-right" },
                        { "data": "Process", "title": "Process", "width": "70px" },
                        { "data": "STD NAME ID", "title": "STD Name Id", "width": "90px" },
                        { "data": "STD NAME", "title": "STD Name", "width": "140px", "render": $.fn.dataTable.render.ellipsisAdr1(15) },
                        { "data": "STD NAME", "title": "STD Name", "visible": false },
                        { "data": "Status", "title": "Status", "width": "70px" },
                        { "data": "Username", "title": "Username", "width": "100px" },
                        { "data": "CreateDate", "title": "Created On", "width": "90px", "className": "text-right" }
                    ]

                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(20).footer()).html(thousands_separators(api.column(20, { search: 'applied' }).data().sum()));

                    }

                    ToggleDataList(true);
                    MakeDataGrid('lstSODetailedForCustoms', data.lstSODetailedForCustoms, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
    function showModalForZPL(head, str) {
        $('#commentsheader').html(head);
        $('#commentsbody').html('<textarea rows="15" cols="77" name="usrtxt" wrap="hard"> "' + str + '" </textarea > ');
        $('#comments').modal('show');
    }
</script>
