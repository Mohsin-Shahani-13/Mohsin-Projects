@model IP.Areas.ListingReports.Models.Blacklist

@{
    ViewBag.Title = "Index";
    Layout = null;
}
<style>
    tr {
        white-space: nowrap;
    }
</style>
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstBlacklist" class="table table-bordered table-striped text-sm table-hover" width="100%">
                <thead class="sorted-asc">
                    <tr>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;

        var _programId = $('#ddProgram').val();
        var _programName = $("#ddProgram option:selected").text();
        var _fDate = $('#fromDt').val();
        var _tDate = $('#toDt').val();
        var _user = $('#user').val();
        var _reason = $('#reason').val();
        var _attribute = $('#attribute').val();
        var _attributeValue = $('#attributeValue').val();



        $.ajax({

            cache: false,
            type: 'GET',
            url: '/Blacklist/GetList',
            data: {
                programId: _programId,
                programName: _programName,
                fDate: _fDate,
                tDate: _tDate,
                user: _user,
                reason: _reason,
                attribute: _attribute,
                attributeValue: _attributeValue
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ID", "title": "ID", "width": "70px" },
                        { "data": "ProgramID", "title": "Program ID", "width": "70px", "visible" :false },
                        { "data": "Program", "title": "Program", "width": "100px" },
                        { "data": "Description", "title": "Reason"},
                        { "data": "AttributeName", "title": "Attribute Name", "width": "150px" },
                        { "data": "Value", "title": "Attribute Value", "width": "100px" },
                        {
                            "data": "SERIAL", "title": "Serial No.",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SERIAL"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["SKU"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SKU", "title": "SKU", "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["SKU"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "FROM_LOCATION", "title": "From Loc.", "width": "150px" },
                        { "data": "TO_LOCATION", "title": "To Loc.", "width": "150px" },
                        { "data": "TRANSACTION_DATETIME", "title": "Trans. DateTime", "width": "100px", "className": "text-right" },

                        { "data": "Status", "title": "Status", "width": "100px" },
                        { "data": "User", "title": "User", "width": "100px" },
                        { "data": "CreateDate", "title": "Create Date", "width": "120px", "className": "text-right" },
                        { "data": "LastActivityDate", "title": "Last Activity Date", "width": "120px", "className": "text-right"}
                    ];
                    ToggleDataList(true);
                    MakeDataGrid('lstBlacklist', data.lstBlacklist, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>



