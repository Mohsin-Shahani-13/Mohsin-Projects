@model IP.Areas.ListingReports.Models.SerialNumOnHold
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstSerialNumOnHold" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/SerialNumOnHold/GetList',
            data: {

                programId: _programId,
                ProgramName: _ProgramName
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "ProgramID", "width": "100px", "visible": false },
                        { "data": "ID", "title": "RO_ID", "width": "100px", "visible": false },
                        { "data": "Program", "title": "Program", "width": "60px" },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "120px"
                            ,
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SerialNo", "title": "Serial No.","width": "120px",
                            render: function (data, type, row) {
                                if (row["SerialNo"] == "*") {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "LocationNo", "title": "Location No.", "width": "120px" },
                        { "data": "RODate", "title": "RO Date", "width": "90px", "className": "text-right"},
                        { "data": "CreateDate", "title": "Created On", "width": "90px", "className": "text-right" },
                        { "data": "Description", "title": "Status", "width": "100px" },
                        {
                            "data": "CustomerReference", "title": "RO No.", "width": "130px",
                            render: function (data, type, row) {

                                var url = '<a href= "\\SupplyChain\\RO\\Detail?ID=' + row["ID"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "Reason", "title": "Reason" },
       

                    ];
                    //For Displaying  Footer Sum
         
                    ToggleDataList(true);
                    MakeDataGrid('lstSerialNumOnHold', data.lstSerialNumOnHold, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>


