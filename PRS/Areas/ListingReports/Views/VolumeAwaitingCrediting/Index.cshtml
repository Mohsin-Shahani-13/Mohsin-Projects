@model IP.Areas.ListingReports.Models.VolumeAwaitingCrediting
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="row">
            <div class="col-md-8">
                <div class="box-header with-border bg-blue-gradient">
                    <button type="button" class="btn btn-box-tool">
                        <span class="fa fa-list fa-lg white"></span>
                    </button>
                    <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
                    <div id="buttons" class="box-tools pull-right">
                    </div>
                </div>
                <div class="box-body" id="lstP">
                    <table id="lstVolumeAwaitingCrediting" class="table table-bordered table-striped text-sm table-hover" width="100%">
                        <thead class="sorted-asc">
                            <tr>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div id="left_panel_Bottom" class="col-md-4">
                <div id="left_bot_section" class="box panel panel-default leftsection" style="height:100%">
                    <h4>Click hyperlinks on left section to load Part No.</h4>
                </div>
            </div>
        </div>
    </div>
</div>
        <script>


            ToggleDataList(false);
            LoadData();
            function LoadData() {

                $('#tblBody').empty();

                var isSingleRow = false;

                $.ajax({

                    cache: false,
                    type: 'GET',
                    url: '/VolumeAwaitingCrediting/GetList',
                    data: {

                    },
                    datatype: JSON,
                    success: function (data) {
                        $('#filterString').append(data.filterString);

                        if (!isSingleRow) {
                            var columnDef = [
                                { "data": "Area", "title": "Area", "width": "110px" },
                                { "data": "Orders", "title": "Orders", "width": "80px", "className": "text-right" },
                                { "data": "Units", "title": "Unit", "width": "80px", "className": "text-right" },
                                {
                                    "data": "0-30", "title": "0-30", "width": "80px", "className": "text-right",
                                    render: function (data, type, row) {

                                        var url = '<a href="#" class="Part_Undrln" onclick="OpenView(\'\\\\ListingReports\\\\VolumeAwaitingCrediting\\\\GetUnit?ProgramID=' + row["ProgramID"] + '&Area=' + row["Area"] + '&Range=0-30 Days' + '\',\'left_panel_Bottom\')">' + data + '</a>';
                                        return url;
                                    }
                                },
                                {
                                    "data": "30+ Days", "title": "30+Days", "width": "80px", "className": "text-right",
                                    render: function (data, type, row) {

                                        var url = '<a href="#" class="Part_Undrln" onclick="OpenView(\'\\\\ListingReports\\\\VolumeAwaitingCrediting\\\\GetUnit?ProgramID=' + row["ProgramID"] + '&Area=' + row["Area"] + '&Range=Above 30 Days' + '\',\'left_panel_Bottom\')">' + data + '</a>';
                                        return url;
                                    }
                                }
                            ];

                            ToggleDataList(true);

                            MakeDataGrid('lstVolumeAwaitingCrediting', data.lstVolumeAwaitingCrediting, 0, columnDef, true, true, false);
                        }
                        if (data["ErrorMessage"] != null) {
                            $('.dataTables_empty > p').text(data["ErrorMessage"]);
                        }
                    },
                    onerror: function (r) { r },
                    failure: function (r) { r }
                });
            }

        </script>



