                        {
                            <th></th>
                        }
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    var COLUMN_FORMAT =
    {
        formatDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(4));
        },
        formatTwoDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(2);
        },
        formatNumber: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(0));
        },

        formatNumberForZero: function (data, type, row) {
            var val = +data;
            return val === 0 ? 0 : val.toFixed(0);
        },

    };
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var serialNo = $('#serialNo').val();
        var partNo = $('#partNo').val();
        var Location = $('#Location').val();
        var ToLocation = $('#ToLocation').val();
        var _programId = $('#ddProgram').val();
        var _ProgramName = $("#ddProgram option:selected").text();
        //var _transTypeID = $('#lstTranstype option:selected').val();
        //var _transType = $('#lstTranstype option:selected').text();

        var _transType = '@Request.QueryString["Transtype"].ToString()';
        var _transTypeID ='@Request.QueryString["TranstypeID"].ToString()';

        //For Multiple Status
        var _transTypeID = '';
        var _transType = '';
        if (selectedParts == "All") {
            _transType = "All";
        }
        else {
            $('#lstTranstype :selected').each(function (i, sel) {
                if (i == 0) {
                    _transTypeID = "'" + ($(sel).val()) + "'";
                    _transType = ($(sel).text());
                }
                else {
                    _transTypeID += "," + "'" + ($(sel).val()) + "'";
                    _transType = "Multiple";
                }
            });
        }

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/PartsTransaction/GetList',
            data: {
                frmDt: fDate,
                toDate: tDate,
                isAllDate: isAllDate,
                serialNo: serialNo,
                partNo: partNo,
                Location: Location,
                ToLocation: ToLocation,
                programId: _programId,
                ProgramName: _ProgramName,
                transTypeID: _transTypeID,
                transType: _transType
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                //$.each(data.lstPartsTransaction, function (index, row) {

                //    //if (data.lstPartsTransaction.length == 1) {
                //    //    isSingleRow = true;
                //    //    MenuHide();
                //    //    OpenPage('\\ListingReports\\PartInquiry\\Detail?partNo=' + row["partno"] + '&page=detailed');
                //    //}
                //});

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "Program ID", "width": "40px", "visible": false },
                        { "data": "OrderHeaderID", "title": "OrderHeader ID", "width": "40px", "visible": false },
                        {
                            "data": "partno", "title": "Part No.", "width": "100px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["partno"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "Description", "title": "Description", "width": "300px" },
                        { "data": "Program", "title": "Program", "width": "40px", "visible": false },
                        {
                            "data": "ParentSerialNo", "title": "Parent Serial No.", "width": "100px",
                            render: function (data) {
                                var d = data.toString();
                                return d  ;
                            }
                        },
                        { "data": "HAS_SN", "title": "HAS_SN", "visible": false },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "100px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                if (row["SerialNo"] == "*" || row["HAS_SN"] == 'N') {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["partno"] + '&page=list" target=_blank > '  + d + '</a>';
                                }
                                    return url;
                            }
                        },
                        { "data": "Qty", "title": "Qty", "width": "30px", "className": "text-right" },
                        { "data": "Source", "title": "Source", "width": "120px" },
                        { "data": "Condition", "title": "Condition", "width": "50px" },
                        { "data": "Configuration", "title": "Configuration", "width": "50px" },
                        { "data": "Location", "title": "Location", "width": "100px" },
                        { "data": "ToLocation", "title": "To Location", "width": "100px" },
                        { "data": "Reason", "title": "Reason", "width": "120px" },
                        { "data": "PartType", "title": "Part Type", "width": "120px" },
                        {
                            "data": "CustomerReference", "title": "Customer Ref.", "width": "120px",
                            render: function (data, type, row) {

                                var url = '';
                                var d = data.toString();
                                var orderType = row["OrderType"];

                                if (orderType == "") {
                                    url = d;

                                }
                                if (orderType == 'RO') {
                                    url = '<a href= "\\SupplyChain\\RO\\Detail?ID=' + row["OrderHeaderID"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + d + '</a>';

                                }

                                else if (orderType == 'SO') {
                                    url = '<a href= "\\SupplyChain\\SO\\Detail?SOHeaderId=' + row["OrderHeaderID"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + d + '</a>';

                                }
                                else if (orderType == 'WO' || orderType == 'CS') {
                                    url = '<a href= "\\SupplyChain\\WO\\Detail?ID=' + row["OrderHeaderID"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + d + '</a>';

                                }

                                return url;
                            }
                        },
                        { "data": "PartTransactionType", "title": "Trans. Type", "width": "100px" },
                        { "data": "OrderType", "title": "Order Type", "width": "70px" },
                        { "data": "Username", "title": "Created By", "width": "100px" },
                        { "data": "CreateDate", "title": "Trans. Date", "width": "110px", "className": "text-right" }


                    ]
                    if (_ProgramName == "META") {
                        // Find the index of the "Fault Description" column
                        var colIndex = columnDef.findIndex(column => column.data === "OrderType");

                        // Insert the Symptom column after the Fault Description column
                        columnDef.splice(colIndex + 1, 0, {
                            "data": "LotNo",
                            "title": "Lot No.",
                            "width": "70px"
                        });
                    }
                    //For Displaying  Footer Sum
                    //var footerfunc = function () {
                    //    var api = this.api();
                    //   // $(api.column(8).footer()).html(thousands_separators(api.column(8, { search: 'applied' }).data().sum()));

                    //    $(api.column(8).footer()).html(thousands_separators(api.column(8, { search: 'applied' }).data().reduce(function (a, b) {
                    //        a = parseInt(a, 10);
                    //        if (isNaN(a)) { a = 0; }

                    //        b = parseInt(b, 10);
                    //        if (isNaN(b)) { b = 0; }

                    //        return a + b;
                    //    }, 0)));


                    //}

                    ToggleDataList(true);
                    MakeDataGrid('lstPartsTransaction', data.lstPartsTransaction, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>


