@model IP.Areas.ListingReports.Models.PartsTransaction
@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    <tr>
        <td class="pad">
            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td id="AllDate" class="dateFont">
            <div>
                <br />
                <br />
                <label for="_isAllDate" style="margin-left:0px">
                    <input type="checkbox" id="isAllDate" name="isAllDate" onclick="EnableDisableOrdCreat(this)" />
                    All
                </label>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.serialNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="serialNo" name="serialNo" placeholder="Enter serial number(s), separated by commas" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.partNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="partNo" name="partNo" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.Location, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="Location" name="Location" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.ToLocation, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="ToLocation" name="ToLocation" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td class="pad" colspan="4">
            @Html.LabelFor(model => model.TransType, htmlAttributes: new { @class = "form-label" })
            <select id="lstTranstype" multiple="multiple" class="multiselect form-control" name="options[]">
                @{
                    if (Model != null)
                    {
                        foreach (var item in Model.lstTranstype)
                        {
                            <option value="@item[0]">@item[1]</option>
                        }
                    }
                }
            </select>
        </td>
    </tr>

</table>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
<script>
    //For Multiple TransType
    selectedParts = '';
    $('#lstTranstype').multiselect({
        includeSelectAllOption: true,
        selectAllText: 'All',
        buttonWidth: '100%',
        maxHeight: 170,
        enableFiltering: true,
        enableCaseInsensitiveFiltering: true,
        filterPlaceholder: 'Search',
        numberDisplayed: 4,
        templates: {
            ul: '<ul class="multiselect-container dropdown-menu" style="-ms-overflow-x: hidden; -ms-overflow-y: auto; max-height: 300px; width:100%;">"'
        },

        buttonText: function (options, select) {
            if (options.length == 0) {
                return 'select from list';
            }
            else {
                if (options.prevObject.length == options.length) {
                    selectedParts = 'All';
                } else {
                    selectedParts = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selectedParts += "'" + label + "', ";
                    });
                    selectedParts = selectedParts.substr(0, selectedParts.length - 2);
                }



                if (options.length > this.numberDisplayed) {
                    return options.length + ' ' + this.nSelectedText;
                }
                else {
                    var selected = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selected += label + ", ";
                    });
                    return selected.substr(0, selected.length - 2);
                }
            }
        }
    });



    $('#lstTranstype').multiselect('selectAll', false);
    $("#lstTranstype").multiselect('updateButtonText');

    $(document).ready(function () {


        $("#lstTranstype").change(function () {
            $('#lblMsg').empty();
        });
    });

    function EnableDisableOrdCreat(isAllDate) {
        var isAllDate = $('#isAllDate').is(':checked');
        document.getElementById("fromDt").disabled = isAllDate;
        var nodes1 = document.getElementById("fromDt").getElementsByTagName('*');
        document.getElementById("toDt").disabled = isAllDate;
        var nodes1 = document.getElementById("toDt").getElementsByTagName('*');
        for (var i = 0; i < nodes1.length; i++) {
            nodes1[i].disabled = isAllDate;
        }
    };
    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 1);

        //var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-365d',
        endDate: maxDate
    });


    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var serialNo = $('#serialNo').val();
        var partNo = $('#partNo').val();
        var isAllDate = $('#isAllDate').is(':checked');
        
        if (isAllDate) {
            if (serialNo === "" && partNo === "") {
                $('#lblMsg').append('Please enter Serial No. or Part No.');
                return false;
            }
        }
        var TransType = $('#lstTranstype option:selected').text();
        if (TransType == "") {
            $('#lblMsg').append('Please select trans type from list');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;

            if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
                $('#lblMsg').append('Enter a valid date');
                return false;
            }
            else {
                $('#lblMsg').empty();
                return true;
            }
            if (TransType == null) {
                $('#lblMsg').empty();
                $('#lblMsg').append('Something went wrong! Reopen Option Page');
                return false;
            }
            if (TransType == 'No Data Available') {
                $('#lblMsg').empty();
                $('#lblMsg').append('Select Trans type ');
                return false;
            }

            else {
                $('#lblMsg').empty();
                return true;
            }
                
            
        }
    }

    function Go() {

        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var serialNo = $('#serialNo').val();
        var partNo = $('#partNo').val();
        var Location = $('#Location').val();
        var ToLocation = $('#ToLocation').val();
        var programId = $('#ddProgram').val();
        var ProgramName = $("#ddProgram option:selected").text();
        

        var transType = $('#lstTranstype option:selected').text();
        var transTypeID = $('#lstTranstype option:selected').val();


        $('#option').modal('hide');
        OpenPage('\\ListingReports\\PartsTransaction\\Index?frmDt=' + fDate + ' &toDate=' + tDate + ' &isAllDate=' + isAllDate + ' &serialNo=' + serialNo + '&partNo=' + partNo + '&Location=' + Location + '&ToLocation=' + ToLocation + '&ProgramID=' + programId + '&ProgramName=' + ProgramName + '&transType=' + transType + '&transTypeID=' + transTypeID + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>


