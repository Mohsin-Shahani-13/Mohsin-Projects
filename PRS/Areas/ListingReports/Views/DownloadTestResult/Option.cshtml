<style>
    .pad {
        padding: 10px 2px 15px;
    }
    .disableanchor {
        pointer-events: none;
        opacity: 0.6;
        cursor: not-allowed;
    }
    .dropdown-container {
        border: 1px solid #ccc; /* Add border style to create a boundary */
        padding: 10px; /* Add padding for spacing inside the container */
        position: relative;
    }
</style>

