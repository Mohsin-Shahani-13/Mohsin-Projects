@model IP.Areas.ListingReports.Models.PartsInventory
@{
    ViewBag.Title = "Option";
    Layout = null;
}


<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">
            @Html.Action("GetProgramBySite", "Home", new { id = "ProgramID", @name = "ProgramID", area = "" })
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.partNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="partNo" name="partNo" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.Warehouse, new { @class = "col-4 col-form-label" })
            @Html.DropDownList("ddlWarehouse", null, new { id = "ddlWarehouse", @name = "ddlWarehouse", @class = "form-control", value=1, @onkeydown = "GoOnEnter()" })
        </td>
    </tr>

</table>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
<script>
    $('#option').on('shown.bs.modal', function () {
        $('#partNo').focus();
    });

    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    function GoOnEnter() {
        if (event.keyCode == 13) {
            Go();
        }
    }

    $('#btnGo').click(function () {
        Go();
    });

    function Go() {
        var partNo = $('#partNo').val();
        var programId = $('#ProgramID').val();
        var ProgramName = $("#ProgramID option:selected").text();
        var Warehouse = $("#ddlWarehouse option:selected").text();
          $('#option').modal('hide');
        OpenPage('\\ListingReports\\PartsInventory\\Index?partNo=' + partNo + '&ProgramID=' + programId + '&ProgramName=' + ProgramName  + '&Warehouse=' + Warehouse + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>



