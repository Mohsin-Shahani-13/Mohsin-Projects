@model IP.Areas.ListingReports.Models.SODetailedData
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>

        <div class="box-body" id="lstP">
            <table id="lstSODetailedData" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th class="notexport"></th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>

    </div>
</div>

<script>

    ToggleDataList(false);
    var COLUMN_FORMAT =
    {
        formatDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(4));
        },
        formatTwoDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(2);
        },
        formatNumber: function (data, type, row) {
            var val = +data;
            return val == 0 ? '' : thousands_separators(val.toFixed(0));
        },

        formatNumberForZero: function (data, type, row) {
            // Ensure data is a string and strip out any commas, currency symbols, or spaces
            var val = parseFloat(data.toString().replace(/[^0-9.-]+/g, ''));

            // Handle invalid values or NaN
            if (isNaN(val)) {
                return '0.00'; // Return empty string if the value cannot be parsed
            }
            return val === 0 ? '0.00' : val.toFixed(2); // Return '0.00' for 0, else format to 2 decimal places
        },

    };
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();
        var _custRef = $('#custRef').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/SODetailedData/GetList',
            data: {
                frmDt: fDate,
                toDate: tDate,
                programId: _programId,
                ProgramName: _ProgramName,
                custRef: _custRef
            },
            datatype: JSON,
            success: function (data) {

                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "programId", "title": "Program ID", "width": "100px", "visible": false },
                        { "data": "program", "title": "Program", "width": "70px" },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "100px",
                            render: function (data, type, row) {

                                var url = '<a href= \\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["programId"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';

                                return url;
                            }
                        },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "110px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["programId"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SOCustomerReference", "title": "Customer Ref.", "width": "130px",
                            render: function (data, type, row) {

                                var url = '<a href= "\\SupplyChain\\SO\\Detail?ID=' + row["SOHeaderID"] + '&custRef=' + row["SOCustomerReference"] + '&ProgramId=' + row["programId"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "ShipmentDate", "title": "Shipment On", "width": "120px", "className": "text-right" },
                        { "data": "SOHeaderID", "title": "SO Header Id", "width": "110px" },
                        { "data": "Status", "title": "Status", "width": "50px" },
                        { "data": "ThirdPartyReference", "title": "Third Party Ref.", "width": "150px" },
                        { "data": "PackingSlipNo", "title": "Packing Slip No.", "width": "150px" },
                        { "data": "TrackingNo", "title": "Tracking No.", "width": "150px" },
                        { "data": "Carrier", "title": "Carrier", "width": "80px" },
                        { "data": "ServiceTypeDescription", "title": "Service Type Desc.", "width": "150px" },
                        {
                            "data": "Amount", "title": "Amount", "width": "50px", "className": "text-right",
                            render: function (data, type, row) {

                                var val = COLUMN_FORMAT.formatNumberForZero(data);
                                return val;
                            }
                        },
                        { "data": "Currency", "title": "Currency", "width": "50px" },
                        { "data": "Weight", "title": "Weight", "width": "50px" },
                        { "data": "addressid", "title": "Address Id", "width": "90px" },
                        { "data": "AddressType", "title": "Address Type", "width": "100px" },
                        { "data": "Country", "title": "Country", "width": "50px" },
                        { "data": "LocationNo", "title": "Location No.", "width": "100px" },
                        { "data": "config", "title": "Configuration", "width": "50px" }

                    ]
                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(13).footer()).html(thousands_separators(api.column(13).data().sum()));
                        //$(api.column(8).footer()).html(thousands_separators(api.column(8).data().sum()));

                    }



                    ToggleDataList(true);
                    MakeDataGrid('lstSODetailedData', data.lstSODetailedData, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });


    }
</script>

