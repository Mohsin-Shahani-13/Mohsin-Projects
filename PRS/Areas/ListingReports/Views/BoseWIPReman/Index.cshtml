@model IP.Areas.ListingReports.Models.BoseWIPReman
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="row">
            <div class="col-md-10">
                <div class="box-header with-border bg-blue-gradient">
                    <button type="button" class="btn btn-box-tool">
                        @*title="Option Page" onclick="$('#option').modal('show');"*@
                        <span class="fa fa-list fa-lg white"></span>
                    </button>
                    <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
                    <div id="buttons" class="box-tools pull-right">
                    </div>
                </div>
                <div class="box-body" id="lstP">
                    <table id="lstBoseWIPReman" class="table table-bordered table-striped text-sm table-hover" width="100%">
                        <thead class="sorted-asc">
                            <tr>
                                <th></th>
                                <th class="notexport"></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th class="notexport"></th>
                                <th></th>
                            </tr>
                        </thead>
                        @*<tbody id="tblBody"></tbody>*@
                        <tfoot>
                            <tr>
                                <th>Total:</th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div id="left_panel_Bottom" class="col-md-2">
                <div id="left_bot_section" class="box panel panel-default leftsection" style="height:100%">
                    <h4>Click hyperlinks on left section to load Part No.</h4>
                </div>
            </div>
        </div>
    </div>
</div>
        <script>
            var COLUMN_FORMAT =
            {
                formatDecimal: function (data, type, row) {
                    var val = +data;
                    return val === 0 ? '' : thousands_separators(val.toFixed(4));
                },
                formatTwoDecimal: function (data, type, row) {
                    var val = +data;
                    return val === 0 ? '' : val.toFixed(2);
                },
                formatNumber: function (data, type, row) {
                    var val = +data;
                    return val === 0 ? '' : thousands_separators(val.toFixed(0));
                },

                formatNumberForZero: function (data, type, row) {
                    var val = +data;
                    return val === "0" ? '' : val.toFixed(0);
                },

            };

            ToggleDataList(false);
            LoadData();
            function LoadData() {

                $('#tblBody').empty();

                var isSingleRow = false;

                $.ajax({

                    cache: false,
                    type: 'GET',
                    url: '/BoseWIPReman/GetList',
                    data: {

                    },
                    datatype: JSON,
                    success: function (data) {
                        $('#filterString').append(data.filterString);

                        if (!isSingleRow) {
                            var columnDef = [
                                {
                                    "data": "Line", "title": "Line", "width": "200px",
                                    render: function (data, type, row) {

                                        var url = '<a href="#" class="Part_Undrln" onclick="OpenView(\'\\\\ListingReports\\\\BoseWIPReman\\\\GetUnits?ProgramID=' + row["ProgramID"] + '&Line=' + row["Line"] + '&CodeName=' + row["CodeName"] + '\',\'left_panel_Bottom\')">' + data + '</a>';
                                        return url;
                                    }
                                },
                                { "data": "ProgramID", "title": "ProgramID", "width": "200px", "visible": false },

                               
                                { "data": "CodeName", "title": "Code Name", "width": "140px" },
                                {
                                    "data": "REMAN", "title": "REMAN", "width": "80px", "className": "text-center",

                                    render: function (data, type, row) {

                                        var val = COLUMN_FORMAT.formatNumberForZero(data);
                                        return val;
                                    }
                                },
                                {
                                    "data": "FRESH", "title": "FRESH", "width": "80px", "className": "text-center",

                                    render: function (data, type, row) {

                                        var val = COLUMN_FORMAT.formatNumberForZero(data);
                                        return val;
                                    }
                                },
                                {
                                    "data": "WIP", "title": "WIP", "width": "80px", "className": "text-center",

                                    render: function (data, type, row) {

                                        var val = COLUMN_FORMAT.formatNumberForZero(data);
                                        return val;
                                    }
                                },
                                {
                                    "data": "HOLD", "title": "HOLD", "width": "80px", "className": "text-center",

                                    render: function (data, type, row) {

                                        var val = COLUMN_FORMAT.formatNumberForZero(data);
                                        return val;
                                    }
                                },
                                {
                                    "data": "PACKING", "title": "Packing", "width": "80px", "className": "text-center",

                                    render: function (data, type, row) {

                                        var val = COLUMN_FORMAT.formatNumberForZero(data);
                                        return val;
                                    }
                                },
                                {
                                    "data": "FGI", "title": "FGI", "width": "80px", "className": "text-center",

                                    render: function (data, type, row) {

                                        var val = COLUMN_FORMAT.formatNumberForZero(data);
                                        return val;
                                    }
                                },
                                {
                                    "data": "QTY", "title": "Qty", "width": "80px", "className": "text-center", "visible": false,

                                    render: function (data, type, row) {

                                        var val = COLUMN_FORMAT.formatNumberForZero(data);
                                        return val;
                                    }
                                },
                            ];
                            //For Displaying  Footer Sum
                            var footerfunc = function () {
                                var api = this.api();
                                $(api.column(3).footer()).html(thousands_separators(api.column(3).data().sum()));
                                $(api.column(4).footer()).html(thousands_separators(api.column(4).data().sum()));
                                $(api.column(5).footer()).html(thousands_separators(api.column(5).data().sum()));
                                $(api.column(6).footer()).html(thousands_separators(api.column(6).data().sum()));
                                $(api.column(7).footer()).html(thousands_separators(api.column(7).data().sum()));
                                $(api.column(8).footer()).html(thousands_separators(api.column(8).data().sum()));
                                $(api.column(9).footer()).html(thousands_separators(api.column(9).data().sum()));
                            }
                            ToggleDataList(true);

                            MakeDataGrid('lstBoseWIPReman', data.lstBoseWIPReman, 0, columnDef, true, true, footerfunc);
                        }
                        if (data["ErrorMessage"] != null) {
                            $('.dataTables_empty > p').text(data["ErrorMessage"]);
                        }
                    },
                    onerror: function (r) { r },
                    failure: function (r) { r }
                });
            }

        </script>



