@model IP.Areas.ListingReports.Models.GoProInventoryWeb
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container">
    <div id="dataList" class="box panel panel-default">

        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>

        <div class="box-body" id="lstP">
            <table id="lstGoProInventoryWeb" class="table table-bordered table-striped text-sm table-hover" width="100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th> </th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>

            </table>
        </div>
    </div>
</div>

<script>
    var COLUMN_FORMAT =
    {
        formatDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(4));
        },
        formatTwoDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(2);
        },
        formatNumber: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(0));
        },

        formatNumberForZero: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(0);
        },

    };

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var programId = '@Request.QueryString["programId"].ToString()';
        var programName = '@Request.QueryString["programName"].ToString()';

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/GoProInventoryWeb/GetList',
            data: {
                programId: programId,
                programName: programName
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);


                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "SnapshotDate", "title": "Snapshot Date", "width": "100px", "className": "text-right", "visible": false },
                        { "data": "ProgramID", "title": "Program Id", "width": "70px", "visible": false },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },

                        { "data": "PartDescription", "title": "Part Description" },
                        { "data": "PartTypeDescription", "title": "Part Type Desc.", "width": "120px" },
                        { "data": "LocationNo", "title": "Location No.", "width": "120px" },
                        { "data": "GoProLocation", "title": "GoPro Location", "width": "90px" },
                        {
                            "data": "Quantity", "title": "Qty", "width": "60px", "className": "text-right",
                            render: function (data, type, row) {

                                var val = COLUMN_FORMAT.formatNumber(data);
                                return val;
                            }
                        },
                        

                    ]

                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(8).footer()).html(thousands_separators(api.column(8, { search: 'applied' }).data().sum()));

                    }
                    ToggleDataList(true);
                    MakeDataGrid('lstGoProInventoryWeb', data.lstGoProInventoryWeb, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>
