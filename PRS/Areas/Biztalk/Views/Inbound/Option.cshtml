@model IP.Areas.Biztalk.Models.Inbound
@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        width: 180px;
    }
</style>
<table class="fullWidth">
    <tr>
        <td class="pad" colspan="4" id="RptType">
            <label>Report Type:</label>
            @Html.DropDownList("rptType", new List<SelectListItem>
                {

                   new SelectListItem{ Text="Summary", Value = "Summary" },
                   new SelectListItem{ Text="Detail", Value = "Detail" }

                }, new { @class = "form-control" })
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.contract, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddContract", null, new { id = "ddContract", @name = "ddContract", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>

    </tr>
    <tr>
        <td class="pad" id='ddtpFrom'>

            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad" id='ddtpTo'>
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
    </tr>
    @*<tr>
            <td colspan="4" class="pad" id="Lcustordertype">
                @Html.LabelFor(model => model.custordertype, new { @class = "col-4 col-form-label" })
                <input type="text" class="form-control" id="custordertype" name="custordertype" autofocus
                       onkeydown="GoOnEnter()" />
            </td>

        </tr>*@
    <tr>
        <td colspan="4" class="pad" id="LorderNo">
            @Html.LabelFor(model => model.orderNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="orderNo" name="orderNo" autofocus
                   onkeydown="GoOnEnter()" />
        </td>

    </tr>
    <tr>
        <td colspan="4" class="pad" id="LserialNo">
            @Html.LabelFor(model => model.serialNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="serialNo" name="serialNo" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr id="_lstInMsgType">
        <td class="pad" colspan="4">
            @Html.LabelFor(model => model.inMsgType, htmlAttributes: new { @class = "form-label" })
            <select id="lstInMsgType" multiple="multiple" class="multiselect form-control" name="options[]">
                @{
                    if (Model != null && Model.lstInMsgType != null)
                    {
                        foreach (var item in Model.lstInMsgType)
                        {
                            <option value="@item[0]">@item[0]</option>
                        }
                    }
                }
            </select>
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">

            <div>
                <label>
                    @Html.CheckBoxFor(model => model.ischecked, new { @class = "radio-option1", @id = "isFail", @onclick = "isFailEnableDate(this)" }) Failures
                </label>
            </div>
        </td>

    </tr>
    <tr>
        <td colspan="4" class="pad">
            <label>
                @Html.CheckBoxFor(model => model.ischecked, new { @class = "radio-option2", @id = "isSuccessed", @onclick = "isSuccessedEnableDate(this)" })  Successes
            </label>
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            <label>
                @Html.CheckBoxFor(model => model.ischecked, new { @class = "radio-option3", @id = "isUnprocessed", @onclick = "isUnprocessedDisableDate(this)" })  Unprocessed
            </label>
        </td>
    </tr>
</table>
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<script>

    selectedParts = '';

    $('#lstInMsgType').multiselect({
        includeSelectAllOption: true,
        selectAllText: 'All',
        buttonWidth: '100%',
        maxHeight: 300,
        enableFiltering: true,
        enableCaseInsensitiveFiltering: true,
        filterPlaceholder: 'Search',
        numberDisplayed: 4,
        templates: {
            ul: '<ul class="multiselect-container dropdown-menu" style="-ms-overflow-x: hidden; -ms-overflow-y: auto; max-height: 300px; width:100%;">"'
        },

        buttonText: function (options, select) {
            if (options.length == 0) {
                return 'select from list';
            }
            else {
                if (options.prevObject.length == options.length) {
                    selectedParts = 'All';
                } else {
                    selectedParts = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selectedParts += "'" + label + "', ";
                    });
                    selectedParts = selectedParts.substr(0, selectedParts.length - 2);
                }



                if (options.length > this.numberDisplayed) {
                    return options.length + ' ' + this.nSelectedText;
                }
                else {
                    var selected = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selected += label + ", ";
                    });
                    return selected.substr(0, selected.length - 2);
                }
            }
        }
    });


    $('#lstInMsgType').multiselect('selectAll', false);
    $("#lstInMsgType").multiselect('updateButtonText');
    $(document).ready(function () {

        $("#lstInMsgType").change(function () {
            $('#lblMsg').empty();
        });

        $("#ddContract").show();
        $("#ddtpFrom").hide();
        $("#ddtpTo").hide();
        $("#Lcustordertype").hide();
        $("#LorderNo").hide();
        $("#LserialNo").hide();
        $("#_lstInMsgType").hide();
        $("#isFail").show();
        $("#isSuccessed").show();
        $("#isUnprocessed").show();
        $("#rptType").change(function () {
            var rptName = document.getElementById("rptType").value;
            if (rptName === "Summary") {

                $("#ddContract").show();
                $("#ddtpFrom").hide();
                $("#ddtpTo").hide();
                $("#Lcustordertype").hide();
                $("#LorderNo").hide();
                $("#LserialNo").hide();
                $("#_lstInMsgType").hide();
                $("#isSuccessed").show();
                $("#isUnprocessed").show();
                $('input[Id="isFail"]').not(this).prop('checked', false);
                $('input[Id="isSuccessed"]').not(this).prop('checked', false);
                $('input[Id="isUnprocessed"]').not(this).prop('checked', false);
            }
            else {
                $("#ddContract").show();
                $("#ddtpFrom").show();
                $("#ddtpTo").show();
                $("#Lcustordertype").show();
                $("#LorderNo").show();
                $("#LserialNo").show();
                $("#_lstInMsgType").show();
                $("#isSuccessed").show();
                $("#isUnprocessed").show();
                $('input[Id="isFail"]').not(this).prop('checked', false);
                $('input[Id="isSuccessed"]').not(this).prop('checked', false);
                $('input[Id="isUnprocessed"]').not(this).prop('checked', false);
                document.getElementById("fromDt").disabled = false;
                document.getElementById("toDt").disabled = false;
               
            }

            //$("#selected_state").children().show(); //only show cities in selected state
        });
    });

    $('input[Id="isFail"]').on('change', function () {
        $('input[Id="isSuccessed"]').not(this).prop('checked', false);
        $('input[Id="isUnprocessed"]').not(this).prop('checked', false);
    });

    $('input[Id="isSuccessed"]').on('change', function () {
        $('input[Id="isFail"]').not(this).prop('checked', false);
        $('input[Id="isUnprocessed"]').not(this).prop('checked', false);
    });

    $('input[Id="isUnprocessed"]').on('change', function () {
        $('input[Id="isFail"]').not(this).prop('checked', false);
        $('input[Id="isSuccessed"]').not(this).prop('checked', false);
    });

    $('#option').on('shown.bs.modal', function () {
        $('#custordertype').focus();
    });

    $(document).ready(function () {

        $("#ddContract").change(function () {
            $("#orderNo").val("");
            $("#serialNo").val("");
            $('#lblMsg').empty();
        });
        $("#orderNo").change(function () {
            $('#lblMsg').empty();
        });

      
       
    });


    function isUnprocessedDisableDate(isUnprocessed) {

        var isUnprocessed = $('#isUnprocessed').is(':checked')

        if (isUnprocessed === true) {
            document.getElementById("fromDt").disabled = isUnprocessed;
            var nodes1 = document.getElementById("fromDt").getElementsByTagName('*');
            document.getElementById("toDt").disabled = isUnprocessed;
            var nodes1 = document.getElementById("toDt").getElementsByTagName('*');
            for (var i = 0; i < nodes1.length; i++) {
                nodes1[i].disabled = isUnprocessed;
            }
        }
        else if (isUnprocessed === false) {
            document.getElementById("fromDt").disabled = isUnprocessed;
            var nodes1 = document.getElementById("fromDt").getElementsByTagName('*');
            document.getElementById("toDt").disabled = isUnprocessed;
            var nodes1 = document.getElementById("toDt").getElementsByTagName('*');
            for (var i = 0; i < nodes1.length; i++) {
                nodes1[i].disabled = isUnprocessed;
            }
        }

    };

    function isFailEnableDate(isFail) {

        var isFail = $('#isFail').is(':checked')

        if (isFail === true) {
            document.getElementById("fromDt").disabled = false;
            var nodes1 = document.getElementById("fromDt").getElementsByTagName('*');
            document.getElementById("toDt").disabled = false;
            var nodes1 = document.getElementById("toDt").getElementsByTagName('*');
            for (var i = 0; i < nodes1.length; i++) {
                nodes1[i].disabled = isFail;
            }
        }
    };

    function isSuccessedEnableDate(isSuccessed) {

        var isSuccessed = $('#isSuccessed').is(':checked')

        if (isSuccessed === true) {
            document.getElementById("fromDt").disabled = false;
            var nodes1 = document.getElementById("fromDt").getElementsByTagName('*');
            document.getElementById("toDt").disabled = false;
            var nodes1 = document.getElementById("toDt").getElementsByTagName('*');
            for (var i = 0; i < nodes1.length; i++) {
                nodes1[i].disabled = isSuccessed;
            }
        }

    };

    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }

    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });

  

    //function OptionsIsValid() {

    //    $('#lblMsg').empty();
    //        if ($('#orderNo').val().length < 5) {
    //            $('#orderNo').focus();
    //        $('#lblMsg').append('Enter atleast 5 characters for customer order no.');
    //        return false;
    //        }
    //    else {
    //        $('#lblMsg').empty();
    //        return true;
    //    }
    //}

    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 2);

        //var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-180d',
        endDate: maxDate,
        readonlyDatepicker: true



    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }
    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();

        var MessageType = $('#lstInMsgType option:selected').text();
        if (MessageType == "") {
            $('#lblMsg').append('Please select Message Type from list');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;

            if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
                $('#lblMsg').append('Enter a valid date');
                return false;
            }
            else {
                $('#lblMsg').empty();
                return true;
            }
            if (MessageType == null) {
                $('#lblMsg').empty();
                $('#lblMsg').append('Something went wrong! Reopen Option Page');
                return false;
            }
            if (MessageType == 'No Data Available') {
                $('#lblMsg').empty();
                $('#lblMsg').append('Select message type ');
                return false;
            }

            else {
                $('#lblMsg').empty();
                return true;
            }


        }

        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }
    }

    function Go() {
        var rptName = $("#rptType option:selected").val();
        var contract = $('#ddContract option:selected').val();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        //var custordertype = $('#custordertype').val();
        var orderNo = $('#orderNo').val();
        var serialNo = $('#serialNo').val();
        var InMsgType = $('#lstInMsgType option:selected').text();
        var isFail = $('.radio-option1:checked').val();
        var isSuccessed = $('.radio-option2:checked').val();
        var isUnprocessed = $('.radio-option3:checked').val();
        $('#option').modal('hide');
        
        if (rptName == "Summary")
        {
            OpenPage('\\Biztalk\\Inbound\\GetSummary?contract=' + contract + '&isFail=' + isFail + '&isSuccessed=' + isSuccessed + '&isUnprocessed=' + isUnprocessed + '&Option=' + 'op' + '&type=' + rptName + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
        }
        else
        {
            OpenPage('\\Biztalk\\Inbound\\Index?contract=' + contract + '&orderNo=' + orderNo + '&serialNo=' + serialNo + '&frmDt='+ fDate + ' &toDate=' + tDate + ' &InMsgType=' + InMsgType + '&isFail=' + isFail + '&frmDt=' + '&isSuccessed=' + isSuccessed + '&isUnprocessed=' + isUnprocessed  + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
        }
    }
</script>
