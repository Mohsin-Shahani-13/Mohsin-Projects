@{
    if (Layout == null)
    {
        <script type="text/javascript">

            var COLUMN_FORMAT =
            {
                formatDecimal: function (data, type, row) {
                    var val = +data;
                    return val === 0 ? '' : thousands_separators(val.toFixed(4));
                },
                formatTwoDecimal: function (data, type, row) {
                    var val = +data;
                    return val === 0 ? '' : val.toFixed(2);
                },
                formatNumber: function (data, type, row) {
                    var val = +data;
                    return val === 0 ? '' : thousands_separators(val.toFixed(0));
                },

                formatNumberForZero: function (data, type, row) {
                    var val = +data;
                    return val === 0 ? '' : val.toFixed(0);
                },

            };

                $('#button').empty();
                var qrytool = '<a id="showQuery" class="btn-header btn-box-tool" href="\\SqlDocs\\Index?rptCode=024' + '&rptTitle=Inbound Detail' + '&isDetail=Y' + '" title="How they do that" target="_blank">';
                qrytool += '<span class="fa-stack sqlDoc" ><i class="fa fa-circle fa-stack-2x" style="color: rgb(221, 75, 57);"></i><i class="fa fa-database fa-stack-1x" style="color: white;"></i></span>';
                qrytool += '</a>';
            $('#button').append(qrytool);

            //For Header Attribute
            $('#HeadAtt').click(function () {

                $('#Optionitem').modal('show')

            });

                    $(document).ready(function () {
                        $('#HeadAtt').click(function () {
                            var hdrId = '@Request.QueryString["hdrId"]'
                            $('#Optionitem').modal('show');

                            $.ajax({

                                cache: false,
                                type: 'GET',
                                url: '/Inbound/GetAttribute',
                                data: {
                                    hdrId: hdrId
                                },
                                datatype: JSON,
                                success: function (data) {
                                    $('#filterString').append(data.filterString);


                                    var columnDef = [

                                        { "data": "ID", "title": "ID", "width": "80px", "visible": false },
                                        { "data": "Message_Type", "title": "Msg. Type", "width": "150px"},
                                        { "data": "Field_Name", "title": "Field Name", "width": "200px" },
                                        { "data": "Value", "title": "Value" }

                                    ]


                                    ToggleDataList(true);
                                    MakeFrameGrid('lstattribute', data.lstattribute, 400, columnDef, true, false, false);

                                    if (data["ErrorMessage"] != null) {
                                        $('.dataTables_empty > p').text(data["ErrorMessage"]);
                                    }
                                },
                                onerror: function (r) { r },
                                failure: function (r) { r }
                            });


                        });

                         //For Line Attribute
                        $('#HeadAttLine').click(function () {

                        $('#Optionitem1').modal('show')

                         });

                    $(document).ready(function () {
                        $('#HeadAttLine').click(function () {
                            var hdrId = '@Request.QueryString["hdrId"]'
