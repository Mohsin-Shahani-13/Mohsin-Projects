    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');

        var contract = $("#ddContract option:selected").val();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        //var custordertype = $('#custordertype').val();
        var orderNo = $('#orderNo').val();
        var serialNo = $('#serialNo').val();
        var InMsgType = $('#lstInMsgType option:selected').text();
        var isFail = $('.radio-option1:checked').val();
        var isSuccessed = $('.radio-option2:checked').val();
        var isUnprocessed = $('.radio-option3:checked').val();

        var InMsgType = '';
        if (selectedParts == "All") {
            InMsgType = "All";
        }
        else {
            $('#lstInMsgType :selected').each(function (i, sel) {
                
                if (i == 0) {
                    InMsgType = "'" + ($(sel).val()) + "'";
                    InMsgType = "'" + ($(sel).text()) + "'";
                }
                else {
                    InMsgType += "," + "'" + ($(sel).val()) + "'";
                    //OutMsgType = "Multiple";
                }
            });
        }

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/Inbound/GetList',
            data: {
                contract: contract,
                frmDt: fDate,
                toDt: tDate,
                orderNo: orderNo,
                InMsgType: InMsgType,
                isFail: isFail,
                isSuccessed: isSuccessed,
                isUnprocessed: isUnprocessed,
                serialNo: serialNo
                
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);


                var columnDef = [
