                        render: function (data, type, row) {
                            var url = '<a href= "\\Biztalk\\Inbound\\Detail?hdrId=' + row["Inmessage_Hdr_Id"] + '&page=list" target=_blank > ' + data + '</a>';
                            return url;
                        }
