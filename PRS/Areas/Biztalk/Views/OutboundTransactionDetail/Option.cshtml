@model IP.Areas.Biztalk.Models.OutboundTransactionDetail
@{
    ViewBag.Title = "Option";
    Layout = null;
}
<style>
    .pad {
        width: 180px;
    }
</style>
<table class="fullWidth">
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.ProgramId, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddContract", null, new { id = "ddContract", @name = "ddContract", @class = "form-control", @onkeydown = "GoOnEnter()", onchange = "GetContract()" })
        </td>

    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.MsgType, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @*     @Html.DropDownList("ddMessageType", null, new { id = "ddMessageType", @name = "ddMessageType", @class = "form-control", @onkeydown = "GoOnEnter()" })*@
            <select id="ddMessageType" name="ddMessageType" class="form-control dropdownHeight" onkeydown="GoOnEnter()"> </select>
        </td>
    </tr>
    <tr>
        <td class="pad" id='ddtpFrom'>

            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad" id='ddtpTo'>
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
    </tr>



</table>
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<script>
    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

  
    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 1);

        var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-180d',
        endDate: maxDate,
        readonlyDatepicker: true



    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    GetContract();
    function GetContract() {
        var contract = document.getElementById("ddContract").value;

        $.ajax({
            cache: false,
            type: 'GET',
            url: '/OutboundTransactionDetail/GetMessageType',
            data:
            {
                contract: contract
            },

            datatype: JSON,
            success: function (data) {

                $('#ddMessageType').html('');
                var options = '';
                options += '<option value="All">All</option>';
                for (var i = 0; i < data.lstMessageType.length; i++) {
                    options += '<option value="' + data.lstMessageType[i] + '">' + data.lstMessageType[i] + '</option>';
                }
                $('#ddMessageType').append(options);
            },
            onerror: function (r) { r },
            failure: function (r) { r }

        });

    }

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();

        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }
        }
     
    function Go() {
       
        var rptName = $("#rptType option:selected").val();
        var contract = $('#ddContract option:selected').val();
        var MsgType = $('#ddMessageType option:selected').val();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
     
        $('#option').modal('hide');

         {
            OpenPage('\\Biztalk\\OutboundTransactionDetail\\Index?contract=' + contract + '&MessagType=' + MsgType + '&frmDt=' + fDate + ' &toDate=' + tDate + '&type=' + rptName + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
        }
    }
</script>


