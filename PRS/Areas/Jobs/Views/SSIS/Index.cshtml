                        { "data": "JobStatus", "title": "Enabled", "width": "90px", "className": "text-center" },
                        {
                            "data": "retry_attempts", "title": "Retry Attempts", "width": "100px", "className": "text-right",
                            render: function (data, type, row) {

                                var val = COLUMN_FORMAT.formatNumberForZero(data);
                                return val;
                            }
                        },
                        {
                            "data": "retry_interval", "title": "Retry Interval", "width": "100px", "className": "text-right",
                            render: function (data, type, row) {

                                var val = COLUMN_FORMAT.formatNumberForZero(data);
                                return val;
                            }
                        },
                        { "data": "Notify", "title": "Notify", "width": "150px" },
                        { "data": "notifyOperator", "title": "Notify Operator", "width": "110px", "render": $.fn.dataTable.render.ellipsisAdr1(20)},
                        { "data": "notifyOperator", "title": "Notify Operator", "width": "110px", "visible": false },
                        { "data": "command", "title": "Command", "width": "110px", "render": $.fn.dataTable.render.ellipsisAdr3(20) },
                        { "data": "command", "title": "Command", "width": "110px", "visible": false },
                    ]
                    //For Displaying  Footer Sum
                    //var footerfunc = function () {
                    //    var api = this.api();
                    //    $(api.column(8).footer()).html(thousands_separators(api.column(8).data().sum()));
                    //}

                    ToggleDataList(true);
                    MakeDataGrid('lstSSIS', data.lstSSIS, 0 , columnDef, true, true);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
