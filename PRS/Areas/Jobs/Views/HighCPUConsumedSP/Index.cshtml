@model IP.Areas.Jobs.Models.HighCPUConsumedSP
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<style>

    textarea {
        resize: none !important;
    }

</style>
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <input id="rptcode" type="hidden" value="021" />
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle >  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right" style="margin-top:2PX;">
            </div>
        </div>
        <div class="box-body text-sm">
            <table id="lstSP" class="table table-bordered table-striped text-sm table-hover" style="width:100%;">
                <thead class="sorted-asc">
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th class="notexport"></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>

                        <th></th>
                        <th class="notexport"></th>
                       
                        @*<th></th>*@

                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
            </table>
        </div>

        @*<div class="row section-color">
                <div id="left_panel_Bottom" class="col-md-12 section-padding">
                    <div id="leftsection" class="box panel panel-default leftsection" style="text-align: center;  height:54%; background-color: white; padding-top: 90px;">
                        <h4>Click hyperlinks on above section to load data</h4>
                    </div>
                </div>
            </div>*@
    </div>

</div>
<script>
    function showModalForZPL(head, str) {
        $('#commentsheader').html(head);
        $('#commentsbody').html('<textarea rows="15" cols="78" name="usrtxt" wrap="hard"> "' + str + '" </textarea > ');
        $('#comments').modal('show');
    }
    $.fn.dataTable.render.ellipsisAdr3 = function (cutoff) {
        return function (data, type, row) {
            if (type === 'display') {
                var str = data.toString().replace(/(\r\n|\n|\r|%|;|'|\/|"|=|<|>)/gm, "");
               // var str = data.toString();
                var header = "SP Script";
                return str.length < cutoff ?
                    str :
                    str.substr(0, cutoff - 1) + '<a href="#" onclick="showModalForZPL(\'' + header + '\', \'' + str + '\')"> See More</a>';
                str += "'";
            }
            // Search, order and type can use the original data
            return data;
        };
    };
    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();
        var server = $('#ddlServers option:selected').text();
        var ProcName = $('#ProcName').val();

        $('#option').modal('hide');
        var isSingleRow = false;

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/HighCPUConsumedSP/GetList',
            datatype: JSON,
            data: {
                server: server,
                ProcName: ProcName
            },
            success: function (data) {
                //console.log(data.listOfLists)
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "server_name", "title": "Server Name", "width": "30px" },
                        { "data": "db_name", "title": "Database Name", "width": "100px" },
                        { "data": "sp_name", "title": "SP Name", /*"width": "40px" */},
                        { "data": "sp_script", "title": "SP Script", /*"width": "140px",*/ "render": $.fn.dataTable.render.ellipsisAdr3(30)  },
                        { "data": "sp_script", "title": "SP Script", /*"width": "140px",*/ "visible": false },
                        { "data": "last_execution_time", "title": "Last Execution Time", "width": "120px", "className": "text-right" },
                        { "data": "last_cpu_time(min)", "title": "Last CPU Time(Min)", "width": "120px", "className": "text-right" },
                        { "data": "last_elapsed_time(min)", "title": "Last Elapsed Time(Min)", "width": "130px", "className": "text-right" },
                        { "data": "execution_count", "title": "Execution Count", "width": "100px", "className": "text-right"},
                        {
                            "data": "query_plan", "title": "Query Plan", "width": "100px" , "visible": false,
                            render: function (data, row, type) {
                                
                                var xmlString = data.toString();

                                var url = '<a href="ssms://?openSqlPlan=' + encodeURIComponent(xmlString) + '">Click to show in XML editor</a>';

                                return url;
                            }
                        }
                    ]
                    //For Displaying  Footer Sum
                    //var footerfunc = function () {
                    //    var api = this.api();
                    //    $(api.column(8).footer()).html(thousands_separators(api.column(8).data().sum()));
                    //}

                    ToggleDataList(true);
                    MakeDataGrid('lstSP', data.listOfLists, 0 , columnDef, true, true);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>



