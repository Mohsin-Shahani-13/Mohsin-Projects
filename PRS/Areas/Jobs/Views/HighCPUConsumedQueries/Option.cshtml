@model IP.Areas.Jobs.Models.HighCPUConsumedQueries
@{
    ViewBag.Title = "Option";
    Layout = null;
}
<style>
    .pad {
        width: 180px;
    }
</style>
<table class="fullWidth">
    <tr>
        <td colspan="2" class="pad">
            @Html.LabelFor(model => model.ServerNames, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddlServers", null, new { id = "ddlServers", @name = "ddlServers", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.Count, new { @class = "col-1 col-form-label" })
            @Html.DropDownListFor(model => model.Count,
                                            new List<SelectListItem>
                                            {
                                            new SelectListItem { Text="All", Value="All" , Selected= true},
                                            new SelectListItem {  Text= "1-10", Value = "1-10"},
                                            new SelectListItem {  Text= "10-50", Value = "10-50"},
                                            new SelectListItem { Text="50-100", Value="50-100"},
                                            new SelectListItem { Text="100-200", Value="100-200"},
                                            new SelectListItem { Text="200-400", Value="200-400"},
                                            new SelectListItem { Text="above 400", Value="401"}},
                                            htmlAttributes: new { @class = "form-control" })

    </tr>
</table>
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<script>
    $('#option').on('shown.bs.modal', function () {
        $('#building').focus();
    });

    function GoOnEnter() {
        if (event.keyCode == 13) {
            Go();
        }
    }
    $('#btnGo').click(function () {
        Go();
    });

    function Go() {
        var server = $('#ddlServers option:selected').text();
        var count = $('#Count option:selected').val();
        $('#option').modal('hide');
        OpenPage('\\Jobs\\HighCPUConsumedQueries\\Index?server=' + server + '&count=' + count + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>

