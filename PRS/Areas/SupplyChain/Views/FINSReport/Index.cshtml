@model IP.Areas.SupplyChain.Models.FINSReport
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">

        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>

        <div class="box-body" id="lstP">
            <table id="lstFinsReport" class="table table-bordered table-striped text-sm table-hover" width="100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
               
                        <th></th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var programId = $('#ProgramID').val();
        var ProgramName = $("#ProgramID option:selected").text();
        var SerialNo = $('#SerialNo').val();
        var PartNo = $('#PartNo').val();
        var CustRef = $('#CustRef').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/FINSReport/GetList',
            data: {
                frmDt: fDate,
                toDate: tDate,
                programId: programId,
                ProgramName: ProgramName,
                SerialNo: SerialNo,
                PartNo: PartNo,
                CustRef: CustRef
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);


                if (!isSingleRow) {
                    var columnDef = [                        
                        { "data": "ProgramID", "title": "Program ID", "width": "100px", "visible": false },
                        {
                            "data": "ORDER_NO", "title": "Order No.", "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\RO\\Detail?Id=' + row["OrderHeaderID"] + '&custRef=' + row["ORDER_NO"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                    return url;
                            }
                        },
                        {
                            "data": "SERIAL", "title": "Serial No.",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SERIAL"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["SKU"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SKU", "title": "SKU", "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["SKU"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "PartTransaction", "title": "Part Trans.", "width": "100px" },
                        { "data": "qty", "title": "Qty", "width": "60px", "className": "text-right" },
                        { "data": "Configuration", "title": "Config.", "width": "80px", "className": "text-center" },
                        { "data": "FROM_LOCATION", "title": "From Loc.", "width": "150px" },
                        { "data": "TO_LOCATION", "title": "To Loc.", "width": "150px" },
                        { "data": "TRANSACTION_DATETIME", "title": "Trans. DateTime", "width": "100px", "className": "text-right" },
                        { "data": "SHIPMENT_TRACKING_NO", "title": "Ship. Tracking No.", "width": "150px" },
                        { "data": "SHIPMENT_STATUS", "title": "Ship. Status", "width": "150px" },
                        
                    ]
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(5).footer()).html(thousands_separators(api.column(5, { search: 'applied' }).data().sum()));

                    }

                    ToggleDataList(true);
                    MakeDataGrid('lstFinsReport', data.lstFinsReport, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>
