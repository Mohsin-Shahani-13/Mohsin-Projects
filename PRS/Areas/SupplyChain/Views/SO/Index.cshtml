@model IP.Areas.SupplyChain.Models.SO
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            @{
                if (ViewBag.Option == "op")
                {
                    <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                        <span class="fa fa-filter fa-lg white"></span>
                    </button>
                    <input id="rptCode" type="hidden" value="006" />
                }
                else
                {
                    <button type="button" id="opp" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                        <span class="fa fa-filter fa-lg white"></span>
                    </button>
                    <input id="rptCode" type="hidden" value="006" />
                    <input id="rptTitle" type="hidden" value="@ViewBag.ReportTitle" />

                }
            }
            <h6 class="box-title"><strong>@ViewBag.ReportTitle Summary > </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>

        <div class="box-body" id="lstP" style="height:88%">
            <table id="lstSO" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                   
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>

            </table>
        </div>

    </div>
</div>

<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();
        //$('#lstSO').DataTable().clear();
        //$('#lstSO').DataTable().destroy();

        $('#option').modal('hide');
        var isSingleRow = false;
       var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var custRef = $('#custRef').val();
      

      
        
        


        $.ajax({

            cache: false,
            type: 'GET',
            url: '/SO/GetSO',
            data: {
                frmDt: fDate,
                toDate: tDate,
                custRef: custRef,
                type:"@ViewBag.ReportTitle1"
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);
                //$('#lstSO').DataTable().clear();
                //$('#lstSO').DataTable().destroy();

                var columnDef = [
                      
                        { "data": "ID", "title": "ID", "width": "40px" },
                        {
                            "data": "CustomerReference", "title": "Customer Ref.", "width": "120px"
                           
                        },

                    { "data": "ThirdPartyReference", "title": "Third Party Ref.", "width": "90px" },
                    { "data": "ProgramID", "title": "ProgramID", "width": "40px" },
                    
                    { "data": "AddressID", "title": "AddressID"},
                    { "data": "StatusID", "title": "StatusID", "width": "70px" },
                    { "data": "BizTalkID", "title": "BizTalkID", "width": "50px" },
                    { "data": "UserID", "title": "UserID", "width": "50px" },
                    {
                            "data": "CreateDate", "title": "Created On", "width": "90px", "className": "text-right",

                        },
                        {
                            "data": "LastActivityDate", "title": "Last Activity On", "width": "90px", "className": "text-right",

                        }
                    ]



                    ToggleDataList(true);
               
                MakeDataGrid('lstSO', data.lstSO, 0, columnDef, true, true, false);

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });


    }
    $(document).ready(function () {

        $("#opp").click(function () {

            Navigate('option', '\\SupplyChain\\SO\\Option', '006', 'Sales Orders', 'Specd by: Abbas Arsiwala @@ Reconext &amp; Designed by: Fasihullah khan @@ WinIT', 'mailto:kashif@winit.biz?cc=mohsin@winit.biz;Tahir@winit.biz&amp;subject=Sales Order - Detail Report');

        });

    });
</script>
