@model IP.Areas.SupplyChain.Models.SO
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            @{
                if (ViewBag.Option == "op")
                {
                    <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                        <span class="fa fa-filter fa-lg white"></span>
                    </button>
                    <input id="rptCode" type="hidden" value="006" />
                }
                else
                {
                    <button type="button" id="opp" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                        <span class="fa fa-filter fa-lg white"></span>
                    </button>
                    <input id="rptCode" type="hidden" value="006" />
                    <input id="rptTitle" type="hidden" value="@ViewBag.ReportTitle" />

                }
            }
            <h6 class="box-title"><strong>@ViewBag.ReportTitle Summary > </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>

        <div class="box-body" id="lstP" style="height:88%">
            <table id="lstSO" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                   
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>

            </table>
        </div>

    </div>
</div>

<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();
        //$('#lstSO').DataTable().clear();
        //$('#lstSO').DataTable().destroy();

        $('#option').modal('hide');
        var isSingleRow = false;
       var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var custRef = $('#custRef').val();
        //var isAllDate = $('#isAllDate').is(':checked');
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();

        //var program = $('#ddlProgram option:selected').text();
        //var programId = $('#ddlProgram option:selected').val();
        var status = '@Request.QueryString["status"].ToString()';

        var statusId = '@Request.QueryString["statusId"].ToString()';

        //For Multiple Status
        
        var routeLoc = '@ViewBag.Option';
        if (routeLoc == "op") {
            if (selectedParts == "All") {
                status = "All";
                statusId = ""
            }
            else {
                $('#lstStatus :selected').each(function (i, sel) {
                    if (i == 0) {
                        statusId = "'" + ($(sel).val()) + "'";
                        status = ($(sel).text());
                    }
                    else {
                        statusId += "," + "'" + ($(sel).val()) + "'";
                        status = "Multiple";
                    }
                });
            }
        }


        $.ajax({

            cache: false,
            type: 'GET',
            url: '/SO/GetSO',
            data: {
                frmDt: fDate,
                toDate: tDate,
                custRef: custRef,
                //isAllDate: isAllDate,
                //program: program,
                //programId: programId,
                programId: _programId,
                ProgramName: _ProgramName,
                statusId: statusId,
                status: status,
                type:"@ViewBag.ReportTitle1"
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);
                //$('#lstSO').DataTable().clear();
                //$('#lstSO').DataTable().destroy();

                var columnDef = [
                        { "data": "ProgramID", "title": "ProgramID", "width": "40px", "visible": false },
                        { "data": "Program", "title": "Program", "width": "50px" },
                        { "data": "ID", "title": "ID", "width": "40px", "visible": false },
                        {
                            "data": "CustomerReference", "title": "Customer Ref.", "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\SO\\Detail?SOHeaderId=' + row["ID"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "ThirdPartyReference", "title": "Third Party Ref.", "width": "90px" },
                        { "data": "Status", "title": "Status", "width": "120px" },
                        {
                            "data": "TrackingNo", "title": "Tracking No.", "width": "90px",
                            render: function (data, type, row) {
                                return data;
                            }
                        },
                        { "data": "Address", "title": "Address"},
                        { "data": "City", "title": "City", "width": "70px" },
                        { "data": "State", "title": "State", "width": "50px" },
                        { "data": "Country", "title": "Country", "width": "50px" },
                         { "data": "Zip", "title": "Zip Code", "width": "80px" },
                         { "data": "Value", "title": "Cust. Order Type", "width": "110px" },
                        { "data": "QtyToShip", "title": "To Ship", "width": "50px", "className": "text-right" },
                        { "data": "QtyShipped", "title": "Shipped", "width": "50px", "className": "text-right" },
                        { "data": "Username", "title": "Created By", "width": "100px" },
                        {
                            "data": "CreateDate", "title": "Created On", "width": "90px", "className": "text-right",

                        },
                        {
                            "data": "LastActivityDate", "title": "Last Activity On", "width": "90px", "className": "text-right",

                        }
                    ]



                    ToggleDataList(true);
                //For Displaying  Footer Sum
                var footerfunc = function () {
                    var api = this.api();
                    $(api.column(13).footer()).html(thousands_separators(api.column(13, { search: 'applied' }).data().sum()));
                    $(api.column(14).footer()).html(thousands_separators(api.column(14, { search: 'applied' }).data().sum()));

                }
                MakeDataGrid('lstSO', data.lstSO, 0, columnDef, true, true, footerfunc);

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });


    }
    $(document).ready(function () {

        $("#opp").click(function () {

            Navigate('option', '\\SupplyChain\\SO\\Option', '006', 'Sales Orders', 'Specd by: Abbas Arsiwala @@ Reconext &amp; Designed by: Fasihullah khan @@ WinIT', 'mailto:kashif@winit.biz?cc=mohsin@winit.biz;Tahir@winit.biz&amp;subject=Sales Order - Detail Report');

        });

    });
</script>
