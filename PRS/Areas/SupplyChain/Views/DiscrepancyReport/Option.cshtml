@model IP.Areas.SupplyChain.Models.DiscrepancyReport
@{
    ViewBag.Title = "Option";
    Layout = null;
}


<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">
            @Html.Action("GetProgramBySite", "Home", new { id = "ProgramID", @name = "ProgramID", area = "" })
        </td>
    </tr>

    <tr>
        <td class="pad">
            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.custRef, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="custRef" name="custRef" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td class="pad" colspan="4">
            @Html.LabelFor(model => model.status, htmlAttributes: new { @class = "col-4 col-form-lable" })
            <select id="lstStatus" multiple="multiple" class="multiselect form-control" name="options[]">
                @{
                    if (Model != null)
                    {
                        foreach (var item in Model.lstStatus)
                        {
                            <option value="@item[0]">@item[0]</option>
                        }
                    }
                }
            </select>
        </td>
    </tr>
    <tr>
        <td class="pad" colspan="4">
            @Html.LabelFor(model => model.type, htmlAttributes: new { @class = "col-4 col-form-lable" })
            <select id="lstType" multiple="multiple" class="multiselect form-control" name="options[]">
                @{
                    if (Model != null)
                    {
                        foreach (var item in Model.lstType)
                        {
                            <option value="@item[0]">@item[0]</option>
                        }
                    }
                }
            </select>
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.assignedTo, new { @class = "col-4 col-form-label" })
            @Html.DropDownList("ddlassignedTo", null, new { id = "ddlassignedTo", @name = "ddlassignedTo", @class = "form-control", value = 1, @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            <div>
                <label>
                    @Html.CheckBoxFor(model => model.OpenWO, new { @id = "OpenWO", @class = "form-check-input", @onclick = "EnableDisableAllDate(this)" }) Open Cases
                </label>
            </div>
        </td>
    </tr>
</table>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
<script>
    var selectedPartsOne = '';
    var selectedParts = '';

    $('#lstStatus').multiselect({
        includeSelectAllOption: true,
        selectAllText: 'All',
        buttonWidth: '100%',
        maxHeight: 300,
        enableFiltering: true,
        enableCaseInsensitiveFiltering: true,
        filterPlaceholder: 'Search',
        numberDisplayed: 1,
        templates: {
            ul: '<ul class="multiselect-container dropdown-menu" style="-ms-overflow-x: hidden; -ms-overflow-y: auto; max-height: 300px; width:100%;">"'
        },

        buttonText: function (options, select) {
            if (options.length == 0) {
                return 'select from list';
            }
            else {
                if (options.prevObject.length == options.length) {
                    selectedPartsOne = 'All';
                } else {
                    selectedPartsOne = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selectedPartsOne += "'" + label + "', ";
                    });
                    selectedPartsOne = selectedPartsOne.substr(0, selectedPartsOne.length - 2);
                }



                if (options.length > this.numberDisplayed) {
                    return options.length + ' ' + this.nSelectedText;
                }
                else {
                    var selected = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selected += label + ", ";
                    });
                    return selected.substr(0, selected.length - 2);
                }
            }
        }
    });

    $('#lstStatus').multiselect('selectAll', false);
    $("#lstStatus").multiselect('updateButtonText');


    $('#lstType').multiselect({
        includeSelectAllOption: true,
        selectAllText: 'All',
        buttonWidth: '100%',
        maxHeight: 300,
        enableFiltering: true,
        enableCaseInsensitiveFiltering: true,
        filterPlaceholder: 'Search',
        numberDisplayed: 1,
        templates: {
            ul: '<ul class="multiselect-container dropdown-menu" style="-ms-overflow-x: hidden; -ms-overflow-y: auto; max-height: 300px; width:100%;">"'
        },

        buttonText: function (options, select) {
            if (options.length == 0) {
                return 'select from list';
            }
            else {
                if (options.prevObject.length == options.length) {
                    selectedParts = 'All';
                } else {
                    selectedParts = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selectedParts += "'" + label + "', ";
                    });
                    selectedParts = selectedParts.substr(0, selectedParts.length - 2);
                }



                if (options.length > this.numberDisplayed) {
                    return options.length + ' ' + this.nSelectedText;
                }
                else {
                    var selected = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selected += label + ", ";
                    });
                    return selected.substr(0, selected.length - 2);
                }
            }
        }
    });

    $('#lstType').multiselect('selectAll', false);
    $("#lstType").multiselect('updateButtonText');

    function EnableDisableAllDate(OpenWork) {

        var OpenWork = $('#OpenWO').is(':checked')

        if (OpenWork === true) {
          
            $('#lstStatus').multiselect("deselectAll", false);
            $('#lstStatus').multiselect("updateButtonText");
            $("#lstStatus").multiselect("disable");

            document.getElementById("fromDt").disabled = true;
            var nodes1 = document.getElementById("fromDt").getElementsByTagName('*');
            document.getElementById("toDt").disabled = true;
            var nodes1 = document.getElementById("toDt").getElementsByTagName('*');
            for (var i = 0; i < nodes1.length; i++) {
                nodes1[i].disabled = true;
            }
        }
        else if (OpenWork === false) {
            //for status repair
            $("#lstStatus").multiselect("enable");
            $('#lstStatus').multiselect('selectAll', false);
            $('#lstStatus').multiselect('updateButtonText');

            document.getElementById("fromDt").disabled = false;
            var nodes1 = document.getElementById("fromDt").getElementsByTagName('*');
            document.getElementById("toDt").disabled = false;
            var nodes1 = document.getElementById("toDt").getElementsByTagName('*');
            for (var i = 0; i < nodes1.length; i++) {
                nodes1[i].disabled = false;
            }
        }
    };

    $('#option').on('shown.bs.modal', function () {
        $('#custRef').focus();
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 1);

        //var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-365d',
        endDate: maxDate
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var status = $('#lstStatus option:selected').text();
        var type = $('#lstStatus option:selected').text();


        if (status == "") {
            $('#lblMsg').append('Please select status from list');
            return false;
        }


        if (type == "") {
            $('#lblMsg').append('Please select type from list');
            return false;
        }


        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }

        if (status == null) {
            $('#lblMsg').empty();
            $('#lblMsg').append('Something went wrong! Reopen Option Page');
            return false;
        }
        if (status == 'No Data Available') {
            $('#lblMsg').empty();
            $('#lblMsg').append('Select Status ');
            return false;
        }

        if (type == null) {
            $('#lblMsg').empty();
            $('#lblMsg').append('Something went wrong! Reopen Option Page');
            return false;
        }
        if (type == 'No Data Available') {
            $('#lblMsg').empty();
            $('#lblMsg').append('Select type ');
            return false;
        }

        else {
            $('#lblMsg').empty();
            return true;
        }
    }


    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    function GoOnEnter() {
        if (event.keyCode == 13) {
            Go();
        }
    }

    $('#btnGo').click(function () {
        Go();
    });

    function Go() {

        var programId = $('#ProgramID').val();
        var ProgramName = $("#ProgramID option:selected").text();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var custRef = $('#custRef').val();
        var status = $('#lstStatus option:selected').text();
        var type = $('#lstType option:selected').text();
        //var typeid = $('#lstType option:selected').val();
        var assignedTo = $("#ddlassignedTo option:selected").text();
        var OpenWO = $('#OpenWO').is(':checked');

          $('#option').modal('hide');
        OpenPage('\\SupplyChain\\DiscrepancyReport\\Index?ProgramID=' + programId + '&ProgramName=' + ProgramName + '&frmDt = ' + fDate + ' & toDate=' + tDate + '&custRef=' + custRef + '&status=' + status + '&type=' + type + '&assignedTo=' + assignedTo + '&OpenWO=' + OpenWO + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>



