@model IP.Areas.SupplyChain.Models.Data2LogisticsReport
@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    <tr>
        <td class="pad">
            <strong>Invoice Date:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            @Html.LabelFor(model => model.invNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="invNo" placeholder="Enter Invoice No." name="invNo" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.custRef, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="custRef" placeholder="Enter Customer Reference(s), separated by commas" name="custRef" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>

</table>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Download</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
<script>
    $('#option').on('shown.bs.modal', function () {
        $('#custRef').focus();
    });
    $("#dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    //For Date Picker
    dateFrom();

    $('#lblMsg').empty();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 5);
        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var someFormattedDate = y + '.' + mm + '.' + dd;
        document.getElementById('fromDt').value = someFormattedDate;
    }


    $("#dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-120d',
        endDate: maxDate
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }



    function OptionsIsValid() {
        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var invNo = $('#invNo').val();
        var custRef = $('#custRef').val();


        if (!isDate(fDate)) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        if (invNo == null || invNo == "") {
            $('#lblMsg').append('Please enter Invoice No.');
            return false;
        }
        if (custRef == null || custRef == "") {
            $('#lblMsg').append('Please enter Customer Ref.');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }
    }
    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });

    function Go() {
        var programId = $('#ddProgram').val();
        var programName = $("#ddProgram option:selected").text();
        var invDate = $('#fromDt').val();
        var invNo = $('#invNo').val();
        var custRef = $('#custRef').val();

        //$('#option').modal('hide');
        window.location.href = '/Data2LogisticsReport/GetExcel?programId=' + programId + '&programName=' + programName + '&invDate=' + invDate + '&invNo=' + invNo + '&custRef=' + custRef;
    }
</script>
