@model IP.Areas.SupplyChain.Models.ShippingError
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool">
                @*title="Option Page" onclick="$('#option').modal('show');"*@
                <span class="fa fa-list fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">
            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstShippingError" class="table table-bordered table-striped text-sm table-hover">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<script>


    ToggleDataList(false);
    LoadData();
    function LoadData() {

        $('#tblBody').empty();

        var isSingleRow = false;

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/ShippingError/GetList',
            data: {

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "Program ID", "width": "70px", "visible": false },
                         
                        {
                            "data": "PartNo", "title": "Part No.", "width": "100px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "Status", "title": "Status", "width": "80px" },
                        { "data": "BATTERY_AGE_RULE", "title": "BATTERY_AGE_RULE", "width": "80px" },
                        { "data": "CARRIER_COUNTRYOFMANUFACTURE", "title": "CARRIER_COUNTRYOFMANUFACTURE", "width": "150px", "className": "text-center" },
                        { "data": "CARRIER_CURRENCY", "title": "CARRIER_CURRENCY", "width": "100px", "className": "text-center" },
                        { "data": "CARRIER_ECCN", "title": "CARRIER_ECCN", "width": "80px" },
                        { "data": "CARRIER_PRICE", "title": "CARRIER_PRICE", "width": "80px", "className": "text-right" },
                        { "data": "CARRIER_USTHS", "title": "CARRIER_USTHS", "width": "80px" },
                        { "data": "CARRIER_WEIGHT", "title": "CARRIER_WEIGHT", "width": "80px", "className": "text-right" },
                        { "data": "CODE_NAME", "title": "CODE_NAME", "width": "80px" },
                        { "data": "LABEL_SIZE", "title": "LABEL_SIZE", "width": "80px"},
                        { "data": "ReIDPartNumber", "title": "ReIDPartNumber", "width": "200px" },
                        { "data": "SKUD_1", "title": "SKUD_1", "width": "80px" },
                        { "data": "SKUD_2", "title": "SKUD_2", "width": "80px" },
                        { "data": "SKUD_3", "title": "SKUD_3", "width": "80px" },
                        { "data": "STRIKE_RULE", "title": "STRIKE_RULE", "width": "80px" },
                        { "data": "WeightUnit", "title": "WeightUnit", "width": "80px", "className": "text-center" }


                    ];
                    ToggleDataList(true);

                    MakeDataGrid('lstShippingError', data.lstShippingError, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }

</script>



