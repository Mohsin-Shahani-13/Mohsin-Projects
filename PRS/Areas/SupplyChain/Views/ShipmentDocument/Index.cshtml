<script>
    var name;
    var Address;
    var City;
    var phone;
    var shipmentDate;
    var CONSIGNEEName;
    var CONSIGNEEAddress;
    var CONSIGNEECity;

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');

        var custRef = $('#custRef').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/ShipmentDocument/GetList',
            data: {

                custRef: custRef
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);
                // Check if lstShipmentInfo and the first object exist
                if (data.lstShipmentInfo && data.lstShipmentInfo.length > 0) {
                    var shipmentInfo = data.lstShipmentInfo[0];

                    $('#Name').text(shipmentInfo.Name || 'N/A');
                    $('#Address').text(shipmentInfo.Address || 'N/A');
                    $('#City').text(shipmentInfo.City || 'N/A');
                    $('#Phone').text(shipmentInfo.Phone || 'N/A');
                    $('#CONSIGNEEName').text(shipmentInfo.CONSIGNEEName || 'N/A');
                    $('#CONSIGNEEAddress').text(shipmentInfo.CONSIGNEEAddress || 'N/A');
                    $('#CONSIGNEECity').text(shipmentInfo.CONSIGNEECity || 'N/A');
                    $('#ShipmentDate').text(shipmentInfo.ShipmentDate || 'N/A');
                } else {
                    console.error("No shipment info found.");
                    $('#Name, #Address, #City, #Phone, #CONSIGNEEName, #CONSIGNEEAddress, #CONSIGNEECity, #ShipmentDate').text('N/A');
                }
            
                

                var columnDef = [
                    { "data": "CustomerReference", "title": "Customer Reference", "width": "150px" },
                    { "data": "RMRModule", "title": "RMR Module", "width": "150px" },
                    { "data": "PartNo", "title": "Part No.", "width": "150px" },
                    { "data": "ModuleName", "title": "Module Name", "width": "150px" },
                    { "data": "SerialNo", "title": "Serial No.", "width": "150px" },
                    { "data": "RCToolNo", "title": "RC Tool No.", "width": "150px" },
                    { "data": "FRNo", "title": "FR No.", "width": "150px" },
                    { "data": "RepairResult", "title": "Repair Result", "width": "150px" },
                    { "data": "PO", "title": "Purchase Order (PO)", "width": "150px" },
                    { "data": "FailDescription", "title": "Fail Desc.", "width": "150px" },
                    { "data": "Customer", "title": "Customer Name", "width": "150px" },
                    { "data": "CheckList", "title": "Checklist Status", "width": "150px" }
                ];

                ToggleDataList(true);
                //For Displaying  Footer Sum
                var footerfunc = function () {
                    var api = this.api();
                    //    $(api.column(14).footer()).html(thousands_separators(api.column(14).data().sum()));
                    //    //$(api.column(11).footer()).html(thousands_separators(api.column(11).data().sum()));

                }

                MakeDataGrid('lstShipmentDocument', data.lstShipmentDocument, 150, columnDef, true, true, false);
                //MakeFrameGrid('lstShipmentDocument', data.lstShipmentDocument, 200, columnDef, true, false, true, false, false, $('#ttlRO').text(), false, false);

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
          
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
    function DownloadExcel() {
        var custRef = $('#custRef').val();
        window.open("\\Externals\\ReportViewer.aspx?custRef=" + custRef + "&rptName=ShipmentDocument", '_blank');
    }
</script>
