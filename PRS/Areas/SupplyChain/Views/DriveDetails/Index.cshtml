                        { "data": "FactoryCode", "title": "Factory Code", "width": "80px" },
                        { "data": "CustomerCode", "title": "Customer Code", "width": "90px" },
                        { "data": "TSBSN", "title": "TSB S/N", "width": "90px" },
                        { "data": "COO", "title": "COO", "width": "70px" },
