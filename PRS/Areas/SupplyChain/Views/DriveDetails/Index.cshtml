                        //        return url;
                        //    }
                        //},
                        
                        { "data": "FDCode", "title": "FD/Code", "width": "70px" },
                       
                        { "data": "Category", "title": "Category", "width": "40px" },
                        { "data": "RegionSite", "title": "Region Site", "width": "80px" },
                        { "data": "Customer", "title": "Customer", "width": "100px" },
                        { "data": "FailDate", "title": "Fail Date", "width": "90px", "className": "text-right" },
                        { "data": "FailMonth", "title": "Fail Month", "width": "60px", "className": "text-right" },
                        { "data": "FailWeek", "title": "Fail Week", "width": "60px", "className": "text-right" },
                        { "data": "CheckDate", "title": "Check On", "width": "90px", "className": "text-right" },
