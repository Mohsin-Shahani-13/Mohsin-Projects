                            "data": "SubTSB", "title": "Substitution TSB", "width": "90px"
                            //render: function (data, type, row) {
                            //    if (row["SerialNo"] == "*" || row["HAS_SN"] == 'N') {
                            //        url = row["SerialNo"];
                            //    }
                            //    else {
                            //        var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?SerialNo=' + row["SerialNo"] + '&ProgramID=' + row["cProgramId"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
