@model IP.Areas.SupplyChain.Models.DriveDetails
@{
    ViewBag.Title = "Option";
    Layout = null;
}
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">  
            @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr> 
    @*<tr>
            <td colspan="4" class="pad">
                @Html.Action("GetProgramBySite", "Home", new { id = "ProgramID", @name = "ProgramID", area = "" })
            </td>
        </tr>*@
    <tr>
        <td class="pad">
            @Html.LabelFor(model => model.serialNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="Serial_No" name="serialNo" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
        <td class="pad">
            @Html.LabelFor(model => model.custRef, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="Reference_No" name="referNo"
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td class="pad">
            <strong>Create Date From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.RecfromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            <strong>Create Date To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.RectoDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="dateFont ">
            <div>
                <br />
                <br />
                <label for="_isAllDate" style="margin-left:0px">
                    <input type="checkbox" id="isAllDate" name="isAllDate" onclick="EnableDisableOrdCreat(this)" />
                    All
                </label>
            </div>
        </td>
    </tr>
</table>
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right" class="pad">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center" class="pad">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<script>
    $('#option').on('shown.bs.modal', function () {

    });

    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }

    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });

    $("#dtpFrom, #dtpTo").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpFrom, #dtpTo").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 30);

        //var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        //var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 0);
        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('RecfromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('RectoDt').value = someFormattedDate;
    }

    $("#dtpFrom, #dtpTo").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-365d',
        endDate: maxDate
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#RecfromDt').val();
        var tDate = $('#RectoDt').val();

        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }
    }

    function EnableDisableOrdCreat(isAllDate) {
        var isAllDate = $('#isAllDate').is(':checked');
        document.getElementById("RecfromDt").disabled = isAllDate;
        var nodes1 = document.getElementById("RecfromDt").getElementsByTagName('*');
        document.getElementById("RectoDt").disabled = isAllDate;
        var nodes1 = document.getElementById("RectoDt").getElementsByTagName('*');
        for (var i = 0; i < nodes1.length; i++) {
            nodes1[i].disabled = isAllDate;
        }
    };

    function Go() {
        var ProgramId = $('#ddProgram').val();
        var ProgramName = $("#ddProgram option:selected").text();
        var serialNo = $('#Serial_No').val();
        var custRef = $('#Reference_No').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var fDate = $('#RecfromDt').val();
        var tDate = $('#RectoDt').val();
        $('#option').modal('hide');

        OpenPage('\\SupplyChain\\DriveDetails\\Index?programId=' + ProgramId + '&programName=' + ProgramName + '&SerialNo=' + serialNo + '&custReference=' + custRef + '&fromDt=' + fDate + ' &toDt=' + tDate + '&isAllDate=' + isAllDate + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>
