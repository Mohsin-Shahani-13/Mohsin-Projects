<script>

    ToggleDataList(false);
    ToggleDataListPartShrtge('bot_section', false);
    LoadData();
    function LoadData() {

        $('#tblBody').empty();
        $('#option').modal('hide');

        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/WIPAgingByWO/GetList',
            data: {
                programId: _programId,
                ProgramName: _ProgramName
            },
            datatype: JSON,
            success: function (data) {

                $('#filterString').append(data.filterString);

                var columnDef = [

                    { "data": "Workstation", "title": "Work Station", "width": "500px" },
                    {
                        "data": "NoAging", "title": "NO Aging", "width": "40px", "className": "text-right", "targets": 0,
                        render: function (data, type, row) {

                            var url = '<a href="#" class="Part_Undrln" onclick="OpenViewWIP(\'\\\\SupplyChain\\\\WIPAgingByWO\\\\GetData?workstation=' + row["Workstation"] + '&ProgramId=' + row["ProgramID"] + '&frmDt=0&toDt=0' + '' + '\',\'bot_section\')">' + thousands_separators(data) + '</a>';
                            return url;
                        }
                    },
                    {
                        "data": "1Day", "title": "1 Day", "width": "40px", "className": "text-right", "targets": 0,
