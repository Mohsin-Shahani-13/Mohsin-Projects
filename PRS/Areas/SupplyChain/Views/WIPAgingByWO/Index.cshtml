                    $(api.column(8).footer()).html('<a href="#" class="Part_Undrln" onclick="OpenViewWIP(\'\\\\SupplyChain\\\\WIPAgingByWO\\\\GetData?frmDt=' + '10' + '&toDt=' + '15' + '&workstation=' + 'null' + '\',\'bot_section\')">' + thousands_separators(api.column(8, { search: 'applied' }).data().sum()) + '</a>');
                    $(api.column(9).footer()).html('<a href="#" class="Part_Undrln" onclick="OpenViewWIP(\'\\\\SupplyChain\\\\WIPAgingByWO\\\\GetData?frmDt=' + '16' + '&toDt=' + '30' + '&workstation=' + 'null' + '\',\'bot_section\')">' + thousands_separators(api.column(9, { search: 'applied' }).data().sum()) + '</a>');
                    $(api.column(10).footer()).html('<a href="#" class="Part_Undrln" onclick="OpenViewWIP(\'\\\\SupplyChain\\\\WIPAgingByWO\\\\GetData?frmDt=' + '31' + '&toDt=' + '10000' + '&workstation=' + 'null' + '\',\'bot_section\')">' + thousands_separators(api.column(10, { search: 'applied' }).data().sum()) + '</a>');
                    $(api.column(11).footer()).html('<a href="#" class="Part_Undrln" onclick="OpenViewWIP(\'\\\\SupplyChain\\\\WIPAgingByWO\\\\GetData?frmDt=' + '0' + '&toDt=' + '10000' + '&workstation=' + 'null' + '\',\'bot_section\')">' + thousands_separators(api.column(11, { search: 'applied' }).data().sum()) + '</a>');
                }

                var tableHeader = $('.table').innerHeight();
                var topHeader = $('.incomming').innerHeight();
                var browserHeight = window.innerHeight;
                var gridHeight = browserHeight - (tableHeader + topHeader)
                ToggleDataList(true);

                var h = getHeight(45);
                MakeFrameGrid('lstWIPAgingByWO', data.lstWipAgingByWO, 330, columnDef, 'buttons', true, true, footerfunc, false, $('#WIPBYWO').text(), true);

                ToggleDataListPartShrtge('bot_section', true);

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
    function OpenViewWIP(_url, target) {

        $('#panel_bottom').empty();
        $('#panel_bottom').append('<div id="bot_section" class="box panel panel-default leftsection"><h4><p>Click hyperlinks on Above section to load data</p></h4></div>');

        $.ajax({
            url: _url,
            success: function (data) {
                $('#' + target).hide();
                $("#wait").css("display", "none");
                $("#" + target).html(data);
                $('#' + target).show();
            }
        });
    }

