@model IP.Areas.SupplyChain.Models.WIPAgingByWO
@{
    ViewBag.Title = "GetData";
    Layout = null;
}
<style>
    #lstDetail_info, #lstDetail_paginate {
        margin-top: 6px;
    }
</style>

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <h6 class="box-title" id="head_lstUnitLst" style="float:left"><strong>@ViewBag.ReportTitle</strong><strong id="filterString"></strong></h6>
            <div id="button" class="box-tools pull-right">

            </div>
        </div>

        <div class="box-body" id="lstDtl" style="height:47%">
            <table id="lstDetail" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>

    </div>
</div>

<script>
        $(document).ready(function () {
                var _lstWIPAgingByWO = @Html.Raw(Model.serializer.Serialize(Model.lstWipAgingByWOUnit));

            var columnDef = [
                { "data": "Days", "title": "Days", "width": "50px", "visible": false },
                { "data": "ProgramId", "title": "ProgramId", "width": "50px", "visible": false },

                    { "data": "Program", "title": "Program", "width": "50px" },
                    { "data": "orderId", "title": "ID", "width": "50px", "visible": false },
                    {
                       "data": "Customerreference", "title": "Customer Ref.", "width": "120px",
                        render: function (data, type, row) {
                            var url = '<a href= "\\SupplyChain\\WO\\Detail?Id=' + row["orderId"] + '&custRef=' + row["Customerreference"] + '&ProgramId=' + row["ProgramId"] + '&page=list" target=_blank > ' + data + '</a>';

                        return url;
                         }
                    },
                    {
                    "data": "PartNo", "title": "Part No.", "width": "70px",
                    render: function (data, type, row) {
                        var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&Programid=' + row["ProgramId"] + '&page=list" target=_blank > ' + data + '</a>';
                        return url;
                        }
                    },
                    {
                        "data": "SerialNo", "title": "Serial No.", "width": "70px",
                        render: function (data, type, row) {   
                            if (row["SerialNo"] == '*') {
                                url = row["SerialNo"];
                            }
                            else {
                                var url = '<a href= \\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramId"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                            }
                            return url;
                        }
                    },
                    { "data": "RepairType", "title": "Repair Type", "width": "140px" },
                    { "data": "WorkstationID", "title": "Workstation Id", "width": "50px", "visible": false },
                    { "data": "Workstation", "title": "Work Station", "width": "120px" },
                    { "data": "Status", "title": "Status", "width": "50px" },
                    { "data": "Aging", "title": "Aging", "width": "40px", "className": "text-right" },
                    { "data": "CreatedBy", "title": "Created By", "width": "60px" },
                    { "data": "CreatedOn", "title": "Created On", "width": "90px", "className": "text-right" },
                    { "data": "LastActivityOn", "title": "Last Activity On", "width": "90px", "className": "text-right" }

            ]
            //var footerfunc = function () {
            //    var api = this.api();

            //    $(api.column(11).footer()).html(thousands_separators(api.column(11).data().sum()));
            //    $(api.column(12).footer()).html(thousands_separators(api.column(12).data().sum()));
            //}
            ToggleDataList(true);
            var h = getHeight(40);
            MakeFrameGrid('lstDetail', _lstWIPAgingByWO, 330, columnDef, 'button', true, false, false, false, $('#head_lstUnitLst').text(), false);
            //MakeFrameGrid('lstDetail', _lstDtl, 290, columnDef, ,false, false, false, footerfunc, false, $('#box-title').text(), false, false);
        });
</script>


