@model IP.Areas.SupplyChain.Models.ApprovedRejectRepair
@{
    ViewBag.Title = "Option";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstApprovedRejectRepair" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    @*<tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>*@
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();
        
        $('#option').modal('hide');
        var isSingleRow = false;
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();
        var partNo = $('#partNo').val();
        var serialNo = $('#serialNo').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/ApprovedRejectRepair/GetList',
            data: {
                programId: _programId,
                ProgramName: _ProgramName,
                partNo: partNo,
                serialNo: serialNo
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "Program ID", "width": "40px", "visible": false },
                        { "data": "ProgramName", "title": "Program", "width": "70px" },
                        { "data": "customerreference", "title": "Cust Ref.", "width": "80px" },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "80px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "70px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                if (row["HAS_SN"] == 'N' || row["SerialNo"] == "*") {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&Programid=' + row["ProgramID"] + '&partno=' + row["PartNo"] + '&page=list" target=_blank > ' + d + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "ID", "title": "Order No.", "width": "50px" },
                        { "data": "reason", "title": "Reason", "width": "180px", "visible": false  },
                        { "data": "PRStatus", "title": "PRStatus", "width": "190px" },
                        { "data": "Status", "title": "Status", "width": "50px" },
                        { "data": "CreatedBy", "title": "Created By", "width": "20px"/*, "className": "text-right"*/ },
                        { "data": "CreatedOn", "title": "Created On", "width": "70px", "className": "text-right" },
                        { "data": "LastActivityOn", "title": "Last Activity On", "width": "70px", "className": "text-right" }

                    ]
                    //For Displaying  Footer Sum
                    //var footerfunc = function () {
                    //    var api = this.api();
                    //    $(api.column(8).footer()).html(thousands_separators(api.column(8).data().sum()));
                    //}

                    ToggleDataList(true);
                    MakeDataGrid('lstApprovedRejectRepair', data.lstApprovedRejectRepair, 0, columnDef, true, true);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>