@model IP.Areas.SupplyChain.Models.PendingPart

@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            @*<h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>*@
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">
            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstPendingPart" class="table table-bordered table-striped text-sm table-hover" width="100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th style="text-align:left">Total:</th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
                <tbody id="tblBody"></tbody>
            </table>
        </div>
    </div>
</div>
<script>
    var COLUMN_FORMAT =
    {
        formatDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(4));
        },
        formatTwoDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(2);
        },
        formatNumber: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(0));
        },

        formatNumberForZero: function (data, type, row) {
            var val = +data;
            return val === "0" ? '' : val.toFixed(0);
        },

    };

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();
        //$('#option').modal('hide');

        var _programId = $('#ddProgram').val();
        var _ProgramName = $("#ddProgram option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/PendingPart/GetList',
            data: {
                programID: _programId,
                programName: _ProgramName,


            },
            datatype: JSON,
            success: function (data) {

                $('#filterString').append(data.filterString);
                var columnDef = [
                    { "data": "ProgramID", "title": "ProgramID", "width": "90px", "visible": false },
                    { "data": "Program", "title": "Program", "width": "90px", "visible": false },
                    { "data": "ID", "title": "Order No.", "width": "70px" },
                    {
                        "data": "CustomerReference", "title": "Cust. Reference", "width": "130px",
                        render: function (data, type, row) {
                            var url = '<a href= "\\SupplyChain\\WO\\Detail?Id=' + row["ID"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';

                            return url;
                        }
                    },
                    { "data": "reason", "title": "Reason", "width": "110px" },
                    {
                        "data": "PartNo", "title": "Part No.", "width": "100px",
                        render: function (data, type, row) {
                            var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                            return url;
                        }
                    },
                    {
                        "data": "SerialNo", "title": "Serial No.",
                        render: function (data, type, row) {
                            var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                            return url;
                        }
                    },
                    {
                        "data": "ComponentPartNo", "title": "Component Part No.", "width": "120px",
                        render: function (data, type, row) {
                            var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                            return url;
                        }
                    },
                    { "data": "RepairType", "title": "Repair Type", "width": "180px" },
                    { "data": "Status", "title": "Status", "width": "100px" },
                    { "data": "By", "title": "By", "width": "100px" },
                    { "data": "QtyRequested", "title": "Req. Qty", "width": "70px", "className": "text-right" },
                    {
                        "data": "availqty", "title": "Avail. Qty", "width": "70px", "className": "text-right",

                        render: function (data, type, row) {

                            var val = COLUMN_FORMAT.formatNumberForZero(data);
                            return val;
                        }
                    },
                    {
                        "data": "TotalQty", "title": "Total Qty", "width": "70px", "className": "text-right",

                        render: function (data, type, row) {

                            var val = COLUMN_FORMAT.formatNumberForZero(data);
                            return val;
                        }
                    },
                    { "data": "HoldDate", "title": "Hold Date", "width": "90px", "className": "text-right" },
                    {
                        "data": "DaysinHold", "title": "Days In Hold", "width": "100px", "className": "text-right",

                        render: function (data, type, row) {

                            var val = COLUMN_FORMAT.formatNumberForZero(data);
                            return val;
                        }
                    },                   
                ];
                var footerfunc = function () {
                    var api = this.api();
                    $(api.column(11).footer()).html(thousands_separators(api.column(11, { search: 'applied' }).data().sum()));
                    $(api.column(12).footer()).html(thousands_separators(api.column(12, { search: 'applied' }).data().sum()));
                    $(api.column(13).footer()).html(thousands_separators(api.column(13, { search: 'applied' }).data().sum()));


                }
                ToggleDataList(true);
                MakeDataGrid('lstPendingPart', data.lstPendingPart, 0, columnDef, true, true, footerfunc);

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
  
</script>
