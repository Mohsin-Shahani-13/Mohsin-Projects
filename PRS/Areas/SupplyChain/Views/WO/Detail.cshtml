
@model IP.Areas.SupplyChain.Models.WO
@{
    ViewBag.Title = "Detail";
    Layout = cCommon.SwitchToDetailPage(Request.Url.PathAndQuery);
}
<style> 
    .text-sm {
        padding-bottom: 3px;
    }

    .babygridheight {
        width: 100%;
    }
</style>
<div id="parentDiv" class="container-fluid">
    <input id="rptcode" type="hidden" value="008" />
    <div id="datalist" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            @{
                if (Layout == null)
                {
                    <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                        <span class="fa fa-filter fa-lg white"></span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-box-tool">
                        <span class="fa fa-th-list fa-lg white"></span>
                    </button>
                }
            }
            <h6 class="box-title"><strong>WO Header >  Customer Ref. = '@Request.QueryString["custRef"]'</strong></h6>
            <div id="button" class="box-tools pull-right" style="margin-top:2PX;">
            </div>
        </div>
        <div id="topHeader" class="box-body row text-sm">
            <div class="col-md-12 text-sm">
                <table id="tblheader" class="table text-sm" style="margin-bottom:-5px" width="100%">
                    <tr>
                        <td style="width: 100px;"><strong>@Html.DisplayNameFor(m => m.program)</strong></td>
                        <td style="width: 230px;" class="bg-gray-light">@Html.DisplayFor(m => m.program)</td>

                        <td><strong>@Html.DisplayNameFor(m => m.returnReason)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.returnReason)</td>

                        <td style="width: 100px;"><strong>@Html.DisplayNameFor(m => m.username)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.username)</td>

                        <td style="width: 100px;"><strong>@Html.DisplayNameFor(m => m.partNo)</strong></td>
                        <td class="bg-gray-light"><a href="@Url.Action("Detail", "PartInquiry", new { Area = "ListingReports", Model.partNo, Model.ProgramID })" target="_blank">@Model.partNo</a></td>


                        <td style="width: 100px;"><strong>@Html.DisplayNameFor(m => m.createDate)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.createDate)</td>

                    </tr>
                    <tr>
                        <td><strong>@Html.DisplayNameFor(m => m.serialNo)</strong></td>
                        <td class="bg-gray-light"><a href="@Url.Action("Detail", "PartsSerial", new { Area= "ListingReports",  Model.serialNo, Model.ProgramID,Model.partNo})" target="_blank">@Model.serialNo</a></td>


                        <td style="width: 100px;"><strong>@Html.DisplayNameFor(m => m.description)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.description)</td>

                        <td><strong>@Html.DisplayNameFor(m => m.workstation)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.workstation)</td>

                        <td><strong>@Html.DisplayNameFor(m => m.locationNo)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.locationNo)</td>

                        <td><strong>@Html.DisplayNameFor(m => m.lastActivityDate)</strong></td>
                        <td class="bg-gray-light">@Html.DisplayFor(m => m.lastActivityDate)</td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="row">
