
@model IP.Areas.SupplyChain.Models.WO
@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        width: 260px;
    }

    .CBRepairUnits {
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    

    <tr>
        <td class="pad">

            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>

        <td class="dateFont ">
            <div>
                <br />
                <br />
                <label for="_ReceivedAllDate" id="lblisAllDate" style="margin-left:0px">
                    <input type="checkbox" id="isAllDate" name="isAllDate" onclick="isAllDate(this)" checked/>
                    All
                </label>
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.custRef, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="custRef" name="custRef" autofocus
                   onkeydown="GoOnEnter()" />
        </td>

    </tr>
   
    




    

    <tr>
        <td colspan="4" class="pad">

            <div>
                <label>
                    @Html.CheckBoxFor(model => model.ischecked, new { @id = "ischecked", @class = "form-check-input", @onclick = "EnableDisableOrdCreat_3(this)", }) Show units at close station but not yet closed
                </label>
            </div>
        </td>

    </tr>
    <tr>
        <td colspan="4" class="pad">
            <div>
                <label>
                    @Html.CheckBoxFor(model => model.ischecked2, new { @id = "ischecked2", @class = "form-check-input", @onclick = "EnableDisableOrdCreat_2(this)", }) Repaired Units
                </label>
            </div>
        </td>
    </tr>

    <tr>
        <td colspan="4" class="pad">
            <div>
                <label>
                    @Html.CheckBoxFor(model => model.ischecked3, new { @id = "ischecked3", @class = "form-check-input", @onclick = "EnableDisableAllDate(this)", }) Open Work Orders
                </label>
            </div>
        </td>
    </tr>

</table>
<table style="width:100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<script>
  


    $('#option').on('shown.bs.modal', function () {
        
       
        $('#custRef').focus();
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });
    
    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 1);

        var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-365d',
        endDate: maxDate
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    

    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
     $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
     
        var ischecked2 = $('#ischecked2').is(':checked');
        var ischecked3 = $('#ischecked3').is(':checked');
       
        

        //var ischecked = $('#ischecked').is(':checked');

        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
      
       

        
        
        else {
            $('#lblMsg').empty();
            return true;
        }
    }

    function Go() {
        
        var receiveAllDate = $('#ReceivedAllDate').is(':checked')
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var custRef = $('#custRef').val();
        

        var ischecked = $('#ischecked').is(':checked');
        var ischecked2 = $('#ischecked2').is(':checked');
        var ischecked3 = $('#ischecked3').is(':checked');
        $('#option').modal('hide');

  

            OpenPage('\\SupplyChain\\WO\\Index?Option=' + 'op' + '&frmDt=' + fDate + ' &toDate=' + tDate + ' &custRef=' + custRef + '&ischecked2=' + ischecked2 + '' +  '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')

        

       

    }
</script>



