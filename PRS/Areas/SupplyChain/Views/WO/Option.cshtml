            <td colspan="4" class="pad">
                @Html.LabelFor(model => model.program_Id, htmlAttributes: new { @class = "col-4 col-form-lable" })
                @Html.DropDownList("ddlProgram", null, new { id = "ddlProgram", @name = "ddlProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })

            </td>
        </tr>*@
    @*<tr>
            <td colspan="4" class="pad">
                @Html.LabelFor(model => model.statusId, htmlAttributes: new { @class = "col-4 col-form-lable" })
                @Html.DropDownList("ddlStatus", null, new { id = "ddlStatus", @name = "ddlStatus", @class = "form-control", @onkeydown = "GoOnEnter()" })
            </td>

        </tr>*@
    <tr>
        <td class="pad" colspan="4">
            @Html.LabelFor(model => model.Status, htmlAttributes: new { @class = "form-label" })
            <select id="lstStatus" multiple="multiple" class="multiselect form-control" name="options[]">
                @{
                    if (Model != null)
                    {
                        foreach (var item in Model.lstStatus)
                        {
                            <option value="@item[0]">@item[1]</option>
                        }
                    }
                }
            </select>
        </td>
    </tr>




    <tr>
        <td class="pad" colspan="4">
            <div>
                @Html.LabelFor(model => model.Repair, htmlAttributes: new { @class = "form-label" })
                <select id="lstRepair" multiple="multiple" class="multiselect form-control " name="options[]">
                    @{
                        if (Model != null)
                        {
                            foreach (var item in Model.lstRepair)
                            {
                                <option value="@item[0]">@item[1]</option>
                            }
                        }
                    }
                </select>
            </div>
        </td>

    </tr>

    <tr>
        <td colspan="4" class="pad">

            <div>
                <label>
                    @Html.CheckBoxFor(model => model.ischecked, new { @id = "ischecked", @class = "form-check-input", @onclick = "EnableDisableOrdCreat_3(this)", }) Show units at close station but not yet closed
                </label>
            </div>
        </td>

    </tr>
    <tr>
        <td colspan="4" class="pad">
            <div>
                <label>
                    @Html.CheckBoxFor(model => model.ischecked2, new { @id = "ischecked2", @class = "form-check-input", @onclick = "EnableDisableOrdCreat_2(this)", }) Repaired Units
                </label>
            </div>
        </td>
    </tr>

    <tr>
        <td colspan="4" class="pad">
            <div>
                <label>
                    @Html.CheckBoxFor(model => model.ischecked3, new { @id = "ischecked3", @class = "form-check-input", @onclick = "EnableDisableAllDate(this)", }) Open Work Orders
                </label>
            </div>
        </td>
    </tr>

</table>
<table style="width:100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
