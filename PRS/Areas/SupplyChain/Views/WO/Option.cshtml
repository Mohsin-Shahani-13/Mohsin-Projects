    $('#option').on('shown.bs.modal', function () {
        
       
        $('#custRef').focus();
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });
    // For Multiple Status
    selectedParts = '';

    $('#lstStatus').multiselect({
        includeSelectAllOption: true,
        selectAllText: 'All',
        buttonWidth: '100%',
        maxHeight: 300,
        enableFiltering: true,
        enableCaseInsensitiveFiltering: true,
        filterPlaceholder: 'Search',
        numberDisplayed: 1,
        templates: {
            ul: '<ul class="multiselect-container dropdown-menu" style="-ms-overflow-x: hidden; -ms-overflow-y: auto; max-height: 300px; width:100%;">"'
        },

        buttonText: function (options, select) {
            if (options.length == 0) {
                return 'select from list';
            }
            else {
                if (options.prevObject.length == options.length) {
                    selectedParts = 'All';
                } else {
                    selectedParts = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selectedParts += "'" + label + "', ";
                    });
                    selectedParts = selectedParts.substr(0, selectedParts.length - 2);
                }



                if (options.length > this.numberDisplayed) {
                    return options.length + ' ' + this.nSelectedText;
                }
                else {
                    var selected = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selected += label + ", ";
                    });
                    return selected.substr(0, selected.length - 2);
                }
            }
        }
    });



    $('#lstStatus').multiselect('selectAll', false);
    $("#lstStatus").multiselect('updateButtonText');

    // For Multiple Repairs
    selectedPart = '';

    $('#lstRepair').multiselect({
        includeSelectAllOption: true,
        selectAllText: 'All',
        buttonWidth: '100%',
        maxHeight: 200,
        enableFiltering: true,
        enableCaseInsensitiveFiltering: true,
        filterPlaceholder: 'Search',
        numberDisplayed: 1,
        templates: {
            ul: '<ul class="multiselect-container dropdown-menu" style="-ms-overflow-x: hidden; -ms-overflow-y: auto; max-height: 300px; width:100%;">"'
        },

        buttonText: function (options, select) {
            if (options.length == 0) {
                return 'select from list';
            }
            else {
                if (options.prevObject.length == options.length) {
                    selectedPart = 'All';
                } else {
                    selectedPart = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selectedPart += "'" + label + "', ";
                    });
                    selectedPart = selectedPart.substr(0, selectedPart.length - 2);
                }



                if (options.length > this.numberDisplayed) {
                    return options.length + ' ' + this.nSelectedText;
                }
                else {
                    var selected = '';
                    options.each(function () {
                        var label = ($(this).attr('text') !== undefined) ? $(this).attr('text') : $(this).html();
                        selected += label + ", ";
                    });
                    return selected.substr(0, selected.length - 2);
                }
            }
        }
    });



    $('#lstRepair').multiselect('selectAll', false);
    $("#lstRepair").multiselect('updateButtonText');
    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 1);

        var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-365d',
        endDate: maxDate
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    $(document).ready(function () {


        $("#lstStatus").change(function () {
            $('#lblMsg').empty();
        });
        $("#lstRepair").change(function () {
            $('#lblMsg').empty();
        });

    });

    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
     $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var custRef = $('#custRef').val();
        //var program_Id = $('#ddlProgram option:selected').text();
        var status = $('#lstStatus option:selected').text();
        var Repair = $('#lstRepair option:selected').text();
        //var  = $('#lstRepair option:selected').text();
        var ischecked2 = $('#ischecked2').is(':checked');
        var ischecked3 = $('#ischecked3').is(':checked');
        if (status == "" && ischecked2 == false && ischecked3 == false) {
            $('#lblMsg').append('Please select status from list');
            return false;
        }

        else if (Repair == "" && ischecked2 == false && ischecked3 == false ) {
            $('#lblMsg').append('Please select Repair from list');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }

        //var ischecked = $('#ischecked').is(':checked');

        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }
        //for status
        if (status == null) {
            $('#lblMsg').empty();
            $('#lblMsg').append('Something went wrong! Reopen Option Page');
            return false;
        }
        if (status == 'No Data Available') {
            $('#lblMsg').empty();
            $('#lblMsg').append('Select Status ');
            return false;
        }

        else {
            $('#lblMsg').empty();
            return true;
        }
        //for Repair
        if (Repair == null) {
            $('#lblMsg').empty();
            $('#lblMsg').append('Something went wrong! Reopen Option Page');
            return false;
        }
        if (Repair == 'No Data Available') {
            $('#lblMsg').empty();
            $('#lblMsg').append('Select Repair');
            return false;
        }

        else {
            $('#lblMsg').empty();
            return true;
        }
    }

    function Go() {
        
        var receiveAllDate = $('#ReceivedAllDate').is(':checked')
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var custRef = $('#custRef').val();
        var programId = $('#ddProgram').val();

        var ProgramName = $('#ddProgram option:selected').text();
        //var program_Id = $('#ddlProgram option:selected').text();

        var status = $('#lstStatus option:selected').text();
        var statusid = $('#lstStatus option:selected').val();

        var Repair = $('#lstRepair option:selected').text();
        var RepairTypeID = $('#lstRepair option:selected').val();

        var ischecked = $('#ischecked').is(':checked');
        var ischecked2 = $('#ischecked2').is(':checked');
        var ischecked3 = $('#ischecked3').is(':checked');
        $('#option').modal('hide');

        if (ischecked2 == true) {

            OpenPage('\\SupplyChain\\WO\\repairedUnits?statusId=' + statusid + '&Repair=' + Repair + '&RepairTypeID=' + RepairTypeID + '&Option=' + 'op' + '&frmDt=' + fDate + ' &toDate=' + tDate + ' &custRef=' + custRef + '&status=' + status + '&ProgramID=' + programId + '&ProgramName=' + ProgramName + '&ischecked2=' + ischecked2 + ProgramName + '&type=' + '' +  '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')

        }

        else {

            OpenPage('\\SupplyChain\\WO\\Index?statusId=' + statusid + '&Repair=' + Repair + '&RepairTypeID=' + RepairTypeID + '&Option=' + 'op' + '&frmDt=' + fDate + ' &toDate=' + tDate + '&isAllDate=' + isAllDate + ' &custRef=' + custRef + '&status=' + status + '&ProgramID=' + programId + '&ProgramName=' + ProgramName +  '&ischecked3=' + ischecked3 + ProgramName + '&ischecked=' + ischecked + '&type=' + '' +  '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')

        }

    }
</script>



