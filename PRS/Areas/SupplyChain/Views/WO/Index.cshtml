    <script>

            var COLUMN_FORMAT =
        {
            formatDecimal: function (data, type, row) {
                var val = +data;
                return val === 0 ? '' : thousands_separators(val.toFixed(4));
            },
            formatTwoDecimal: function (data, type, row) {
                var val = +data;
                return val === 0 ? '' : val.toFixed(2);
            },
            formatNumber: function (data, type, row) {
                var val = +data;
                return val === 0 ? '' : thousands_separators(val.toFixed(0));
            },

            formatNumberForZero: function (data, type, row) {
                var val = +data;
                return val === 0 ? '' : val.toFixed(0);
            },

        };
        ToggleDataList(false);
        LoadData();
        function LoadData() {
           
            $('#tblBody').empty();
            //$('#lstROH').DataTable().clear();
            //$('#lstROH').DataTable().destroy();

            $('#option').modal('hide');
            var isSingleRow = false;
            var fDate = $('#fromDt').val();
            var tDate = $('#toDt').val();
            var isAllDate = $('#isAllDate').is(':checked');
            var custRef = $('#custRef').val();
            var ischecked3 = $('#ischecked3').is(':checked');
            var ischecked = $('#ischecked').is(':checked');


            $.ajax({

                cache: false,
                type: 'GET',
                url: '/WO/GetWO',
                data: {
                    frmDt: fDate,
                    toDate: tDate,
                    isAllDate: isAllDate,
                    custRef: custRef,
                    
                    ischecked3: ischecked3,
                    type: '@ViewBag.ReportTitle1',
                    ischecked: ischecked
                },
                datatype: JSON,
                success: function (data) {
                    $('#filterString').append(data.filterString);
                    
                        var columnDef = [

                            { "data": "ID", "title": "ID", "width": "40px" },
                            {
                                "data": "CustomerReference", "title": "Customer Ref."
                            },
                            { "data": "ProgramID", "title": "ProgramID", "width": "40px" },
                            {
                                "data": "PartNo", "title": "Part No.", "width": "120px"
                            },
                            {
                                "data": "SerialNo", "title": "Serial No.", "width": "120px"
                            },
                            
                            { "data": "RepairTypeID", "title": "Repair Type", "width": "170px" },
                            { "data": "WorkStationIDPrevious", "title": "Workstation Id", "width": "90px"  },
                            { "data": "WorkStationID", "title": "Work Station", "width": "90px" },
                            { "data": "StatusID", "title": "Status", "width": "80px" },
                            { "data": "BizTalkID", "title": "BizTalkID", "width": "80px" },
                            { "data": "IsPass", "title": "IsPass", "width": "80px" },
                            { "data": "DefaultLocationID", "title": "DefaultLocationID", "width": "100px" },
                            { "data": "UserID", "title": "UserID", "width": "100px" },
                            { "data": "CreateDate", "title": "Created On", "width": "90px", "className": "text-right" },
                            { "data": "LastActivityDate", "title": "Last Activity On", "width": "100px", "className": "text-right" }
                        ]



                        ToggleDataList(true);
                   
                    MakeDataGrid('lstWO', data.lstWO, 0, columnDef, true, true, false);
                    //}
                    if (data["ErrorMessage"] != null) {
                        $('.dataTables_empty > p').text(data["ErrorMessage"]);
                    }
                },
                onerror: function (r) { r },
                failure: function (r) { r }
            });


        }
        $(document).ready(function () {

            $("#opp").click(function () {

                Navigate('option', '\\SupplyChain\\WO\\Option','008','Work Orders','Specd by: Abbas Arsiwala @@ Reconext &amp; Designed by: Arsalan Aziz @@ WinIT','mailto:kashif@winit.biz?cc=mohsin@winit.biz;Tahir@winit.biz&amp;subject=Received Order - Detail Report');

            });

        });
    </script>
   