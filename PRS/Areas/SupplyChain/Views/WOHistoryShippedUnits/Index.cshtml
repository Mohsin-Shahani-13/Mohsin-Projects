<script>

   ToggleDataList(false);
    LoadData();
    function LoadData() {

        var _lstData = @Html.Raw(Json.Encode(Model.lstWOHistoryShippedUnits));  //datatable wiplist
        var _lstDataColumn = @Html.Raw(Json.Encode(Model.lstDataColumn)); // column headers
        var ProgramID = '@ViewBag.ProgramID';

        var conType = '@HttpContext.Current.Session["CONN_TYPE"].ToString()';
        var Program = '@ViewBag.ProgramName';

        //console.log(conType + "" + Program)

        var th = '<tr>'; //create th for headers
        var tft = '<tr>'; //create th for footers


       
            $.each(_lstDataColumn, function (index, value) {

                if (index == 0) {
                    th += '<th id=idx' + index + ' class="notexport">' + value + ' </th>'; // for table headers
                }
                else {
                    th += '<th id=idx' + index + '>' + value + ' </th>'; // for table headers
                }

                if (index == 1) {
                    tft += '<th Style="text-align:left">Total :</th>';
                }
                else if (index == 3) {
                    tft += '<th></th>';
                    //for table footer show total.
                }
                else {
                    tft += '<th></th>'; // for table footers
                }

            });
            th += '</tr>'; // th end
            tft += '</tr>' // th footer end
            $('#lstData >thead').append(th); // th header append to thead
            $('#lstData >tfoot').append(tft); // th footer append to footer
        


        var columnDef = [];

        columnDef.push({ targets: [0], "title": "Program", "visible":false });
        columnDef.push({

            targets: [1], "title": "Part No.", "width": "90px",
            render: function (data, type, row) {
                //console.log(row);
                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row[1] + '&programId=' + row[0] + '&page=list" target=_blank > ' + data + '</a>';
                return url;
            }
        });


        columnDef.push({
            targets: [2], "title": "Serial No.",
            render: function (data, type, row) {
                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row[2] + '&ProgramId=' + row[0] + '&PartNo=' + row[1] + '&page=list" target=_blank > ' + data + '</a>';
                return url;
            }
        });

        columnDef.push({ targets: [3], "title": "Ship Date", "width": "90px", "className": "text-right" });

            // hyperlink on in_wip units
            for (i = 4; i <= _lstDataColumn.length - 1; i++) {

                columnDef.push({

                    "className": "text-center", "width": "70px", "targets": i
                });

            }


        var footerfunc = function () {

            var api = this.api();
            //apply sum on hyperlink

           
                for (i = 4; i <= _lstDataColumn.length - 1; i++) {

                    var colValue = api.column(i);
                    colValue = colValue.data();
                    var rowData = document.getElementById('idx' + i).innerText;
                    colValue = colValue.sum();

                    $(api.column(i).footer()).html(thousands_separators(colValue));
                }
            }
        
        //ToggleDataList(true);
        ToggleDataList(true);
        var h = getHeight(88);
        //MakeFrameGrid('lstData', _lstData, h, columnDef, 'lstWIP', true, false, footerfunc);

        MakeDataGrid('lstData', _lstData, 0, columnDef, true, true, footerfunc);
        $(document).ready(function () {

            $("#opp").click(function () {

                Navigate('option', '\\SupplyChain\\WIP\\Option', '011', 'Work In Progress', 'Specd by: Abbas Arsiwala @@ Reconext &amp; Designed by: Arsalan Aziz @@ WinIT', 'mailto:kashif@winit.biz?cc=mohsin@winit.biz;Tahir@winit.biz&amp;subject=Work In Progress - Report');

            });

        });

    }
</script>
