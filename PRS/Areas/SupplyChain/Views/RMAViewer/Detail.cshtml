@model IP.Areas.SupplyChain.Models.RMAViewer
@{
    ViewBag.Title = "Detail";
    Layout = null;
}
<style>
    tr {
        white-space:nowrap;
    }
</style>
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">
            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstRMAViewerDetail" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th></th>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th>Total:</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                    </tfoot>
            </table>
        </div>
    </div>
</div>
<script>
    ToggleDataList(false);
    $.fn.dataTable.render.ellipsisAdr1 = function (cutoff) {
        return function (data, type, row) {
            if (type === 'display') {
                var str = data.toString().replace(/(\r\n|\n|\r|\%|\*|\=|\:|\!|\'|\(|\)|\>|\")/gm, "");

                var header = "Address";
                return str.length < cutoff ?
                    str :
                    str.substr(0, cutoff - 1) + '<a href="#" onclick="showModalForZPL(\'' + header + '\', \'' + str + '\')"> More</a>';
            }
            // Search, order and type can use the original data
            return data;
        };
    };
    function showModalForZPL(head, str) {
        $('#commentsheader').html(head);
        $('#commentsbody').html('<text rows="15" cols="78" name="usrtxt" wrap="hard"> "' + str + '" </text> ');
        $('#comments').modal('show');
    }
    LoadData();
    function LoadData()
    {
        $('#tblBody').empty();
        $('#option').modal('hide');

        var isSingleRow = false;
        //var programId = $('#ddProgram').val();
        //var ProgramName = $('#ddProgram option:selected').text();
        var _rptType = $('#rptName option:selected').text();
        //var isAllDate = $('#isAllDate').is(':checked');
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var _RMANo = $('#RMANo').val();
        var _waybill = $('#waybill').val();
        var _partNo = $('#partNo').val();
        var _serialNo = $('#serialNo').val();

        $.ajax
        ({
            cache: false,
            type: 'GET',
            url: '/RMAViewer/GetDetail',
            data:
            {
                frmDt: fDate,
                toDt: tDate,
                rptType:_rptType,
                RMANo: _RMANo,
                waybill: _waybill,
                serialNo: _serialNo,
                partNo: _partNo
            },
            datatype: JSON,
            success: function (data)
            {
                $('#filterString').append(data.filterString);

                if (!isSingleRow)
                {
                    var columnDef = [
                        { "data": "Program", "title": "Program", "width": "70px"},
                        { "data": "ProgramID", "title": "Program ID", "width": "100px", "visible":false },
                        { "data": "ID", "title": "ID", "width": "80px", "visible": false },
                        {
                            "data": "RMA", "title": "RMA No.", "width": "80px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\RO\\Detail?Id=' + row["ID"] + '&custRef=' + row["RMA"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "MessageID", "title": "Message Id", "width": "70px" },
                        { "data": "ReceiveOrder", "title": "RO No.", "width": "70px" },
                        { "data": "RMA_Status", "title": "RMA Status", "width": "100px" },
                        { "data": "Waybill", "title": "Waybill", "width": "80px" },
                        { "data": "DockLogged", "title": "Dock Logged On", "width": "100px", "className": "text-right" },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "110px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "110px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                if (row["SerialNo"] == "*") {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + d + '</a>';
                                }
                                return url;
                            }},
                        { "data": "QtyReceived", "title": "Qty Rcvd", "width": "60px", "className": "text-right" },
                        { "data": "SealedBox", "title": "Sealed Box", "width": "70px" },
                        { "data": "Customer", "title": "Customer", "width": "150px" },
                        { "data": "Address", "title": "Address", "visible": false },
                        { "data": "Address", "title": "Address", "render": $.fn.dataTable.render.ellipsisAdr1(23) },
                        { "data": "City", "title": "City", "width": "80px" },
                        { "data": "RO_Created", "title": "RO Created On", "width": "110px", "className": "text-right"},
                        { "data": "RO_LastActivity", "title": "RO Last Activity On", "width": "110px", "className": "text-right" }
                    ];

                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(11).footer()).html(thousands_separators(api.column(11).data().sum()));
                        //$(api.column(9).footer()).html(thousands_separators(api.column(9).data().sum()));
                        //$(api.column(10).footer()).html(thousands_separators(api.column(10).data().sum()));
                        //$(api.column(5).footer()).html(thousands_separators(api.column(5).data().sum()));
                    }
                    ToggleDataList(true);
                    MakeDataGrid('lstRMAViewerDetail', data.lstRMAViewerDetail, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>

