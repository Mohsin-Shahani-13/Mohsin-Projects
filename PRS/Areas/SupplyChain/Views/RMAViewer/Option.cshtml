@model IP.Areas.SupplyChain.Models.RMAViewer

@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        width: 180px;
    }
</style>
<table class="fullWidth">
    <tr>
        <td class="pad" colspan="4">
            <label>Report Type:</label>
            @Html.DropDownList("rptType", new List<SelectListItem>
                {

                   new SelectListItem{ Text="Summary", Value = "Summary",  },
                   new SelectListItem{ Text="Detail", Value = "Detail" },


                }, new { @id = "rptName", @class = "form-control" })
        </td>
    </tr>

    @*<tr>
            <td colspan="4" class="pad">
                @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
                @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
            </td>
        </tr>*@
    <tr>
        <td colspan="2" class="pad">
            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>

        <td colspan="2" class="pad">
            <strong> To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
    </tr>
    <tr id="RMABox">
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.RMANo, htmlAttributes: new { @class = "col-4 col-form-lable" })
            <input type="text" class="form-control textBox" id="RMANo" name="RMANo" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr id="waybillBox" class="hidden">
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.waybill, htmlAttributes: new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control textBox" id="waybill" name="waybill" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr id="partNoBox" class="hidden">
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.partNo, htmlAttributes: new { @class = "col-4 col-form-lable" })
            <input type="text" class="form-control textBox" id="partNo" name="partNo" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr id="serialNoBox" class="hidden">
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.serialNo, htmlAttributes: new { @class = "col-4 col-form-lable" })
            <input type="text" class="form-control textBox" id="serialNo" name="serialNo" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
</table>
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<script>

    $('#rptName').change(function () {
        var rptType = $('#rptName option:selected').text();
        if (rptType == 'Detail') {

            $('#waybillBox').removeClass('hidden');
            $('#partNoBox').removeClass('hidden');
            $('#serialNoBox').removeClass('hidden');
            $('.textBox').val("");
        }
        else {
            $('#waybillBox').addClass('hidden');
            $('#partNoBox').addClass('hidden');
            $('#serialNoBox').addClass('hidden');
            $('.textBox').val("");
        }
    });
    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 1);
        var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var someFormattedDate = y + '.' + mm + '.' + dd;
        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker
        ({
            format: 'yyyy.mm.dd',
            autoclose: true,
            //startDate: '-365d',
            //endDate: maxDate
        });

    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });

    function OptionsIsValid() {
        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();




        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }
    }

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    };

    function Go() {

        //var programId = $('#ddProgram').val();
        //var ProgramName = $('#ddProgram option:selected').text();
        var rptType = $('#rptName option:selected').text();
        //var isAllDate = $('#isAllDate').is(':checked');
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var RMANo = $('#RMANo').val();
        var waybill = $('#waybill').val();
        var partNo = $('#partNo').val();
        var serialNo = $('#serialNo').val();

        $('#option').modal('hide');

        if (rptType == "Summary") {

            //for Summary
            OpenPage('\\SupplyChain\\RMAViewer\\Summary?frmDt=' + fDate + ' &toDate=' + tDate + '&rptType=' + rptType + '&RMANo=' + RMANo + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
        }
        else {

            //for Detail
            OpenPage('\\SupplyChain\\RMAViewer\\Detail?frmDt=' + fDate + ' &toDate=' + tDate + '&rptType=' + rptType + '&RMANo=' + RMANo + '&waybill=' + waybill + '&partNo=' + partNo + '&serialNo=' + serialNo + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
        }

    }

</script>

