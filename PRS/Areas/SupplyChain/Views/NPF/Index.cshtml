@model IP.Areas.SupplyChain.Models.NPF
@{
    ViewBag.Title = "Index";
    Layout = null;
}


<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstNPF" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    @*<tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>*@
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var _programId = $('#ddProgram').val();
        var _ProgramName = $("#ddProgram option:selected").text();
        var partNo = $('#partNo').val();
        var serialNo = $('#serialNo').val();
        var orderno = $('#orderno').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/NPF/GetList',
            data: {
                frmDt: fDate,
                toDt: tDate,
                programId: _programId,
                ProgramName: _ProgramName,
                partNo: partNo,
                serialNo: serialNo,
                orderno: orderno
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "Program ID", "width": "40px", "visible": false },
                        { "data": "ProgramName", "title": "Program", "width": "70px" },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "100px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&Programid=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "PartDesc", "title": "Part No. Desc.", "width": "250px" },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "80px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                if (row["HAS_SN"] == 'N' || row["SerialNo"] == "*") {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&Programid=' + row["ProgramID"] + '&partno=' + row["PartNo"] + '&page=list" target=_blank > ' + d + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "Id", "title": "Order No.", "width": "70px" },
                        { "data": "Code", "title": "Fault Code", "width": "80px" },
                        { "data": "Description", "title": "Fault Description", "width": "280px" },
                        { "data": "FromWorkStation", "title": "From WorkStation", "width": "100px" },
                        { "data": "ToWorkStation", "title": "To WorkStation", "width": "100px" },
                        { "data": "LastActivityDate", "title": "Last Activity On", "width": "90px", "className": "text-right" }

                    ]
                    //For Displaying  Footer Sum
                    //var footerfunc = function () {
                    //    var api = this.api();
                    //    $(api.column(8).footer()).html(thousands_separators(api.column(8).data().sum()));
                    //}

                    ToggleDataList(true);
                    MakeDataGrid('lstNPF', data.lstNPF, 0, columnDef, true, true);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>

