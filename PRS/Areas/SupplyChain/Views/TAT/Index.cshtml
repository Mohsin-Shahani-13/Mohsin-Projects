@model IP.Areas.SupplyChain.Models.TAT
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">
            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstTAT" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                @*<tfoot>
                        <tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </tfoot>*@
            </table>
        </div>
    </div>
</div>
<script>
   

    var COLUMN_FORMAT =
    {
        formatDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(4));
        },
        formatTwoDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(2);
        },
        formatNumber: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(0));
        },

        formatNumberForZero: function (data, type, row) {
            var val = +data;
            return val === "0" ? '' : val.toFixed(0);
        },

    };
    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();
        $('#option').modal('hide');

        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var _ProgramId = $('#ddProgram').val();
        var _ProgramName = $("#ddProgram option:selected").text();

        $.ajax
            ({
                cache: false,
                type: 'GET',
                url: '/TAT/GetList',
                data:
                {
                    frmDt: fDate,
                    toDt: tDate,
                    ProgramID: _ProgramId,
                    ProgramName: _ProgramName
                },
                datatype: JSON,
                success: function (data) {
                    $('#filterString').append(data.filterString);

                    var columnDef = [


                        { "data": "ProgramID", "title": "ProgramId", "width": "40px", "visible": false },
                        { "data": "PartTransaction", "title": "Part Transaction", "width": "100px" },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "90px", 
                            render: function (data, type, row) {
                                var d = data.toString();
                               
                                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + d + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "CustomerReference", "title": "Customer Ref." },
                        { "data": "ROAttributeValue", "title": "RO Attribute Value", "width": "130px", "className": "text-center" },
                        { "data": "SOAttributeValue", "title": "SO Attribute Value", "width": "130px", "className": "text-center" },
                        { "data": "MovePartSerialize", "title": "Move Part Serialize", "width": "130px", "className": "text-center" },
                        { "data": "PreviousLocation", "title": "Previous Location", "width": "150px" },

                        { "data": "CurrentLocation", "title": "Current Location" },
                        { "data": "TranBy", "title": "Tran. By", "width": "120px" },
                        { "data": "ReceiptDate", "title": "Receipt Date", "width": "110px", "className": "text-right" },
                        { "data": "PreviousTransactionDate", "title": "Prev. Tran. Date", "width": "130px", "className": "text-right" },
                        { "data": "TranDate", "title": "Tran. Date", "width": "110px", "className": "text-right"  },
                     
                        {
                            "data": "TATDays", "title": "TAT Days", "width": "60px", "className": "text-right",
                            render: function (data, type, row) {

                                var val = COLUMN_FORMAT.formatNumberForZero(data);
                                return val;
                            }
                        
                        },
                        {
                            "data": "TotalTATDays", "title": "Total TAT Days", "width": "100px", "className": "text-right",
                            render: function (data, type, row) {

                                var val = COLUMN_FORMAT.formatNumberForZero(data);
                                return val;
                            }
                        },

                    ];


                    ToggleDataList(true);
                    MakeDataGrid('lstTAT', data.lstTAT, 0, columnDef, true, true, false);

                    if (data["ErrorMessage"] != null) {
                        $('.dataTables_empty > p').text(data["ErrorMessage"]);
                    }
                },
                onerror: function (r) { r },
                failure: function (r) { r }
            });
    }

</script>
