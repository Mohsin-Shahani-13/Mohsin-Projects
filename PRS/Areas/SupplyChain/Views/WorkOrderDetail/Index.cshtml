@model IP.Areas.SupplyChain.Models.WorkOrderDetail
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">
            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstWorkOrderDetail" class="table table-bordered table-striped text-sm table-hover" >
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
            </table>
        </div>
    </div>
</div>
<script>
    ToggleDataList(false);
    LoadData();
    function LoadData()
    {
        $('#tblBody').empty();
        $('#option').modal('hide');

        var programId = $('#ddProgram').val();
        var ProgramName = $('#ddProgram option:selected').text();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var serialNo = $('#serialNo').val();
        var partNo = $('#partNo').val();

        $.ajax
        ({
            cache: false,
            type: 'GET',
            url: '/WorkOrderDetail/GetList',
            data:
            {
                ProgramID: programId,
                ProgramName: ProgramName,
                frmDt: fDate,
                toDate: tDate,
                isAllDate: isAllDate,
                serialNo: serialNo,
                partNo: partNo
            },
            datatype: JSON,
            success: function (data)
            {
                $('#filterString').append(data.filterString);

                var columnDef = [
                    { "data": "ProgramId", "title": "ProgramId", "width": "50px", "visible": false },
                    { "data": "WOHeaderId", "title": "Work Order", "width": "70px" },
                    { "data": "CreateDate", "title": "Created On", "width": "90px", "className": "text-right" },
                    {
                        "data": "PartNo", "title": "Part No.", "width": "100px",
                        render: function (data, type, row) {
                            var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramId"] + '&page=list" target=_blank > ' + data + '</a>';
                            return url;
                        }
                    },
                    {
                        "data": "SerialNo", "title": "Serial No.", "width": "120px",
                        render: function (data, type, row) {
                            var d = data.toString();
                            if (row["HAS_SN"] == 'N' || row["SerialNo"] == "*") {
                                url = row["SerialNo"];
                            }
                            else {
                                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramId"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + d + '</a>';
                            }
                            return url;
                        }
                    },
                    { "data": "PartDesc", "title": "Part Desc.", "width": "230px" },
                    { "data": "Family", "title": "Family", "width": "120px" },
                    { "data": "SecondaryCommodity", "title": "Commodity", "width": "130px" },
                    { "data": "PartType", "title": "Part Type", "width": "90px" },
                    { "data": "WorkStation", "title": "Workstation", "width": "90px" },
                    { "data": "RepairType", "title": "Repair Type", "width": "130px" },
                    { "data": "CompPartNo1", "title": "Comp. Part No. 1", "width": "100px" },
                    { "data": "CompSerialNo1", "title": "Comp. Serial No. 1", "width": "110px" },
                    { "data": "Comp1Commodity", "title": "Comp. 1 Commodity", "width": "140px" },
                    { "data": "CompPartNo2", "title": "Comp. Part No. 2", "width": "100px" },
                    { "data": "CompSerialNo2", "title": "Comp. Serial No. 2", "width": "110px" },
                    { "data": "Comp2Commodity", "title": "Comp. 2 Commodity", "width": "140px" },
                    { "data": "CompPartNo3", "title": "Comp. Part No. 3", "width": "110px" },
                    { "data": "CompSerialNo3", "title": "Comp. Serial No. 3", "width": "110px" },
                    { "data": "Comp3Commodity", "title": "Comp. 3 Commodity", "width": "140px" },
                    { "data": "Grade", "title": "Grade", "width": "50px", "className": "text-center" },
                    { "data": "FGIType", "title": "FGI Type", "width": "80px" },
                    { "data": "Country", "title": "Country", "width": "70px", "className": "text-center" },
                    { "data": "ReidPartNo", "title": "REID Part No.", "width": "90px"},
                    { "data": "ReidSerialNo", "title": "REID Serial No.", "width": "90px" },
                    { "data": "FailDesc", "title": "Failure Desc.", "width": "130px" },
                    { "data": "HoldLoc", "title": "Hold Loc.", "width": "110px" },
                    { "data": "HoldPallet", "title": "Hold Pallet", "width": "80px" },
                    { "data": "PalletAttr", "title": "Pallet Attr.", "width": "80px" },
                    { "data": "WOStatus", "title": "WO Status", "width": "70px", "className": "text-center" }
                ];

                ToggleDataList(true);

               

                MakeDataGrid('lstWorkOrderDetail', data.lstWorkOrderDetail, 0, columnDef, true, true, false);
              
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }

    
</script>
