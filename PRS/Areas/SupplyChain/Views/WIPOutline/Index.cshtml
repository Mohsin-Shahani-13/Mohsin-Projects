@model IP.Areas.SupplyChain.Models.WIPOutline
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<style>
    /*  .modal-body {
        overflow-y: scroll;
        text-overflow: clip;
    }*/
</style>
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">

        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>

        <div class="box-body" id="lstP">
            <table id="lstWIPOutline" class="table table-bordered table-striped text-sm table-hover">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        @if (ViewBag.program == "10032")
                        {
                            <th></th>
                        }



                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                @*<tfoot>
                        <tr>

                        </tr>
                    </tfoot>*@
            </table>
        </div>

    </div>
</div>

<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var ProgramId = $('#ddProgram').val();
        var ProgramName = $("#ddProgram option:selected").text();
        var frmDt = $('#frmDt').val();
        var toDt = $('#toDt').val();
        var custRef = $('#custRef ').val();
        var partNo = $('#partNo').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/WIPOutline/GetList',
            data: {
                ProgramId: ProgramId,
                ProgramName: ProgramName,
                frmDt: frmDt,
                toDt: toDt,
                custRef: custRef,
                partNo: partNo,
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);


                if (ProgramName == "VALVE") {
                    var columnDef = [
                        { "data": "ProgramID", "title": "ProgramID", "width": "100px", "visible": false },
                        { "data": "Name", "title": "Program", "width": "60px"/*, "visible": false */ },
                        { "data": "WOHeaderID", "title": "WO Id", "width": "80px" },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "100px"
                            , render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';

                                return url;
                            }
                        },
                        {
                            "data": "CustomerReference", "title": "Customer Ref.", "width": "80px",
                            render: function (data, type, row) {

                                var url = '<a href= "\\SupplyChain\\WO\\Detail?Id=' + row["Id"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "ThirdPartyReference", "title": "Third Party Ref.", "width": "110px" },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "90px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "Description", "title": "Description", "width": "270px" },
                        { "data": "WorkCenter", "title": "WorkCenter", "width": "120px" },
                        { "data": "WorkStationDesc", "title": "Work Station", "width": "120px" },
                        { "data": "HoldReason", "title": "Hold Reason", "width": "180px" },
                        { "data": "faultcode", "title": "Fault Code", "width": "90px" },
                        { "data": "Fault", "title": "Fault Description", "width": "330px" },
                        { "data": "User", "title": "Created By", "width": "100px" },
                        { "data": "CreateDate", "title": "Created On", "width": "90px", "className": "text-right" },
                        { "data": "LastActivityDate", "title": "Last Activity On", "width": "90px", "className": "text-right" },
                        { "data": "DaysAtLoc", "title": "Days At Loc.", "width": "100px", "className": "text-right" },
                        { "data": "DaysInWIP", "title": "Days In WIP", "width": "100px", "className": "text-right" },
                        { "data": "WorkingDaysInWip", "title": "Working Days In WIP", "width": "120px", "className": "text-right" },

                    ]
                }
                else {
                    var columnDef = [
                        { "data": "ProgramID", "title": "ProgramID", "width": "100px", "visible": false },
                        { "data": "Name", "title": "Program", "width": "60px"/*, "visible": false */ },
                        { "data": "WOHeaderID", "title": "WO Id", "width": "80px" },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "100px"
                            , render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';

                                return url;
                            }
                        },
                        {
                            "data": "CustomerReference", "title": "Customer Ref.", "width": "80px",
                            render: function (data, type, row) {

                                var url = '<a href= "\\SupplyChain\\WO\\Detail?Id=' + row["Id"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "ThirdPartyReference", "title": "Third Party Ref.", "width": "110px" },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "90px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "Description", "title": "Description", "width": "270px" },
                        { "data": "WorkCenter", "title": "Work Center", "width": "120px" },
                        { "data": "WorkStationDesc", "title": "Work Station", "width": "120px" },
                        //{ "data": "HoldReason", "title": "Hold Reason", "width": "180px" },
                        { "data": "faultcode", "title": "Fault Code", "width": "90px" },
                        { "data": "Fault", "title": "Fault Description", "width": "330px" },
                        { "data": "User", "title": "Created By", "width": "100px" },
                        { "data": "CreateDate", "title": "Created On", "width": "90px", "className": "text-right" },
                        { "data": "LastActivityDate", "title": "Last Activity On", "width": "90px", "className": "text-right" },
                        { "data": "DaysAtLoc", "title": "Days At Loc.", "width": "100px", "className": "text-right" },
                        { "data": "DaysInWIP", "title": "Days In WIP", "width": "100px", "className": "text-right" },
                        { "data": "WorkingDaysInWip", "title": "Working Days In WIP", "width": "120px", "className": "text-right" },

                    ]
                }


                //For Displaying  Footer Sum
                var footerfunc = function () {
                    var api = this.api();
                    //$(api.column().footer()).html(thousands_separators(api.column().data().sum()));

                }

                ToggleDataList(true);
                MakeDataGrid('lstWIPOutline', data.lstWIPOutline, 0, columnDef, true, true, false);

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }


</script>

