@model IP.Areas.SupplyChain.Models.VALVEComponentUsage
@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }

    .padding {
        padding-top: 20px;
    }

    .ischecked {
        padding-top: 42px;
        padding-left: 20px;
    }
</style>

<table class="fullWidth" cellpadding="10" cellspacing="10">
    @*<tr>
            <td colspan="4" class="pad">
                @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
                @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
            </td>
        </tr>*@
    <tr>
        <td colspan="4" class="pad">
            @Html.Action("GetProgramBySite", "Home", new { id = "ProgramID", @name = "ProgramID", area = "" })
        </td>
    </tr>


    <tr>
        <td class="pad">
            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
    </tr>
    <tr>
        <td class="pad" colspan="4">
            <label>Status:</label>
            @Html.DropDownList("Status", new List<SelectListItem>
                {
                    new SelectListItem{ Text="REPAIR", Value = "15" },
                    new SelectListItem{ Text="WIP", Value = "19",  },
                    new SelectListItem{ Text="HOLD", Value = "28" },




                }, new { @id = "Status", @class = "form-control" })
        </td>
    </tr>
  

</table>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>

<script>
    $('#option').on('shown.bs.modal', function () {
        $('#partNo').focus();
    });
    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });


    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {

        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate() - 1);

        var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        //var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-365d',
        endDate: '-1d'
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    function OptionsIsValid() {
        $('#lblMsg').empty();

        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
       
        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
       
        else {
            $('#lblMsg').empty();
            return true;
        }
    }

    function Go() {

        var programId = $('#ProgramID').val();
        var ProgramName = $("#ProgramID option:selected").text();
        var fromDt = $('#fromDt').val();
        var toDt = $('#toDt').val();
        var statusId = $('#Status option:selected').val();
        var status = $('#Status option:selected').text();
        

        $('#option').modal('hide');
        OpenPage('\\SupplyChain\\VALVEComponentUsage\\Index?fromDt=' + fromDt + ' &toDt=' + toDt + '&statusId=' + statusId + '&status=' + status + '&ProgramID=' + programId + '&ProgramName=' + ProgramName +  '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
    }
</script>