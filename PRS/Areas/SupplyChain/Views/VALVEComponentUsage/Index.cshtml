@model IP.Areas.SupplyChain.Models.VALVEComponentUsage
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>


            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstVALVEComponentUsage" class="table table-bordered table-striped text-sm table-hover" @*style="width:100%"*@>
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');

        var isSingleRow = false;
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();
        var fromDt = $('#fromDt').val();
        var toDt = $('#toDt').val();
        var statusId = $('#Status option:selected').val();
        var status = $('#Status option:selected').text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/VALVEComponentUsage/GetList',
            data: {
                programId: _programId,
                ProgramName: _ProgramName,
                fromDt: fromDt,
                toDt: toDt,
                statusId: statusId,
                status: status

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [


                        { "data": "ID", "title": "ProgramID", "width": "40px", "visible": false },
                        { "data": "ProgramName", "title": "Program", "width": "50px", "visible": false },
                        { "data": "RepairedDate", "title": "Repaired On", "width": "70px", "className": "text-right" },
                        {
                            "data": "REIDPartnumber", "title": "REID Part No.", "width": "90px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["REIDPartnumber"] + '&ProgramId=' + row["ID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "UnitSerialNumber", "title": "Unit Serial No. ", "width": "70px"
                        },
                        {
                            "data": "ComponentPartNumber", "title": "Comp. Part No. ", "width": "90px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["ComponentPartNumber"] + '&ProgramId=' + row["ID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "Status", "title": "Status", "width": "60px" },
                        { "data": "ComponentDescription", "title": "Comp. Desc. ", "width": "250px" },
                        {
                            "data": "ComponentNewSerialNumber", "title": "Comp. New Serial No. ", "width": "70px"
                        },
                        {
                            "data": "ComponentOldSerialNumber", "title": "Comp. Old Serial No. ", "width": "70px"
                        },
                        { "data": "DateComponentReplaced", "title": "Comp. Replaced On", "width": "120px", "className": "text-right" },
                        { "data": "ComponentState", "title": "Comp. State ", "width": "110px" },
                        { "data": "ComponentConfiguration", "title": "Comp. Config. ", "width": "80px" },
                        { "data": "OrderType", "title": "Order Type ", "width": "110px" },
                        { "data": "Faultcode", "title": "Fault Code ", "width": "60px" },
                        { "data": "FaultDescription", "title": "Fault Desc. ", "width": "110px" },
                        { "data": "ComponentRepairDescription", "title": "Comp. Repair Desc.", "width": "110px" },
                        { "data": "ValveReference", "title": "Valve Ref. ", "width": "90px" },
                        {
                            "data": "IncomingPartnumber", "title": "Incoming Part No. ", "width": "100px"
                        }
                    ]

                    ToggleDataList(true);
                    MakeDataGrid('lstVALVEComponentUsage', data.lstVALVEComponentUsage, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>