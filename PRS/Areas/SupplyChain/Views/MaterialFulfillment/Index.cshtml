@model IP.Areas.SupplyChain.Models.MaterialFulfillment

@{
    ViewBag.Title = "Index";
    Layout = null;
}

<style>
    .Part_Undrln {
        text-decoration: underline;
    }

    .leftsection {
        text-align: center;
        padding-top: 50px;
        height: 25%;
    }
</style>

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="row">
            <div class="col-md-7">
                <div class="box-header with-border bg-blue-gradient">
                    <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                        <span class="fa fa-filter fa-lg white"></span>
                    </button>
                    <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
                    <div id="buttons" class="box-tools pull-right">

                    </div>
                </div>
                <div class="box-body" id="lstP">
                    <table id="lstMaterialFulfillment" class="table table-bordered table-striped text-sm table-hover" width="100%">
                        <thead class="sorted-asc">
                            <tr>
                                <th class="notexport"></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="tblBody"></tbody>
                        <tfoot>
                            <tr>
                                <th></th>
                                <th style="text-align:left;">Total:</th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div id="left_panel_Bottom" class="col-md-5">
                <div id="left_bot_section" class="box panel panel-default leftsection" style="height:100%">
                    <h4>Click hyperlinks on left section to load Serial No.</h4>
                </div>
            </div>
        </div>
    </div>
</div>



<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;



        var _programId = $('#ddProgram').val();
        var _ProgramName = $("#ddProgram option:selected").text();
        var _reference = $('#reference').val();
        var _orderType = $("#ddOrderType option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/MaterialFulfillment/GetList',
            data: {
                programID: _programId,
                programName: _ProgramName,
                orderType: _orderType,
                reference: _reference
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "ProgramID", "visible": false },
                        { "data": "CreateDate", "title": "Create Date", "width": "90px", "className": "text-right" },
                        {
                            "data": "Reference", "title": "Reference", 
                            render: function (data, type, row) {
                                url = '<a href="#" class="Part_Undrln" onclick="OpenView(\'\\\\SupplyChain\\\\MaterialFulfillment\\\\Detail?reference=' + data + '&programID=' + _programId + '\',\'left_panel_Bottom\')">' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "100px",

                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "QtyToShip", "title": "Qty To Ship", "width": "70px", "className": "text-right" },
                        { "data": "OrderType", "title": "Order Type", "width": "100px" },
                        { "data": "Fulfilled", "title": "Fulfilled", "width": "70px", "className": "text-right" },
                        { "data": "LastActivity", "title": "Last Activity On", "width": "100px", "className": "text-right" },
                        { "data": "Priority", "title": "Priority", "width": "60px", "className": "text-right" }
                    ];

                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(4).footer()).html(thousands_separators(api.column(4, { search: 'applied' }).data().sum()));
                    }

                    ToggleDataList(true);
                    MakeDataGrid('lstMaterialFulfillment', data.lstMaterialFulfillment, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>





