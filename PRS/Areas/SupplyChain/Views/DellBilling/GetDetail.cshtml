        $('#currentDt').val(date);
        $('#invNo').val(randomNumber);

       @*var programID = '@ViewBag.programID';
        var trackingNo = '@ViewBag.trackingNo';*@
        var trackingNo = $('#trackingNo').val();
        var programID = $('#ddProgram').val();

        if (trackingNo != '') {

        $.ajax({
            cache: false,
            type: 'GET',
            url: '/DellBilling/GetInvoice',
            data:
            {
                programID: programID,
                trackingNo: trackingNo
            },

            datatype: JSON,
            success: function (data) {





                var staticFields = data.model;
                // Populate static fields
                $('#poNumber').html(staticFields.PO_NUMBER);
                $('#terms').html(staticFields.TERMS);
                $('#shipDate').html(staticFields.SHIP);
                $('#tracking').html(staticFields.TRACKING);

                // Populate invoice items
                var items = data.item; // Assuming Items is an array of objects
                //console.log(data)
                //console.log(items)

                var html = '';
                var totalAmount = 0;
                var totalQty = 0;

                $.each(items, function (index, item) {
                    // Access the properties using the correct capitalization
                    var qty = parseFloat(item.Qty) || 0;
                    var commodity = item.Commodity;
                    var warrantyCode = item.WarrantyCode;
                    var shipType = item.ShipType;
                    var cost = parseFloat(item.Cost) || 0;
                    var amount = parseFloat(item.Amount) || 0;
                    var formattedAmount = formatNumberWithThousandSeparator(amount);

                    html += '<tr>';
                    html += '<td style="text-align:right;">' + qty + '</td>';
                    html += '<td>' + commodity + '</td>';
                    html += '<td>' + warrantyCode + '</td>';
                    html += '<td>' + shipType + '</td>';
                    html += '<td style="text-align:right;">' + cost.toFixed(2) + '</td>';
                    html += '<td style="text-align:right;">' + formattedAmount + '</td>';
                    html += '</tr>';

                    totalQty += qty;
                    totalAmount += amount;
                });
                //console.log(totalAmount)
                var formattedtotalAmount = formatNumberWithThousandSeparator(totalAmount.toFixed(2))
                // Append rows to table body
                $('#invoiceItemsBody').html(html);

                /// Create the total row dynamically with a thick border
                var totalRow = '<tr id="totalRow" style="border: 2px black; font-weight:bold;">';

                totalRow += '<td colspan="5" style="text-align: right;">Total:</td>';
                totalRow += '<td style="text-align: right;">$' + formattedtotalAmount + '</td>'; // Total Amount aligned under Amount column
                totalRow += '</tr>';

                // Append the total row to the table body
                $('#invoiceItemsBody').append(totalRow);
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
        }
    }
    function getCurrentDate() {
        const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, '0'); // Months are zero-based
        const day = String(today.getDate()).padStart(2, '0');

        return `${month}/${day}/${year}`;
    }
    function showMessage(message, type) {
        var messageContainer = $('#messageContainer');
        var messageBox = $('#message');
        messageBox.text(message);
        messageBox.removeClass().addClass('alert alert-' + (type === 'error' ? 'danger' : 'success'));
        messageContainer.show();
        setTimeout(function () {
            messageContainer.hide();
        }, 3000);
    }
    function formatNumberWithThousandSeparator(number) {
        return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }
    function validateInvNo(invoiceNo, callback) {

        var _invNo = invoiceNo
        $.ajax({
            cache: false,
            type: 'GET',
            url: '/DellBilling/ValidateInvNo',
            data: {
                invNo: _invNo
            },
            datatype: JSON,
            success: function (data) {
                console.log(data.response)
                if (data.response === false) {
                    callback(false);
                } else {
                    callback(true);
                }
            },
            onerror: function (r) { callback(false); },
            failure: function (r) { callback(false); }
        });
    }
    function ExportExcel(programID, trackingNo) {

        $.ajax({
            cache: false,
            type: 'GET',
            url: '/DellBilling/ExportToExcel',
            data: {
                programId: programID,
                trackingNo: trackingNo
            },
            dataType: 'json',
            success: function (data) {
                if (!data.ErrorMessage) {
                    showMessage("Line added successfully!", "success");
                } else {
                    showMessage("Error adding line.", "error");
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }

