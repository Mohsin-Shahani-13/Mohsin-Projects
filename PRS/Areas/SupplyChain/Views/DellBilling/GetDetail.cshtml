                            <button onClick="saveExtraLines()" id="generateInvoice" class="btn btn-success btn-sm mr-2" title="Click to generate Invoice...">
                                Generate Invoice
                            </button>
                            <button class="btn btn-default btn-sm" data-dismiss="modal" id="cancelInv">Cancel</button>
                        </div>
                    </div>`;

        // Initialize the modal with static backdrop and keyboard options
