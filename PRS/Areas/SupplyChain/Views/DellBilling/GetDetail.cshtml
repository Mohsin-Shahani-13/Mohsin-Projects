<script>
    $(document).ready(function () {


        // Add the modal HTML to the DOM
        addSecondModal();

        // Focus on partNumber input when the second modal is shown
        $('.second-modal-content').on('shown.bs.modal', function () {
            $('#partNumber').focus();
        });

        // Clear the extraLinesTableBody when the Invoice modal is hidden
        $('#Invoice').on('hidden.bs.modal', function () {
            $('#extraLinesTableBody').empty();
            $('#extraLinesTable').addClass('extraLinesTable');
        });

        // Initialize date pickers
        $('.date-picker').each(function () {
            $(this).datepicker({
                format: 'mm/dd/yyyy', // Adjust format as needed
                autoclose: true
                // Add any other options here if needed
            });
        });

        // Load initial data
        ToggleDataList(false);
        LoadData();

        //$('#generateInvoice').click(function () {
        //    alert('working');
        //    saveExtraLines();
        //});

        // Clear extra lines table when cancelInv button is clicked
        $('#cancelInv').click(function () {
            $('#extraLinesTableBody').empty();
            $('#extraLinesTable').addClass('extraLinesTable');
        });
    });
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');

        var _programId = $('#ddProgram').val();
        var _programName = $("#ddProgram option:selected").text();
        var _trackingNo = $('#trackingNo').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/DellBilling/GetDetailList',
            data: {
                programId: _programId,
                programName: _programName,
                trackingNo: _trackingNo

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                var columnDef = [
                    { "data": "ProgramID", "title": "ProgramID", "width": "50px", "visible": false },
                    { "data": "Program", "title": "Program", "width": "50px", "visible": false },
                    { "data": "Ship Order", "title": "SO", "width": "50px" },
                    { "data": "Tracking Number", "title": "Tracking No.", "width": "150px" },
                    { "data": "ShipmentDate", "title": "Shipment Date", "width": "80px", "className": "text-right" },
                    { "data": "Carrier", "title": "Carrier", "width": "60px" },
                    { "data": "Commodity", "title": "Commodity", "width": "130px" },
                    { "data": "Dell Charge Code", "title": "Dell Charge Code", "width": "120px", "visible": false },
                    { "data": "SHIP TYPE", "title": "Ship Type", "width": "60px" },
                    { "data": "Brand", "title": "Brand", "width": "60px" },
                    { "data": "Model", "title": "Model", "width": "60px" },
                    { "data": "Receive Order", "title": "RO", "width": "60px" },
                    // { "data": "QTY", "title": "Qty", "width": "60px", "className": "text-right" },
                    {
                        "data": "Serial Number", "title": "Serial No.", "width": "120px",
                        render: function (data, type, row) {
                            var d = data.toString();
                            var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["Serial Number"] + '&Programid=' + row["ProgramID"] + '&partno=' + row["Model"] + '&page=list" target=_blank > ' + d + '</a>';

                            return url;
                        }
                    },
                    { "data": "Charge Type", "title": "Charge Type", "width": "80px" },
                    { "data": "Reference", "title": "Reference", "width": "200px" },
                    { "data": "Bill Description", "title": "Bill Description", "width": "450px" },
                    { "data": "Price", "title": "Price", "width": "70px", "className": "text-right" },
                    { "data": "BillDate", "title": "Bill Date", "width": "70px", "className": "text-right", "visible": false },
                    { "data": "Wty Code", "title": "Wty. Code", "width": "80px" },
                    // { "data": "Inv Number", "title": "Inv. No.", "width": "100px", "visible": false },
                    { "data": "Revenue Date", "title": "Revenue Date", "width": "80px", "className": "text-right" },
                    //{
                    //    "data": "Invoice",
                    //    "title": "Invoice",
                    //    "className": "text-center notexport",
                    //    "width": "50px",
                    //    "render": function (data, type, row) {
                    //        var programID = row["ProgramID"];
                    //        var trackingNumber = row["Tracking Number"];
                    //        var url = '<button class="btn btn-secondary btn-xs" onclick="Invoice(\'' + programID + '\', \'' + trackingNumber + '\')"><i class="fas fa-file-invoice" style="font-size: 18px; color: crimson"></i></button>';
                    //        return url;
                    //    }
                    //}
                ];
                ToggleDataList(true);

                //For Displaying  Footer Sum
                //var footerfunc = function () {
                //    var api = this.api();
                //    $(api.column(11).footer()).html(thousands_separators(api.column(11, { search: 'applied' }).data().sum()));
                //}
                MakeDataGrid('lstDellBillingDetail', data.lstDellBillingReport, 0, columnDef, true, true, false);


                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }

    // Function to insert the modal HTML into the DOM
    function addSecondModal() {
        var modalHtml = `
    <div id="secondModal" class="second-modal">
        <div class="second-modal-content">
            <span class="second-modal-close" style="margin-bottom:-2px">&times;</span>
            <form id="addExtraLinesForm">
                <h4 style="text-align:center;">Add Extra Lines</h4>
                <div class="form-group row">
                    <label for="partNumber" class="col-sm-3 col-form-label">Part Number:</label>
                    <div class="col-sm-9" style="">
                        <input type="text" class="form-control" id="partNumber" name="partNumber">
                    </div>
                </div>
                <div class="form-group row">
                    <label for="quantity" class="col-sm-3 col-form-label">Quantity:</label>
                    <div class="col-sm-3">
                        <input type="number" class="form-control" id="quantity" name="quantity">
                    </div>
                    <label for="cost" class="col-sm-3 col-form-label" style="text-align:center;">Cost:</label>
                    <div class="col-sm-3">
                        <input type="number" class="form-control" id="cost" name="cost">
                    </div>
                </div>
                <div class="form-group row">
                    <label for="description" class="col-sm-3 col-form-label">Description:</label>
                    <div class="col-sm-9">
                        <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-sm-12 text-right">
                        <button type="button" class="btn btn-primary" id="saveExtraLineBtn">Add line</button>
                    </div>
                </div>
                <div id="messageContainer" class="form-group row" style="display:none;">
                    <div class="col-sm-12">
                        <div id="message" class="alert"></div>
                    </div>
                </div>
            </form>
        </div>
    </div>
    `;

        // Append the modal HTML to the body
        $('#Invoice').append(modalHtml);

        // Add event listeners
        $('#addExtraLinesBtn').click(function () {
            $('#secondModal').show();
            // Clear the modal fields when opening
            $('#partNumber').val('');
            $('#quantity').val('');
            $('#cost').val('');
            $('#description').val('');
            $('#saveExtraLineBtn').data('editMode', false); // Set to add mode
        });

        $('.second-modal-close').click(function () {
            $('#secondModal').hide();
        });

        $('#saveExtraLineBtn').click(function () {
            var partNumber = $('#partNumber').val().trim();
            var quantity = $('#quantity').val().trim();
            var cost = $('#cost').val().trim();
            var description = $('#description').val().trim();
            var editMode = $(this).data('editMode');
            var editIndex = $(this).data('editIndex');

            // Validate the inputs
            if (partNumber == "" || quantity == "" || description == "") {
                showMessage("All fields are required.", "error");
                return;
            }

            if (editMode) {
                // Update existing row
                updateExtraLine(editIndex, partNumber, quantity, cost, description);
            } else {
                $('#extraLinesTable').removeClass('extraLinesTable');
                // Add new row
                addExtraLine(partNumber, quantity, cost, description);
            }

            // Close the modal
            $('#secondModal').hide();
        });
    }

    // Function to add a new row to the extra lines table
    function addExtraLine(partNumber, quantity, cost, description) {
        var amount = quantity * cost;
        var formattedAmount = formatNumberWithThousandSeparator(amount);

        var newRow = `
    <tr>
        <td style="width:0px;">
            <a type="button" class="btn btn-secondary btn-sm editBtn"><i class="fas fa-edit"></i></a>
        </td>
         <td style="width:0px;">
            <a type="button" class="btn btn-secondary btn-sm deleteBtn" style="color:#b22222;"><i class="fas fa-trash"></i></a>
        </td>
        <td style="width:6px; text-align:right;">${quantity}</td>
        <td>${partNumber}</td>
        <td>${description}</td>
        <td style="width:5px;text-align:right;">${cost}</td>
        <td class="hidden" style="width:5px;text-align:right;">${amount}</td>
        <td style="width:5px;text-align:right;">${formattedAmount}</td>
    </tr>
    `;
        $('#extraLinesTableBody').append(newRow);
    }

    // Delegate the click event for the edit button
    $('#extraLinesTableBody').on('click', '.editBtn', function () {
        var row = $(this).closest('tr');
        var index = row.index();
        var quantity = row.find('td').eq(2).text();
        var partNumber = row.find('td').eq(3).text();
        var description = row.find('td').eq(4).text();
        var cost = row.find('td').eq(5).text();


        // Populate the modal with the row data
        $('#quantity').val(quantity);
        $('#partNumber').val(partNumber);
        $('#description').val(description);
        $('#cost').val(cost);

        // Show the modal
        $('#secondModal').show();


        // Set the save button to edit mode
        $('#saveExtraLineBtn').data('editMode', true);
        $('#saveExtraLineBtn').data('editIndex', index);
    });

    // Delegate the click event for the delete button
    $('#extraLinesTableBody').on('click', '.deleteBtn', function () {
        var row = $(this).closest('tr');

        // Remove the row from the table
        row.remove();
    });
    // Function to update an existing row in the extra lines table
    function updateExtraLine(index, partNumber, quantity, cost, description) {
        var row = $('#extraLinesTableBody').find('tr').eq(index);
        row.find('td').eq(2).text(quantity);
        row.find('td').eq(3).text(partNumber);
        row.find('td').eq(4).text(description);
        row.find('td').eq(5).text(cost);
        row.find('td').eq(7).text(cost * quantity);
    }


    function saveExtraLines() {
        var invNo = $('#invNo').val();
        var invDate = $('#currentDt').val();
        var _trackingNo = $('#trackingNo').val();
        var _programId = $('#ddProgram').val();

        if (invNo == '' || invNo == null) {

            $('#lblMsg').empty();
            $('#lblMsg').append("Please enter invoice no.");
            return false;
        }

        validateInvNo(invNo, function (isValid) {
            if (!isValid) {

                $('#lblMsg').empty();
                $('#lblMsg').append("This invoice is already exist");
                return false;
            }

            else {
                $('#lblMsg').empty();
                var extraLinesData = [];

                // Loop through each row of the table
                $('#extraLinesTableBody tr').each(function () {
                    var row = $(this);
                    var lineData = {

                        partNumber: row.find('td').eq(3).text(),
                        quantity: row.find('td').eq(2).text(),
                        description: row.find('td').eq(4).text(),
                        extraLineCost: row.find('td').eq(5).text(),
                        extraLineAmount: row.find('td').eq(6).text()
                    };
                    extraLinesData.push(lineData);
                });

                $.ajax({
                    cache: false,
                    type: 'POST',
                    url: '/DellBilling/SaveExtraLine',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        InvNo: invNo,
                        InvDate: invDate,
                        programId: _programId,
                        trackingNo: _trackingNo,
                        ExtraLinesData: extraLinesData
                    }),
                    dataType: 'json',
                    success: function (data) {
                        if (!data.ErrorMessage) {
                            showMessage("Line added successfully!", "success");
                            window.location.href = '/DellBilling/ExportToExcel?programId=' + _programId + '&trackingNo=' + _trackingNo;
                            $('#Invoice').modal('hide');
                        } else {
                            showMessage("Error adding line.", "error");
                        }
