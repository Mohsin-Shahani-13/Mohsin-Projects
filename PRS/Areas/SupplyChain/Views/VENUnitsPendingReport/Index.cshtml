@model IP.Areas.SupplyChain.Models.VENUnitsPendingReport

@{
    ViewBag.Title = "Index";
    Layout = null;
}
<style>
    tr{
        white-space:nowrap;
    }
</style>
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstVENUnitsPendingReport" class="table table-bordered table-striped text-sm table-hover" width="100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;

        var _programId = $('#ddProgram').val();
        var _programName = $("#ddProgram option:selected").text();
        var _fDate = $('#fromDt').val();
        var _tDate = $('#toDt').val();
        var _venType = $('#venType').val();
        var _venNo = $('#venNo').val();
        var _pendingVen = $("#pendingVen option:selected").text();



        $.ajax({

            cache: false,
            type: 'GET',
            url: '/VENUnitsPendingReport/GetList',
            data: {
                programId: _programId,
                programName: _programName,
                fDate: _fDate,
                tDate: _tDate,
                venType: _venType,
                venNo:_venNo,
                pendingVen: _pendingVen
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ID", "title": "ProgramID", "width": "100px", "visible": false },
                        { "data": "LastActivityDate", "title": "Last Activity On", "width": "100px", "className": "text-right" },
                        { "data": "Customer_PO", "title": "Customer PO", "width": "100px" },
                        { "data": "HAS_SN", "title": "HAS_SN", "visible": false },
                        {
                            "data": "Tracker", "title": "Tracker", "width": "100px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                if (row["Tracker"] == "*" || row["HAS_SN"] == 'N') {
                                    url = row["Tracker"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["Tracker"] + '&ProgramId=' + row["ID"] + '&PartNo=' + row["FRU"] + '&page=list" target=_blank > ' + d + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "RMA", "title": "RMA", "width": "100px" },
                        {
                            "data": "FRU", "title": "FRU", "width": "100px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["FRU"] + '&ProgramId=' + row["ID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        
                        
                        { "data": "VEN_TYPE", "title": "VEN Type", "width": "100px" },
                        { "data": "VEN_COMMENT", "title": "VEN Comment" },
                        { "data": "VEN_NUMBER", "title": "VEN No.", "width": "200px" },
                        { "data": "VEN_IBM_COMMENT", "title": "VEN IBM Comment", "width": "120px" },
                        {
                            "data": "serial", "title": "Serial No.", "width": "150px"
                        },
                        { "data": "CREDIT_NOTE", "title": "Credit Note", "width": "100px" },
                        { "data": "OEM_RETURNED", "title": "OEM Returned", "width": "100px" },
                       
                        { "data": "PENDING_VEN", "title": "Pending VEN", "width": "80px"}
                    ];
                    ToggleDataList(true);
                    MakeDataGrid('lstVENUnitsPendingReport', data.lstVENUnitsPendingReport, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>



