        <td class="pad">

            <strong>RO Received Date From:</strong>
            <div class='input-group date' id='ROReceivedfromDt'>
                @Html.TextBoxFor(model => model.ReceivedfromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
