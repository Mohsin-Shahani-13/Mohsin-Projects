@model IP.Areas.SupplyChain.Models.LinkedTrackersRMA

@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.DISPOSITION, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="DISPOSITION" name="DISPOSITION" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.PartNo, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="partNo" name="partNo" placeholder="Enter Part number(s), separated by commas" autofocus
                   onkeydown="GoOnEnter()" />
        </td>
    </tr>
</table>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
<script>




    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
    $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });



    function OptionsIsValid() {

        $('#lblMsg').empty();

        //var partNo = $('#serialNo').val();

        //if (partNo === '') {
        //    $('#lblMsg').append('Please Enter Part No');
        //    return false;
        //}
        return true;

    }

    function Go() {
    var programId = $('#ddProgram').val();
    var ProgramName = $("#ddProgram option:selected").text();
        var DISPOSITION = $('#DISPOSITION').val();
    var PartNo = $('#partNo').val();

    $('#option').modal('hide');
        OpenPage('\\SupplyChain\\LinkedTrackersRMA\\Index?programID=' + programId + '&programName=' + ProgramName + '&DISPOSITION=' + DISPOSITION + '&partNo=' + PartNo + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
}


</script>


