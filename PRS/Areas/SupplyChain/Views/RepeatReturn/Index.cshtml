<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var programId = '@Request.QueryString["programId"].ToString()';
        var programName = '@Request.QueryString["programName"].ToString()';
        var serialNo = $('#serialNo').val();
        var hasRepaired = $('#hasRepaired').val();
        var hasRepairedText = $("#hasRepaired option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/RepeatReturn/GetList',
            data: {
                frmDt: fDate,
                toDate: tDate,
                isAllDate: isAllDate,
                programId: programId,
                programName: programName,
                serialNo: serialNo,
                hasRepaired: hasRepaired,
                hasRepairedText: hasRepairedText
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                //$.each(data.lstPartsInventory, function (index, row) {

                //if (data.lstPartsInventory.length == 1) {
                //    isSingleRow = true;
                //    MenuHide();
                //    OpenPage('\\ListingReports\\PartInquiry\\Detail?partNo=' + row["partno"] + '&page=detailed');
                //}
                //});

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "Recnum", "title": "Recnum", "width": "40px", "visible": false },
                        { "data": "TranId", "title": "TranId", "width": "40px", "visible": false },
                        { "data": "ProgramId", "title": "ProgramId", "width": "40px", "visible": false },
                        { "data": "PartNo", "title": "Part No.", "width": "60px", "visible": false },
                        { "data": "ProgramName", "title": "Program", "width": "60px" },
                        {
                            "data": "SerialNo", "title": "Serial No.",
                            render: function (data, type, row) {                   
                                if (row["SerialNo"] == '*' || row["HAS_SN"] == 'N') {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= \\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramId"] + '&PartNo=' + row["PartNo"] +'&page=list" target=_blank > ' + data + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "LastPrvWorkStation", "title": " Last Prev. Workstation", "width": "140px" },
                        { "data": "CustomerReference", "title": "Customer Ref.", "width": "90px" },
                        { "data": "ShippedOn", "title": "Last Shipped On", "width": "100px", "className": "text-right" },
                        { "data": "RcvdOn", "title": "Last Rcvd On", "width": "100px", "className": "text-right" },
                        { "data": "Days", "title": "Days", "width": "50px", "className": "text-right" },
                        { "data": "Under30", "title": "< 30", "width": "50px", "className": "text-center" },
                        { "data": "Under60", "title": "< 60", "width": "40px", "className": "text-center" },
                        { "data": "Under90", "title": "< 90", "width": "50px", "className": "text-center" },
                        { "data": "PrevFailCode", "title": "Previous Fail Code  ", "width": "100px", "visible": false },
                        { "data": "CrntFailCode", "title": "Current Fail Code", "width": "90px", "visible": false },
                        { "data": "PrevRetReason", "title": "Previous Return Reason ", "width": "150px", "visible": false },
                        { "data": "CrnRetReason", "title": "Current Return Reason ", "width": "150px", "visible": false },
                        { "data": "PrevFailCode", "title": "Previous ", "width": "100px" },
                        { "data": "CrntFailCode", "title": "Current", "width": "90px" },
                        { "data": "PrevRetReason", "title": "Previous ", "width": "150px" },
                        { "data": "CrnRetReason", "title": "Current ", "width": "150px" },
                        { "data": "PreviousROType", "title": "Previous RO Type", "width": "100px" },
                        { "data": "RepeatReturnCategory", "title": "Repeat Return Category ", "width": "150px" },
                        { "data": "SameFailure", "title": "Same Failure", "width": "60px" },
                        { "data": "ShipTimes", "title": "MROC", "width": "40px", "className": "text-right"},
                        { "data": "RepairedBy", "title": "Repaired By", "width": "90px" },
                        { "data": "RepairedOn", "title": "Repaired On", "width": "90px", "className": "text-right" }

                      
                        //{ "data": "MinOrderId", "title": "Min Order Id", "width": "100px" },
                        //{ "data": "MaxOrderId", "title": "Max Order Id", "width": "100px" },

                    ]
                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                    //    var api = this.api();
                    //    $(api.column(10).footer()).html(thousands_separators(api.column(10).data().sum()));

                    }

                    ToggleDataList(true);
                    MakeDataGrid('lstRepeatReturn', data.lstRepeatReturn, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>
