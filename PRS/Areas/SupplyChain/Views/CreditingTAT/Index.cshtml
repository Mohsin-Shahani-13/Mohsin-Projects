@model IP.Areas.SupplyChain.Models.CreditingTAT
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="row">
            <div class="col-md-4">
                <div class="box-header with-border bg-blue-gradient">
                    <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                        <span class="fa fa-filter fa-lg white"></span>
                    </button>
                    <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
                    @*<div id="buttons" class="box-tools pull-right">

                    </div>*@
                </div>

                <div class="box-body" id="lstP">
                    <table id="lstCreditingTAT" class="table table-bordered table-striped text-sm table-hover" width="100%">
                        <thead class="sorted-asc">
                            <tr>
                                <th class="notexport"></th>
                                <th></th>
                                <th class="notexport">></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="tblBody"></tbody>

                    </table>
                </div>
            </div>
            <div id="left_panel_Bottom" class="col-md-8">
                <div id="left_bot_section" class="box panel panel-default leftsection" style="height:100%">
                    <h4>Click hyperlinks on left section to load Detail.</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var COLUMN_FORMAT =
    {
        formatDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(4));
        },
        formatTwoDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(2);
        },
        formatNumber: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(0));
        },

        formatNumberForZero: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(0);
        },

    };

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var programId = '@Request.QueryString["programId"].ToString()';
        var programName = '@Request.QueryString["programName"].ToString()';

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/CreditingTAT/GetList',
            data: {
                frmDt: fDate,
                toDate: tDate,
                programId: programId,
                programName: programName
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);


                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "ProgramID", "width": "120px", "visible": false },
                        {
                            "data": "ReturnReason", "title": "Return Reason", "width": "80px",
                            render: function (data, type, row) {
                                // Use fDate and tDate directly here
                                var url = '<a href="#" class="Part_Undrln" onclick="OpenView(\'/SupplyChain/CreditingTAT/GetDetail?ProgramID=' + row["ProgramID"] + '&ReturnReason=' + row["ReturnReason"] + '&frmDt=' + encodeURIComponent(fDate) + '&toDt=' + encodeURIComponent(tDate) + '\',\'left_panel_Bottom\')">' + data + '</a>';
                                return url;
                            }
                        },

                        {
                            "data": "TotalHours", "title": "Hours Difference", "width": "100px", "className": "text-right", "className": "text-center", "visible": false,
                            render: function (data, type, row) {
                                if (data <= '48') {
                                    var colorData = '<span style="color:green;font-weight:bolder">' + data + '</span>'
                                }
                                else if (data > '48') {
                                    var colorData = '<span style="color:red;font-weight:bolder">' + data + '</span>'
                                }
                                return colorData;
                            }
                        },
                        { "data": "NDB", "title": "NDB", "width": "120px"  },
                        {
                            "data": "PercentageWithin48Hours", "title": "Percentage Within 48 Hours", "width": "150px", "className": "text-center",
                            render: function (data, type, row) {
                                if (data === '100%') {
                                    var colorData = '<span style="color:green;font-weight:bolder">' + data + '</span>'
                                }
                                else {
                                    var colorData = '<span style="color:red;font-weight:bolder">' + data + '</span>'
                                }
                                return colorData;
                            }
                        },




                    ]


                    ToggleDataList(true);
                    MakeDataGrid('lstCreditingTAT', data.lstCreditingTAT, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>
