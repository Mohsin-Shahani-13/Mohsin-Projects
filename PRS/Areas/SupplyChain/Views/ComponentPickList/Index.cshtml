@model IP.Areas.SupplyChain.Models.ComponentPickList
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstCompPickList" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();
        var compPartNo = $('#compPartNo').val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/ComponentPickList/GetList',
            data: {

                programId: _programId,
                ProgramName: _ProgramName,
                compPartNo: compPartNo,
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ID", "title": "ProgramID", "width": "40px", "visible": false },
                        { "data": "Name", "title": "Program", "width": "70px" },
                        {
                            "data": "componentpartno", "title": "Component Part No.",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["componentpartno"] + '&Programid=' + row["ID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "qtyrequired", "title": "Req. Qty", "width": "40px", "className": "text-right",
                            render: $.fn.dataTable.render.number(',', ' ')
                        },
                        {
                            "data": "qtyavailable", "title": "Avail. Qty", "width": "40px", "className": "text-right",
                            render: $.fn.dataTable.render.number(',', ' ')
                        },
                        { "data": "locationno", "title": "Loc. No.", "width": "160px" },
                        { "data": "LocationGroup", "title": "Loc. Group", "width": "90px" },
                        { "data": "Configuration", "title": "Configuration", "width": "70px" }

                    ];

                    ToggleDataList(true);
                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(3).footer()).html(thousands_separators(api.column(3, { search: 'applied' }).data().sum()));
                        $(api.column(4).footer()).html(thousands_separators(api.column(4, { search: 'applied' }).data().sum()));

                    }
                    MakeDataGrid('lstCompPickList', data.lstCompPickList, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>
