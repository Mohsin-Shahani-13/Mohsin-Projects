<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();
        $('#option').modal('hide');
        var IdleOver = $('#IdleOver').val();
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/WIPAging/GetList',
            data: {
                IdleOver: IdleOver,
                programId: _programId,
                ProgramName: _ProgramName
            },
            datatype: JSON,
            success: function (data) { 
                $('#filterString').append(data.filterString);


                var columnDef = [
                    { "data": "ProgramID", "title": "ProgramID", "width": "100px", "visible": false },
                    { "data": "RO_ID", "title": "RO ID", "visible": false },
                    { "data": "WO_ID", "title": "WO ID", "visible": false },
                    { "data": "SO_ID", "title": "SO ID", "visible": false },
        
                    {
                        "data": "PartNo", "title": "Part No.", "width": "150px",
                        render: function (data, type, row) {
                            var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] +  '&page=list" target=_blank > ' + data + '</a>';
                            return url;
                        }
                    },
                    {
                        "data": "ParentSerialNo", "title": "Parent Serial No.", "width": "130px",
                    render: function (data) {
                        return data;
                    }
                    },
                    {
                        "data": "SerialNo", "title": "Serial No.", "width": "120px",
                        render: function (data, type, row) {
                            if (row["SerialNo"] == "*" || row["HAS_SN"] == 'N') {
                                url = row["SerialNo"];
                            }
                            else {
                                var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                            }
                            return url;
                        }
                    },
                    //{
                    //    "data": "SerialNo", "title": "Serial No.", "width": "130px",
                    //    render: function (data, type, row) {
                    //        var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                    //        return url;
                    //    }
                    //},
                    { "data": "LocationNo", "title": "Location No." },
                    { "data": "LocationGroup", "title": "Location Group"},

                    { "data": "Status", "title": "Status", "width": "90px" },
                    {
                        "data": "RONo", "title": "RO No.", "width": "120px"
                        ,
                        render: function (data, type, row) {
                         
                            var url = '<a href= "\\SupplyChain\\RO\\Detail?ID=' + row["RO_ID"] + '&custRef=' + row["RONo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                            return url;
                        }
                    },
                    {
                        "data": "WONo", "title": "WO No.", "width": "120px"
                        ,
                        render: function (data, type, row) {
                            var url = '<a href= "\\SupplyChain\\WO\\Detail?ID=' + row["WO_ID"] + '&custRef=' + row["WONo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                            return url;
                        }
                    },
                    { "data": "WorkStation", "title": "Work Station", "width": "80px" },
                    {
                        "data": "WOPass", "title": "WO Pass", "width": "80px", "className": "text-center",
                        render: function (data, type, row) {
                            if (data == row["WOPass"]) {
                                var val = data;
                                var str = "";
                                if (val == "1") {

                                    str+= "Y";
                                }
                                if (val == "0") {
                                   
                                    str += "N";
                                        
                                }
                                if (val == "" || val==null) {

                                    str += "";

                                }
                                return str;
                               
                            }
                           
                        }
                      
                    },
                    {
                        "data": "Shippable", "title": "Shippable", "width": "80px", "className": "text-center"
                        , "visible": false
                        //render: function (data, type, row) {
                        //    if (data == row["Shippable"]) {
                        //        var val = data;
                        //        var str = "";
                        //        if (val == "1") {

                        //            str += "Y";
                        //        }
                        //        if (val == "0") {

                        //            str += "N";

                        //        }
                        //        if (val == "" || val == null) {

                        //            str += "";

                        //        }
                        //        return str;

                        //    }

                        //}
                       
                    },
                    {
                        "data": "SONo", "title": "SO No.", "width": "120px", "visible": false
                        //,
                        //render: function (data, type, row) {
                         
                        //    var url = '<a href= "\\SupplyChain\\SO\\Detail?SOHeaderId=' + row["SO_ID"] + '&custRef=' + row["SONo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                        //    return url;
                        //}
                    },


                    { "data": "Username", "title": "Created By", "width": "100px" },
                  // { "data": "CreatedOn", "title": "Created On", "width": "90px", "className": "text-right" },
                    { "data": "LastActivityDate", "title": "Last Activity On", "width": "110px", "className": "text-right" }
                ]

                ToggleDataList(true);
                MakeDataGrid('lstWipAging', data.lstWipAging, 0, columnDef, true, true, false);

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });


    }
</script>