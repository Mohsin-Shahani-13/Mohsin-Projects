@model IP.Areas.SupplyChain.Models.AlcatelShippingReport
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">
            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstAlcatelShipping" class="table table-bordered table-striped text-sm table-hover" >
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>
    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();
        $('#option').modal('hide');

        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var _ProgramId = $('#ddProgram').val();
        var _ProgramName = $("#ddProgram option:selected").text();

        $.ajax
            ({
                cache: false,
                type: 'GET',
                url: '/AlcatelShippingReport/GetList',
                data:
                {
                    frmDt: fDate,
                    toDt: tDate,
                    ProgramID: _ProgramId,
                    ProgramName: _ProgramName
                },
                datatype: JSON,
                success: function (data) {
                    $('#filterString').append(data.filterString);

                    var columnDef = [
                        { "data": "ProgramID", "title": "ProgramID", "width": "40px", "visible": false },
                        { "data": "Program", "title": "Program", "width": "60px" },
                        { "data": "ID", "title": "ID", "width": "30px", "visible": false },
                        {
                            "data": "CustomerReference", "title": "Customer Ref.", "width": "250px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\SO\\Detail?SOHeaderId=' + row["ID"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';

                                return url;
                            }
                        },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "150px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&Programid=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "150px",
                            render: function (data, type, row) {
                                if (row["SerialNo"] == "*" || row["HAS_SN"] == 'N') {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "Configuration", "title": "Configuration", "width": "90px" },
                        { "data": "ThirdPartyReference", "title": "Third Party Ref.", "width": "150px" },
                        { "data": "Status", "title": "Status", "width": "110px" },
                        {
                            "data": "TrackingNo", "title": "Tracking No.", "width": "120px",
                            render: function (data, type, row) {
                                return data;
                            }
                        },
                        { "data": "CustOrderType", "title": "Cust. Order Type", "width": "90px", "className": "text-center" },
                        { "data": "QtyToShip", "title": "To Ship", "width": "50px", "className": "text-right" },
                        { "data": "QtyShipped", "title": "Shipped", "width": "50px", "className": "text-right" },
                        { "data": "Username", "title": "Username", "width": "110px" },
                        {
                            "data": "CreateDate", "title": "Created On", "width": "90px", "className": "text-right",

                        },
                        {
                            "data": "LastActivityDate", "title": "Last Activity On", "width": "90px", "className": "text-right",

                        }
                    ]

                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(11).footer()).html(thousands_separators(api.column(11).data().sum()));
                        $(api.column(12).footer()).html(thousands_separators(api.column(12).data().sum()));

                    }
                    ToggleDataList(true);
                    MakeDataGrid('lstAlcatelShipping', data.lstAlcatelShipping, 0, columnDef, true, true, footerfunc);

                    if (data["ErrorMessage"] != null) {
                        $('.dataTables_empty > p').text(data["ErrorMessage"]);
                    }
                },
                onerror: function (r) { r },
                failure: function (r) { r }
            });
    }

</script>
