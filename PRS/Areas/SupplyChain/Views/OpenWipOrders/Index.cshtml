@model IP.Areas.SupplyChain.Models.OpenWipOrders
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool">
                @*title="Option Page" onclick="$('#option').modal('show');"*@
                <span class="fa fa-list fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">
            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstOpenWipOrders" class="table table-bordered table-striped text-sm table-hover" width="100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<script>


    ToggleDataList(false);
    LoadData();
    function LoadData() {

        $('#tblBody').empty();

        var isSingleRow = false;

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/OpenWipOrders/GetList',
            data: {

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "Program ID", "width": "70px", "visible": false },
                         {
                             "data": "serialNo", "title": "Serial No.", "width": "150px",
                            render: function (data, type, row) {
                                
                                var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["serialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "Workstation", "title": "Current Workstation", "width": "150px" },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "150px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                       
                        { "data": "Aging", "title": "Aging", "width": "80px", "className":"text-right" }
                    ];
                    ToggleDataList(true);

                    MakeDataGrid('lstOpenWipOrders', data.lstOpenWipOrders, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }

</script>



