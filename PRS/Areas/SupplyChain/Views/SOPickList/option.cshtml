@model IP.Areas.SupplyChain.Models.SOPickList
@{
    ViewBag.Title = "option";
    Layout = null;
}

<style>
    .pad {
        padding-bottom: 15px;
        padding: 2px;
        padding-top: 10px;
    }
</style>
<table class="fullWidth" cellpadding="10" cellspacing="10">

    <tr>
        <td class="pad" colspan="4">
            <label>Report Type:</label>
            @Html.DropDownList("rptType", new List<SelectListItem>
                {
            new SelectListItem{ Text="Clear to Build", Value = "Clear to Build" },
            new SelectListItem{ Text="Not Reserved", Value = "Not Reserved" },
            new SelectListItem{ Text="Not Shipped", Value = "Not Shipped",  },
                  
                   

                }, new { @class = "form-control" })
        </td>
    </tr>


    <tr>
        <td colspan="4" class="pad">
            @Html.Action("GetProgramBySite", "Home", new { id = "ProgramID", @name = "ProgramID", area = "" })
        </td>
    </tr>
    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.custRef, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="custRef" name="custRef" autofocus
                   onkeydown="GoOnEnter()" />
        </td>

    </tr>

</table>
<br />
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
</table>
<input id="rptcode" type="hidden" value='@Request.QueryString["rptCode"]' />
<script>
    function GoOnEnter() {
        if (event.keyCode == 13) {

                Go();
            }
        }

    $('#btnGo').click(function () {

            Go();

    });


    function Go() {

        var rptName = $("#rptType option:selected").val();
        var programId = $('#ProgramID').val();
        var ProgramName = $("#ProgramID option:selected").text();
        var custRef = $('#custRef').val();

        if (rptName == 'Not Shipped') {
            $('#option').modal('hide');
            OpenPage('\\SupplyChain\\SOPickList\\Index?ProgramID=' + programId + '&ProgramName=' + ProgramName + '&custRef=' + custRef + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')

        }
        else if (rptName == 'Not Reserved')
        {

            $('#option').modal('hide');
            OpenPage('\\SupplyChain\\SOPickList\\GetNotReserved?ProgramID=' + programId + '&ProgramName=' + ProgramName + '&custRef=' + custRef + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
        }

        else if (rptName == 'Clear to Build')
        {

            $('#option').modal('hide');
            OpenPage('\\SupplyChain\\SOPickList\\GetClearToBuild?ProgramID=' + programId + '&ProgramName=' + ProgramName + '&custRef=' + custRef + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
        }

        }
</script>
