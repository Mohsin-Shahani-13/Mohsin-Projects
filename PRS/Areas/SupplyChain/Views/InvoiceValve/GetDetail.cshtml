@model IP.Areas.SupplyChain.Models.InvoiceValve
@{
    ViewBag.Title = "GetDetail";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle Detail  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstData" class="table table-bordered table-striped text-sm table-hover" >
                <thead class="sorted-asc">
                    <tr>
                        <th></th>
                        <th class="notexport"></th>
                        @*<th class="notexport"></th>*@
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        @*<th></th>*@
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    @*<tr>
                            <th Total:></th>

                            <th> </th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>

                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>



                        </tr>*@
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
     
        $('#tblBody').empty();

        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var programId = $('#ddProgram').val();
        var ProgramName = $("#ddProgram option:selected").text();


        $.ajax({

            cache: false,
            type: 'GET',
            url: '/InvoiceValve/GetDtl',
            data: {
                fromDt: fDate,
                toDt: tDate,
                programId: programId,
                ProgramName: ProgramName
                

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "OrderHeaderID", "title": "WO Id", "width": "40px" },
                        { "data": "ProgramID", "title": "ProgramID", "width": "40px", "visible": false },
                        //{ "data": "Name", "title": "Program", "width": "50px", "visible": false },


                        {
                            "data": "serialno", "title": "Serial No.", "width": "80px",
                            render: function (data, type, row) {
                                if (row["Serial"] == "*") {
                                    url = row["Serial"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?SerialNo=' + row["serialno"] + '&ProgramId=' + row["ProgramID"] + '&partNo=' + row["model"] + '&page=list" target=_blank > ' + data + '</a>';
                                }
                                return url;
                            }
                        },


                        {
                            "data": "CustomerReference", "title": "Customer Ref.", "width": "70px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\RO\\Detail?Id=' + row["OrderHeaderID"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';

                                return url;
                            }
                        },
                        { "data": "rmarec", "title": "RMA Received On", "width": "90px", "className": "text-right" },
                        { "data": "woclose", "title": "WO Close On", "width": "90px", "className": "text-right" },
                        { "data": "tat", "title": "TAT", "width": "30px", "className": "text-right" },
                        { "data": "ship", "title": "SO On", "width": "70px", "className": "text-right" },
                        {
                            "data": "incpart", "title": "Incoming Part No.", "width": "100px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["incpart"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },

                        {
                            "data": "retreason", "title": "Return Reason", "width": "170px"

                        },

                        {
                            "data": "model", "title": "Model", "width": "70px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["model"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },

                      

                        { "data": "RepairTypeDescription", "title": "Order Type", "width": "120px" },
                        //  { "data": "RMAType", "title": "RMA Type", "width": "100px" },

                        { "data": "cid", "title": "CID", "width": "40px", "className": "text-center" },
                        //{ "data": "BER", "title": "BER", "width": "50px" },
                        { "data": "repairstatus", "title": "Repair Status", "width": "90px" },
                        { "data": "warr", "title": "In Warranty", "width": "40px", "className": "text-center" },
                        { "data": "InWarrantyoutGoing", "title": "In Warranty Out Going", "width": "80px", "className": "text-center" },

                        { "data": "reid", "title": "REID", "width": "70px" },

                      
                        

                        //{ "data": "FaultDesc", "title": "Fault Desc.", "width": "50px" },
                        //{ "data": "RepairStatus", "title": "Repair Status", "width": "70px" },

                        { "data": "repreturn", "title": "Rep. Return", "width": "40px", "className": "text-center" },
                        { "data": "closedrep", "title": "Return Count", "width": "50px", "className": "text-right" },
                        { "data": "rettat", "title": "Rep. Return TAT", "width": "70px", "className": "text-right" },
                        { "data": "ro", "title": "ROH ID", "width": "70px", "visible": false },
                        { "data": "componentpartno", "title": "Comp. Part No.", "width": "50px" },
                        { "data": "faults", "title": "Faults", "width": "120px" },
                        { "data": "repairs", "title": "Repairs", "width": "90px" },
                        {
                            "data": "repairlevel", "title": "Repair Level", "width": "120px"
                        }
                       

                    ]

                    ToggleDataList(true);
                    //For Displaying  Footer Sum
                    //var footerfunc = function () {
                    //    var api = this.api();
                    //    $(api.column(12).footer()).html(thousands_separators(api.column(12, { search: 'applied' }).data().sum()));
                    //  //  $(api.column(4).footer()).html(thousands_separators(api.column(4, { search: 'applied' }).data().sum()));

                    //}
                    MakeDataGrid('lstData', data.lstData, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>