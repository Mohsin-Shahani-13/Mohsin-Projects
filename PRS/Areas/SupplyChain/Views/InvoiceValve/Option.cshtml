@model IP.Areas.SupplyChain.Models.InvoiceValve
@{
    ViewBag.Title = "Option";
    Layout = null;
}

<style>
    .pad {
        width: 180px;
    }
</style>
<table class="fullWidth">
    <tr>
        <td class="pad" colspan="4">
            <label>Report Type:</label>
            @Html.DropDownList("rptType", new List<SelectListItem>
                {

                   new SelectListItem{ Text="Summary", Value = "Summary",  },
                   new SelectListItem{ Text="Detail", Value = "Detail" },


                }, new { @class = "form-control" })
        </td>
    </tr>

    <tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.program, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddProgram", null, new { id = "ddProgram", @name = "ddProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>
    </tr>
    <tr>
        <td class="pad">

            <strong>From:</strong>
            <div class='input-group date' id='dtpFrom'>
                @Html.TextBoxFor(model => model.fromDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
        <td class="pad">
            <strong>To:</strong>
            <div class='input-group date' id='dtpTo'>
                @Html.TextBoxFor(model => model.toDt, htmlAttributes: new { @class = "form-control" })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
        </td>
    </tr>
    <tr>
        @*<td colspan="4" class="pad">
            @Html.LabelFor(model => model.custRef, new { @class = "col-4 col-form-label" })
            <input type="text" class="form-control" id="custRef" name="custRef" autofocus
                   onkeydown="GoOnEnter()" />
        </td>*@

    </tr>
    @*<tr>
            <td colspan="4" class="pad">
                @Html.LabelFor(model => model.program_Id, htmlAttributes: new { @class = "col-4 col-form-lable" })
                @Html.DropDownList("ddlProgram", null, new { id = "ddlProgram", @name = "ddlProgram", @class = "form-control", @onkeydown = "GoOnEnter()" })

            </td>
        </tr>*@
    @*<tr>
        <td colspan="4" class="pad">
            @Html.LabelFor(model => model.statusId, htmlAttributes: new { @class = "col-4 col-form-lable" })
            @Html.DropDownList("ddlStatus", null, new { id = "ddlStatus", @name = "ddlStatus", @class = "form-control", @onkeydown = "GoOnEnter()" })
        </td>

    </tr>*@
</table>
<table width="100%">
    <tr>
        <td align="center">
            <div id="lblMsg" class="optionMsg">
            </div>
        </td>
        <td width="70" align="right">
            <a id="btnGo" role="button" class="btn btn-primary">Confirm</a>
        </td>
        <td width="100" align="center">
            <a id="btnCancel" data-dismiss="modal" class="cancel">Cancel</a>
        </td>
    </tr>
  
</table>
<script>
  

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    $("#dtpTo, #dtpFrom").mouseover(function () {
        $(this).css('cursor', 'pointer');
    });

    //For Date Picker
    dateFrom();
    dateTo();
    function dateFrom() {
        var date = new Date();
        var newdate = new Date(date);
        //For From Date
        newdate.setDate(newdate.getDate());

        var dd = (newdate.getFullYear(newdate.getMonth()), '0' + 1);
        //var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('fromDt').value = someFormattedDate;
    }
    function dateTo() {
        var date = new Date();
        var newdate = new Date(date);
        //For To Date
        newdate.setDate(newdate.getDate());

        var dd = ('0' + newdate.getDate()).slice(-2);
        var mm = ('0' + (newdate.getMonth() + 1)).slice(-2);
        var y = newdate.getFullYear();
        var strat = newdate

        var someFormattedDate = y + '.' + mm + '.' + dd;

        document.getElementById('toDt').value = someFormattedDate;
    }

    $("#dtpTo, #dtpFrom").datepicker({
        format: 'yyyy.mm.dd',
        autoclose: true,
        startDate: '-365d',
        endDate: maxDate
    });

    function isDate(txtDate) {
        if (txtDate.length != 10) {
            return false;
        }
        if (txtDate.substring(4, 5) !== '.' || txtDate.substring(7, 8) !== '.') {
            return false;
        }
        return true;
    }

    function OptionsIsValid() {

        $('#lblMsg').empty();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();

        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }
    }
    function GoOnEnter() {
        if (event.keyCode == 13) {
            var retVal = OptionsIsValid();
            if (retVal == true) {
                Go();
            }
        }
    }
     $('#btnGo').click(function () {
        var retVal = OptionsIsValid();
        if (retVal == true) {
            Go();
        }
    });

    function OptionsIsValid() {
        $('#lblMsg').empty();

        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();

        var programId = $('#ddProgram option:selected').text();
        //var status = $('#ddlStatus option:selected').text();

        if (fDate.length <= 0 || tDate.length <= 0 || !isDate(fDate) || !isDate(tDate) || fDate > tDate) {
            $('#lblMsg').append('Enter a valid date');
            return false;
        }
        else {
            $('#lblMsg').empty();
            return true;
        }

        if (status == null) {
            $('#lblMsg').empty();
            $('#lblMsg').append('Something went wrong! Reopen Option Page');
            return false;
        }
        if (status == 'No Data Available') {
            $('#lblMsg').empty();
            $('#lblMsg').append('Select Status ');
            return false;
        }

        else {
            $('#lblMsg').empty();
            return true;
        }
    };

    function Go() {
        var rptName = $("#rptType option:selected").val();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
       
        var programId = $('#ddProgram').val();
        var ProgramName = $("#ddProgram option:selected").text();
     
        $('#option').modal('hide');
        
        if (rptName == 'Summary')
        {
            OpenPage('\\SupplyChain\\InvoiceValve\\Index?frmDt=' + fDate + '&rptName=' + rptName + ' &toDate=' + tDate +  '&ProgramID=' + programId + '&ProgramName=' + ProgramName + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
        }
        else if (rptName == 'Detail')
        {
            OpenPage('\\SupplyChain\\InvoiceValve\\GetDetail?frmDt=' + fDate + '&rptName=' + rptName + ' &toDate=' + tDate +   '&ProgramID=' + programId + '&ProgramName=' + ProgramName + '&menuTitle=' + $('.modal-header').html() + '&rptCode=' + '@Request.QueryString["rptCode"]')
        }
    }
</script>

