<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();
        
        $('#option').modal('hide');
        var isSingleRow = false;
        var frmDt = $('#frmDt').val();
        var toDt = $('#toDt').val();
        var CustomerReference = $('#CustomerReference').val();
        var PartNo = $('#PartNo').val();
        var programId = '@Request.QueryString["programId"].ToString()';
        var programName = '@Request.QueryString["programName"].ToString()';
        //var statusId = $('#ddlStatus').val();
        //var Status = $('#ddlStatus option:selected').text();
        var status = '@Request.QueryString["status"].ToString()';
        var statusId ='@Request.QueryString["statusId"].ToString()';

        //For Multiple Status
        var statusId = '';
        var status = '';
        if (selectedParts == "All") {
            status = "All";
        }
        else {
            $('#lstStatus :selected').each(function (i, sel) {
                if (i == 0) {
                    statusId = "'" + ($(sel).val()) + "'";
                    status = ($(sel).text());
                }
                else {
                    statusId += "," + "'" + ($(sel).val()) + "'";
                    status = "Multiple";
                }
            });
        }

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/SLAReport/GetList',
            data: {
                frmDt: frmDt,
                toDt: toDt,
                CustomerReference: CustomerReference,
                PartNo: PartNo,
                programId: programId,
                programName: programName,
                statusId: statusId,
                status: status,

            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramId", "title": "Program ID", "width": "40px", "visible": false },
                        { "data": "ProgramName", "title": "Program", "width": "80px" },
                        { "data": "WOHeaderID", "title": "WO Header Id", "width": "80px", "visible": false},
                        //{
                        //    "data": "serialno", "title": "Serial No.", "width": "80px",
                        //    render: function (data, type, row) {
                        //        var d = data.toString();
                        //        if (row["HAS_SN"] == 'N') {
                        //            url = row["serialno"];
                        //        }
                        //        else {
                        //           // var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["serialno"] + '&ProgramId=' + row["programid"] + '&page=list" target=_blank > ' + d + '</a>';
                        //            var url = d;
                        //        }
                        //        return url;
                        //    }
                        //},
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "120px",
                            render: function (data, type, row) {
                                if (row["SerialNo"] == "*" || row["HAS_SN"] == 'N') {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramId"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "CustomerReference", "title": "Customer Ref.", "width": "130px" },
                        //{
                        //    "data": "customerreference", "title": "Customer Ref.", "width": "130px",
                        //    render: function (data, type, row) {

                        //        var url = '<a href= "\\SupplyChain\\RO\\Detail?ID=' + row["ID"] + '&custRef=' + row["customerreference"] + '&ProgramId=' + row["programid"] + '&page=list" target=_blank > ' + data + '</a>';
                        //        return url;
                        //    }
                        //},
                        { "data": "ThirdPartyReference", "title": "Third Party Ref.", "width": "90px" },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "80px",
