                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var reportName = $("#typeReport option:selected").val();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var _serial_no = $('#serialNo').val();
        //var _programId = $('#ProgramID').val();
        //var _ProgramName = $("#ProgramID option:selected").text();
        var _programId = $('#ddProgram').val();
        var _ProgramName = $("#ddProgram option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/InvoiceRepairDetail/GetList',
            data: {
                rpt_name: reportName,
                frmDt: fDate,
                toDate: tDate,
                SerialNo: _serial_no,
                programId: _programId,
                ProgramName: _ProgramName
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);


                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "ProgramID", "width": "70px" , "visible": false  },
                        { "data": "Name", "title": "Program", "width": "70px" }, 
                        { "data": "RepairType", "title": "Repair Type", "width": "80px" },
                        { "data": "ID", "title": "WO Header ID", "width": "80px" },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "70px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?PartNo=' + row["PartNo"] + '&Programid=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "serialno", "title": "Serial No.", "width": "110px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                if (row["HAS_SN"] == 'N') {
                                    url = row["serialno"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialno=' + row["serialno"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + d + '</a>';
                                }
                                return url;
                            }
                        },
                        {
                            "data": "CustomerReference", "title": "Customer Ref.", "width": "80px",
                            render: function (data, type, row) {

                                var url = '<a href= "\\SupplyChain\\WO\\Detail?ID=' + row["ID"] + '&custRef=' + row["CustomerReference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "ROCustomerReference", "title": "RO Cust. Ref.", "width": "90px"},
                        {
                            "data": "componentpartno", "title": "Comp. Part No.", "width": "90px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["componentpartno"] + '&Programid=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "CompPartNoDesc", "title": "Comp. Part. No. Desc.", "width": "240px" },
                        { "data": "compconfig", "title": "Comp. Config.", "width": "80px" },
                        { "data": "qtyrequested", "title": "Requested", "width": "80px", "className": "text-right" },
                        { "data": "qtyconsumed", "title": "Consumed", "width": "80px", "className": "text-right" },
                        { "data": "Status", "title": "Status", "width": "80px" },
                        { "data": "faultcode", "title": "Fault Code", "width": "60px" },
                        { "data": "Fault", "title": "Fault Desc.", "width": "200px" },
                        { "data": "repaircode", "title": "Repair Code", "width": "90px" },
                        { "data": "Repair", "title": "Repair Desc.", "width": "180px" }, 
                        { "data": "INVOICE_FAMILY", "title": "Invoice Family", "width": "90px" },
                        { "data": "RepairedBy", "title": "Repaired By", "width": "90px" },
                        { "data": "gTask2", "title": "gTask2", "width": "90px" },
                        { "data": "gTask3", "title": "gTask3", "width": "90px" },
                        { "data": "RepairLevel", "title": "Repair Level", "width": "90px" },
                        { "data": "Value", "title": "Value", "width": "80px", "visible": false},
                        { "data": "lastactivitydate", "title": "Last Activity On", "width": "90px", "className": "text-right" }
                    ];

                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(11).footer()).html(thousands_separators(api.column(11, { search: 'applied' }).data().sum()));
                        $(api.column(12).footer()).html(thousands_separators(api.column(12, { search: 'applied' }).data().sum()));
                                                
                    }

                    ToggleDataList(true);
                    MakeDataGrid('lstInvoiceRepairDetail', data.lstInvoiceRepairDetail, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>
