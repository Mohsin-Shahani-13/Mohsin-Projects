@model IP.Areas.SupplyChain.Models.PartAging
@{
    ViewBag.Title = "Index";
    Layout = null;
}
<div id="parentDiv" class="container">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstPartAging" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>


                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>


                    </tr>
                    </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {

        var COLUMN_FORMAT =
        {
            formatDecimal: function (data, type, row) {
                var val = +data;
                return val === 0 ? '' : thousands_separators(val.toFixed(4));
            },
            formatTwoDecimal: function (data, type, row) {
                var val = +data;
                return val === 0 ? '' : val.toFixed(2);
            },
            formatNumber: function (data, type, row) {
                var val = +data;
                return val === 0 ? '' : thousands_separators(val.toFixed(0));
            },

            formatNumberForZero: function (data, type, row) {
                var val = +data;
                return val === 0 ? '' : val.toFixed(0);
            },

        };

        $('#tblBody').empty();
        $('#option').modal('hide');
        var IdleOver = $('#IdleOver').val();
        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();
       
        $.ajax({

            cache: false,
            type: 'GET',
            url: '/PartAging/GetList',
            data: {
                IdleOver: IdleOver,
                programId: _programId,
                ProgramName: _ProgramName
            },
            datatype: JSON,
            success: function (data) {
               
                $('#filterString').append(data.filterString);


                var columnDef = [
                    { "data": "ProgramID", "title": "ProgramID", "width": "70px", "visible": false },
                    { "data": "Name", "title": "Program", "width": "70px" },

                    {
                        "data": "PartNo", "title": "Part No.", "width": "120px",
                        render: function (data, type, row) {
                            var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                            return url;
                        }
                    },
                    { "data": "LocationNo", "title": "Location No." },
                    { "data": "LocationGroup", "title": "Location Group", "width": "100px" },

                    { "data": "Configuration", "title": "Configuration", "width": "40px" },
                    { "data": "PalletBoxNo", "title": "Pallet Box No.", "width": "80px"},
                    { "data": "LotNo", "title": "Lot No.", "width": "60px" },
                   
                    {
                        "data": "AvailableQty", "title": "OH Qty", "width": "50px", "className": "text-right",

                        render: function (data, type, row) {

                            var val = COLUMN_FORMAT.formatNumber(data);
                            return val;
                        }
                    },
                   

                    { "data": "Username", "title": "Created By", "width": "100px" },
                
                    { "data": "LastActivityDate", "title": "Last Activity On", "width": "110px", "className": "text-right" }
                ]
                var footerfunc = function () {
                    var api = this.api();
                    $(api.column(8).footer()).html(thousands_separators(api.column(8, { search: 'applied' }).data().sum()));
                    
                }

                ToggleDataList(true);
                MakeDataGrid('lstPartAging', data.lstPartAging, 0, columnDef, true, true, footerfunc);

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });


    }
</script>

