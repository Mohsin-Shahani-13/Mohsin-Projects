@model IP.Areas.SupplyChain.Models.RICInventoryControl

@{
    ViewBag.Title = "Index";
    Layout = null;
}
<style>
    tr {
        white-space: nowrap;
    }
</style>
<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstRICInventoryControl" class="table table-bordered table-striped text-sm table-hover">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;

        var _programId = $('#ddProgram').val();
        var _programName = $("#ddProgram option:selected").text();
        //var fDate = $('#fromDt').val();
        //var tDate = $('#toDt').val();
        var _location = $('#Location').val();
        var _customerPO = $("#customerPO").val();
        var _RMA = $("#RMA").val();
        var _standardName = $('#standardName').val();



        $.ajax({

            cache: false,
            type: 'GET',
            url: '/RICInventoryControl/GetList',
            data: {
                programId: _programId,
                programName: _programName,
                location: _location,
                customerPO: _customerPO,
                RMA: _RMA,
                standardName: _standardName
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ID", "title": "ID", "visible": false },
                        { "data": "LocationNo", "title": "Location No.", "width": "100px" },
                        { "data": "LastActivityDate", "title": "Last Activity On", "width": "110px", "className": "text-right" },
                        {
                            "data": "FRU", "title": "FRU", "width": "100px",

                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["FRU"] + '&ProgramId=' + row["ID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "Tracker", "title": "Tracker", "width": "80px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                if (row["Tracker"] == "*" || row["HAS_SN"] == 'N') {
                                    url = row["Tracker"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["Tracker"] + '&ProgramId=' + row["ID"] + '&PartNo=' + row["FRU"] + '&page=list" target=_blank > ' + d + '</a>';
                                }
                                return url;
                            }
                        },
                        { "data": "DISPOSITION", "title": "Disposition", "width": "80px" },
                        { "data": "Current_status", "title": "Current Status", "width": "120px" },
                        { "data": "HAS_SN", "title": "HAS_SN", "visible": false },
                        {
                            "data": "SERIAL", "title": "Serial No.", "width": "100px",

                        },
                        { "data": "SERIAL_11S", "title": "Serial 11S", "width": "120px" },
                        { "data": "SERIAL_8S", "title": "Serial 8S", "width": "100px" },
                        { "data": "SERIAL_52S", "title": "Serial 52S", "width": "120px" },
                        { "data": "SERIAL_1", "title": "Serial 1", "width": "100px" },
                        { "data": "SERIAL_2", "title": "Serial 2", "width": "100px" },
                        { "data": "SERIAL_3", "title": "Serial 3", "width": "100px" },
                        { "data": "PLUS_RO", "title": "Plus RO", "width": "80px" },
                        { "data": "RMA", "title": "RMA", "width": "150px" },
                        { "data": "CreateDate", "title": "Created On", "width": "100px", "className": "text-right" },
                        { "data": "Description", "title": "Description", "width": "160px" },
                        { "data": "MANUF_PART", "title": "Manufacture Part", "width": "120px" },
                        { "data": "Customer_PO", "title": "Customer PO", "width": "120px" },
                        { "data": "reference", "title": "Reference", "width": "100px" },
                        { "data": "COO", "title": "COO", "width": "80px" },
                        { "data": "WMS_LOCATION", "title": "WMS Location", "width": "120px" },
                        { "data": "TAPEINSIDE", "title": "Tape Inside", "width": "80px", "className": "text-center" },
                        { "data": "FAILURE_MODE", "title": "Failure Mode", "width": "120px" },
                        { "data": "Username", "title": "Username", "width": "100px" },
                        { "data": "RETCNT", "title": "RETCNT", "width": "100px" },
                        { "data": "MfgDATE", "title": "Mfg. On", "width": "100px", "className": "text-right" },
                        { "data": "Pictures", "title": "Pictures", "width": "80px", "className": "text-center" },
                        { "data": "STANDARD_NAME", "title": "Standard Name", "width": "150px" },
                        { "data": "EXTRA_FIELDS", "title": "Extra Fields", "width": "200px" }
                    ];
                    ToggleDataList(true);
                    MakeDataGrid('lstRICInventoryControl', data.lstRICInventoryControl, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>



