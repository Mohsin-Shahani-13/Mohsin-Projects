@model IP.Areas.SupplyChain.Models.WOWipReport
@{
    ViewBag.Title = "Index";
    Layout = null;
}


<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstWOWipReport" class="table table-bordered table-striped text-sm table-hover">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                      @*  <th></th>*@
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        @*<th></th>*@
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var isAllDate = $('#isAllDate').is(':checked');
        var WorkOrderType = $('#WorkOrderType').val();
        var WorkOrderTypeText = $("#WorkOrderType option:selected").text();
        var _programId = $('#ddProgram').val();
        var _ProgramName = $("#ddProgram option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/WOWipReport/GetList',
            data: {
                frmDt: fDate,
                toDate: tDate,
                isAllDate: isAllDate,
                WorkOrderType: WorkOrderType,
                WorkOrderTypeText: WorkOrderTypeText,
                programId: _programId,
                ProgramName: _ProgramName
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramId", "title": "Program ID", "width": "40px", "visible": false },
                        //{ "data": "Program", "title": "Program", "width": "60px" },
                        { "data": "WOHeaderId", "title": "Order Header Id", "width": "90px" },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "200px",

                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramId"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "200px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                if (row["SerialNo"] == "*" || row["HAS_SN"] == 'N') {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramId"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + d + '</a>';
                                }
                                return url;
                            }
                        }, 
                        //{ "data": "CustomerReference", "title": "Cust. Ref.", "width": "130px" },
                        {
                            "data": "ROCustRef", "title": "RO Cust. Ref.", "width": "130px",
                            render: function (data, type, row) {

                                var url = '<a href= "\\SupplyChain\\RO\\Detail?ID=' + row["WOHeaderId"] + '&custRef=' + row["ROCustRef"] + '&ProgramId=' + row["ProgramId"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "CrntWS", "title": "Current Station", "width": "130px" },
                        { "data": "PrevWS", "title": "Previous Workstation", "width": "130px" },
                        { "data": "WorkOrderType", "title": "Work Order Type", "width": "100px" },
                        { "data": "ReturnOrderType", "title": "Return Order Type", "width": "100px" },
                        { "data": "ReturnOrderNo", "title": "Return Order No.", "width": "100px" },
                        { "data": "HoldReason", "title": "Hold Reason", "width": "250px" },
                        { "data": "ReturnReason", "title": "Return Reason", "width": "200px" },
                        { "data": "IncomingPartNo", "title": "Inc Part No.", "width": "90px" },
                        { "data": "CreatedBy", "title": "Created By", "width": "130px" },
                        { "data": "CreatedOn", "title": "Created On", "width": "90px", "className": "text-right" },
                        { "data": "LastActivityOn", "title": "Last Activity On", "width": "90px", "className": "text-right" }, 
                        { "data": "TAT", "title": "TAT", "width": "30px", "className": "text-right" },
                        { "data": "RepeatReturn", "title": "Rep. Ret.", "width": "60px", "className": "text-center" },
                        { "data": "ReturnCount", "title": "Ret. Count", "width": "60px", "className": "text-right" },
                        { "data": "InWarranty", "title": "In Warranty", "width": "70px", "className": "text-center" },
                        { "data": "MaxRcvdOn", "title": "Rcvd On", "width": "90px", "className": "text-right", "visible": false  },
                        { "data": "MaxShippedOn", "title": "Shipped On", "width": "90px", "className": "text-right", "visible": false  },
                        { "data": "RepeatReturnTAT", "title": "Rep. Ret. Turn Aro.", "width": "50px", "className": "text-right" }
                    ]

                    ToggleDataList(true);
                    MakeDataGrid('lstWOWipReport', data.lstWOWipReport, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>
