@model IP.Areas.Finance.Models.GLTransactions
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">

        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>

        <div class="box-body" id="lstP">
            <table id="lstGLTransactions" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                            <th style="text-align:left">Total:</th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>

        @*<div id="right_panel" class="col-md-2">
                <div id="rightsection" class="" style="margin-top:50%; margin-left:10px; padding-right:10px;">
                    <h4>Click Qty hyperlinks on left section to load data</h4>
                </div>
            </div>*@
    </div>
</div>

<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;

        var _FiscalYear = $('#FiscalYear').val();
        var _FiscalPeriod = $('#FiscalPeriod').val();
        //var _FiscalPeriodText = $("#FiscalPeriod option:selected").text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/GLTransactions/GetList',
            data: {
                FiscalYear: _FiscalYear,
                FiscalPeriod: _FiscalPeriod
                //FiscalPeriodText: _FiscalPeriodText
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);


                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "fiscalyear", "title": "Fiscal Year", "width": "60px", "className": "text-right"},
                        { "data": "fiscalperiod", "title": "Fiscal Period", "width": "70px", "className": "text-right"},
                        { "data": "NAME", "title": "Name", "width": "120px"},
                        { "data": "glaccount", "title": "GL Account", "width": "80px" },
                        { "data": "accountdesc", "title": "Account Description"},
                        { "data": "description", "title": "Description"},
                        { "data": "bookdebitamount", "title": "Debit Amt", "width": "60px", "className": "text-right" },
                        { "data": "bookcreditamount", "title": "Credit Amt", "width": "60px", "className": "text-right"  },
                        { "data": "postedby", "title": "Posted By", "width": "60px" },
                        { "data": "posteddate", "title": "Posted On", "width": "60px", "className": "text-right" }
                    ]
                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(6).footer()).html(thousands_separators(api.column(6, { search: 'applied' }).data().sum()));
                        $(api.column(7).footer()).html(thousands_separators(api.column(7, { search: 'applied' }).data().sum()));

                    }

                    ToggleDataList(true);
                    MakeDataGrid('lstGLTransactions', data.lstGLTransactions, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>