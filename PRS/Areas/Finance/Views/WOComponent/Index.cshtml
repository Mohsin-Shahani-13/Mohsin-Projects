@model IP.Areas.Finance.Models.WOComponent
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstWOComponent" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {

        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;

        var _programId = $('#ProgramID').val();
        var _ProgramName = $("#ProgramID option:selected").text();
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();
        var partNo = $('#partNo').val();
        var fromWoId = $('#fromWoId').val();
        var toWoId = $('#toWoId').val();
        var InventorySource = $('#InventorySource').val();
        var rptType = $("#rptType option:selected").val();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/WOComponent/GetList',
            data: {


                programId: _programId,
                ProgramName: _ProgramName,
                frmDt: fDate,
                toDt: tDate,
                partNo: partNo,
                fromWoId: fromWoId,
                toWoId: toWoId,
                InventorySource: InventorySource,
                rptType: rptType
            },
            datatype: JSON,
            success: function (data) {

                $('#filterString').append(data.filterString);

                if (!isSingleRow) {
                    var columnDef = [
                        { "data": "ProgramID", "title": "ProgramID", "width": "40px", "visible": false },
                        { "data": "Name", "title": "Program", "width": "60px" },
                        { "data": "WOid", "title": "Order No.", "width": "60px" },
                        //{ "data": "Status", "title": "Status", "width": "50px" },
                        {
                            "data": "PartNo", "title": "Part No.", 
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "100px",
                            render: function (data, type, row) {
                                var d = data.toString();
                                if (row["HAS_SN"] == 'N' || row["SerialNo"] == "*") {
                                    url = row["SerialNo"];
                                }
                                else {
                                    var url = '<a href= "\\ListingReports\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&Programid=' + row["ProgramID"] + '&partno=' + row["PartNo"] + '&page=list" target=_blank > ' + d + '</a>';
                                }
                                return url;
                            }
                        },
                        {
                            "data": "ComponentPartNo", "title": "Comp. Part No.", "width": "130px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["ComponentPartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "ComponentSerialno", "title": "Comp. Serial No.", "width": "120px" },
                        { "data": "PartTransaction", "title": "Part Transaction", "width": "170px" },
                        { "data": "InventorySource", "title": "Data Source", "width": "180px" },
                        { "data": "Status", "title": "Status", "width": "70px"},

                        { "data": "qty", "title": "Qty", "width": "60px", "className": "text-right" },
                        { "data": "CostPerUnit", "title": "Cost Per. Unit", "width": "90px", "className": "text-right" },
                        { "data": "ExtendedCost", "title": "Extended Cost", "width": "90px", "className": "text-right" },
                        { "data": "CreateDate", "title": "Create On", "width": "90px", "className": "text-right" }

                    ];

                    ToggleDataList(true);
                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        //$(api.column(3).footer()).html(thousands_separators(api.column(3, { search: 'applied' }).data().sum()));
                       // $(api.column(10).footer()).html(thousands_separators(api.column(10, { search: 'applied' }).data().sum()));
                        //$(api.column(19).footer()).html(decimalPlaces(api.column(19, { search: 'applied' }).data().sum(), 2));
                        $(api.column(10).footer()).html(thousands_separators(api.column(10, { search: 'applied' }).data().reduce(function (a, b) {
                            return Number(a) + Number(b);
                        }, 0), 0));

                    }
                    MakeDataGrid('lstWOComponent', data.lstWOComponent, 0, columnDef, true, true, footerfunc);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>
