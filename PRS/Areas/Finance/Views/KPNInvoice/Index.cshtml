@model IP.Areas.Finance.Models.KPNInvoice
@{
    ViewBag.Title = "Index";
    Layout = null;
}



<div id="parentDiv" class="container-fluid">
    <div id="dataList" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                <span class="fa fa-filter fa-lg white"></span>
            </button>
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
            <div id="buttons" class="box-tools pull-right">

            </div>
        </div>
        <div class="box-body" id="lstP">
            <table id="lstKPNInvoice" class="table table-bordered table-striped text-sm table-hover">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>

                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
            </table>
        </div>
    </div>
</div>
<script>

    ToggleDataList(false);
    LoadData();
    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var fDate = $('#fromDt').val();
        var tDate = $('#toDt').val();


        $.ajax({

            cache: false,
            type: 'GET',
            url: '/KPNInvoice/GetList',
            data: {
                frmDt: fDate,
                toDate: tDate
            },
            datatype: JSON,
            success: function (data) {
                $('#filterString').append(data.filterString);

                //$.each(data.lstPartsTransaction, function (index, row) {

                //    if (data.lstDocklog.length == 1) {
                //        isSingleRow = true;
                //        MenuHide();
                //        OpenPage('\\ListingReports\\PartInquiry\\Detail?partNo=' + row["partno"] + '&page=detailed');
                //    }
                //});

                if (!isSingleRow) {
                    var columnDef = [

                        { "data": "ProgramID", "title": "Program ID", "width": "100px", "visible": false },
                        { "data": "WoId", "title": "WoId", "width": "100px", "visible": false },
                        { "data": "RoId", "title": "RoId", "width": "100px", "visible": false },
                        {
                            "data": "RO_Reference", "title": "RO Reference", "width": "100px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\RO\\Detail?Id=' + row["RoId"] + '&custRef=' + row["RO_Reference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        {
                            "data": "WO_Reference", "title": "WO Reference", "width": "60px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\SupplyChain\\WO\\Detail?Id=' + row["WoId"] + '&custRef=' + row["WO_Reference"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';

                                return url;
                            }
                        },
                        {
                            "data": "PartNo", "title": "Part No.", "width": "120px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row["PartNo"] + '&ProgramId=' + row["ProgramID"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "Description", "title": "Description", "width": "280px" },
                        {
                            "data": "SerialNo", "title": "Serial No.", "width": "110px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\\PartsSerial\\Detail?serialNo=' + row["SerialNo"] + '&ProgramId=' + row["ProgramID"] + '&PartNo=' + row["PartNo"] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "data": "SourceSerialNo", "title": "Source Serial No.", "width": "120px" },
                        { "data": "ReceiveOrder_Date", "title": "Receive Order Date", "width": "120px", "className": "text-right" },
                        { "data": "WorkOrder_ClosedDate", "title": "Work Order Closed Date", "width": "140px", "className": "text-right" },
                        { "data": "final_status", "title": "Final Status", "width": "90px" },
                        { "data": "wipeDate", "title": "Wipe Date", "width": "90px", "className": "text-right" },
                        { "data": "UnlockDate", "title": "Unlock Date", "width": "90px", "className": "text-right" },
                        { "data": "Unlock_Vendor", "title": "Unlock Vendor", "width": "110px" },
                        { "data": "RepairDate", "title": "Repair Date", "width": "90px", "className": "text-right" },
                        { "data": "Repair_Vendor", "title": "Repair Vendor", "width": "160px" }
                    ]

                    ToggleDataList(true);
                    MakeDataGrid('lstKPNInvoice', data.lstKPNInvoice, 0, columnDef, true, true, false);
                }
                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });
    }
</script>


