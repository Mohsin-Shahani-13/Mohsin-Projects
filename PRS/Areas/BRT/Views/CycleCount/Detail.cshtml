@model IP.Areas.BRT.Models.CycleCount
@{
    ViewBag.Title = "Detail";
    Layout = cCommon.SwitchToDetailPage(Request.Url.PathAndQuery);
}


@{
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    serializer.MaxJsonLength = Int32.MaxValue;
    //var jsonModel = serializer.Serialize(Model.lstSerial);

}

<div id="parentDiv" class="container-fluid">
    <input id="rptcode" type="hidden" value="107" />
    <div id="datalist" class="box panel panel-default">
        <div class="box-header with-border bg-blue-gradient">
            
                    <button type="button" id="opp" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                        <span class="fa fa-filter fa-lg white"></span>
                    </button>

             
            <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong></h6>
            <div id="buttons" class="box-tools pull-right" style="margin-top:2PX;">
            </div>
        </div>

        <div class="box-body" id="lstP">
            <table id="lstDetail" class="table table-bordered table-striped text-sm table-hover" style="width:100%">
                <thead class="sorted-asc">
                    <tr>
                        <th class="notexport"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th>Total :</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
