                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
@{
    if (Layout == null)
    {
        <script type="text/javascript">
    var COLUMN_FORMAT =
    {
        formatDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(4));
        },
        formatTwoDecimal: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(2);
        },
        formatNumber: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : thousands_separators(val.toFixed(0));
        },

        formatNumberForZero: function (data, type, row) {
            var val = +data;
            return val === 0 ? '' : val.toFixed(0);
        },

    };

      $(document).ready(function () {
        ToggleDataList(false);
          var lstDetail = @Html.Raw(Model.serializer.Serialize((Model.lstDetail)));

                    var columnDef = [
                        { "title": "ProgramID", "width": "60px", "visible": false },
                        { "title": "Program", "width": "60px" },
                        { "title": "Part No.", "width": "80px",
                            render: function (data, type, row) {
                                var url = '<a href= "\\ListingReports\\PartInquiry\\Detail?partNo=' + row[2] + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "title": "Description" },
                        { "title": "Warehouse", "width": "120px" },
                        { "title": "Location No.", "width": "160px" },
                        { "title": "Iteration", "width": "50px" },
                        {
                            "title": "Qty", "width": "50px", "className": "text-right",
                            render: function (data, type, row) {
                                var val = COLUMN_FORMAT.formatNumber(data);
                                return val;
                            }
                        },
                        {
                            "title": "Counted", "width": "50px", "className": "text-right",
                            render: function (data, type, row) {
                                var val = COLUMN_FORMAT.formatNumber(data);
                                return val;
                            }
                        },
                        { "title": "Delta", "width": "30px", "className": "text-right" },
                        {
                            "data": "IRA", "title": "IRA", "width": "30px", "className": "text-right",
                            render: function (data, type, row) {
                                var val = COLUMN_FORMAT.formatTwoDecimal(data);
                                return val;
                            }
                        },
                        { "title": "Error", "width": "30px", "className": "text-center" },
                        { "title": "Id", "width": "20px" },
                        { "title": "Created By", "width": "100px" },
                        { "title": "Last Activity On", "width": "90px", "className": "text-right" }
                    ]
                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(7).footer()).html(thousands_separators(api.column(7, { search: 'applied' }).data().sum()));
                        $(api.column(8).footer()).html(thousands_separators(api.column(8, { search: 'applied' }).data().sum()));
                        $(api.column(9).footer()).html(thousands_separators(api.column(9, { search: 'applied' }).data().sum()));
                    }

                    ToggleDataList(true);
          MakeDataGrid('lstDetail', lstDetail, 0, columnDef, true, true, footerfunc);

      
              $("#opp").click(function () {

                  Navigate('option', '\\BRT\\CycleCount\\Option', '107', 'Cycle Count', 'Specd by: Abbas Arsiwala @@ Reconext &amp; Designed by: Fasihullah khan @@ WinIT', 'mailto:kashif@winit.biz?cc=mohsin@winit.biz;Tahir@winit.biz&amp;subject=Cycle Count Report');

              });

      

        });

        </script>
    }
    else
