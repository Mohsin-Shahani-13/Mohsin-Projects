@model IP.Areas.BRT.Models.CycleCountAccuracy
@{
    ViewBag.Title = "Option";
    Layout = null;
}
<style>
    .Part_Undrln {
        text-decoration: underline;
    }
</style>
<script src="https://canvasjs.com/assets/script/canvasjs.min.js"></script>
<div id="dataList">
    <div id="parentDiv" class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div id="SMRYBox" class="box panel panel-default">
                    <div class="box-header with-border bg-blue-gradient" id="box-header">
                        <button type="button" class="btn btn-box-tool" title="Option Page" onclick="$('#option').modal('show');">
                            <span class="fa fa-filter fa-lg white"></span>
                        </button>
                        <h6 class="box-title"><strong>@ViewBag.ReportTitle  </strong><strong id="filterString"></strong></h6>
                        <div id="buttons" class="box-tools pull-right">
                        </div>
                    </div>
                    <div class="row section-color">
                        <div class="col-md-12 center">
                            <div class="box canvas" style="height: 52%; width: 100%;">
                                <div id="Chart1" class="box-body"">
                                    <div class="chart">
                                        <canvas id="canvas" class="center-block" style="max-width: 50%;border:1px solid #d3d3d3; border-radius: 10px;"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="box-body">
                        <table id="lstCCAccuracy" class="table table-bordered table-striped text-sm table-hover" style="padding-right:5px;width:100%;">
                            <thead class="sorted-asc">
                                <tr>
                                    <th class="notexport"> </th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th></th>
                                    <th>Total :</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<script>
    ToggleDataList(false);
    LoadData();

    //For On Order Chart
    var dataSummaryAccuracyChart = [];
    var TotalCount = [];
    var Pass = [];
    var Fail = [];
    var percentage = [];
    var dataset = [];

    var label = [];

    function LoadData() {
        $('#tblBody').empty();

        $('#option').modal('hide');
        var isSingleRow = false;
        var programId = '@Request.QueryString["programId"].ToString()';
        var programName = '@Request.QueryString["programName"].ToString()';
        var no = $('#no').val();
        var calender = $('#calender option:selected').text();

        $.ajax({

            cache: false,
            type: 'GET',
            url: '/CycleCountAccuracy/GetList',
            data: {
                programId: programId,
                programName: programName,
                no: no,
                calender: calender
            },

            datatype: JSON,
            success: function (data) {

                GenereteSummaryData(data.dataSummaryAccuracyChart);

                var dataSummaryAccuracyChart = {

                    labels: label,
                    datasets: [
                        {
                            label: 'Total Pass',
                            type: 'bar',
                            data: Pass,
                            backgroundColor: '#006600',
                            borderColor: [
                                '#49630A',
                            ],
                            borderWidth: 1,
                          
                        },
                        {
                            label: 'Total Fail',
                            data: Fail,
                            backgroundColor: '#b30000',
                            borderColor: [
                                '#C82424',
                            ],
                            borderWidth: 1,

                        },
                        {
                            label: 'Accuracy %',
                            fill: false,
                            data: percentage,
                            type: 'line',
                            backgroundColor: '#EB9100',
                            borderColor: '#EB9100',
                            point: true,
                            pointStyle: true,
                            pointRadius: 1,
                            pointBorderColor: '#EB9100',
                            datalabels: {
                                display: true,
                                color: '#002699',
                                font: {
                                    weight: 'bold',
                                },
                                formatter: (value) => {
                                    return value + '%';
                                },
                            },
                             borderWidth: 2,
                        }
                    ]
                };


                //$('#canvas').height(getHeight(TOTALhEIGHT));
                var ctx = document.getElementById('canvas').getContext('2d');
                DrawMeChart(ctx, dataSummaryAccuracyChart, 'Cycle Count Accuracy', 'bar');
                $('#filterString').append(data.filterString);

                if (calender == "Days") {
                    var columnDef = [
                        { "title": "Program Id", "width": "60px", "targets": 0, "visible": false },
                        { "title": "Program", "width": "60px", "targets": 1 },
                        { "title": "Site", "targets": 2 },
                        {
                            "title": "Total Count", "width": "70px", "className": "text-right", "targets": 3,
                            render: function (data, type, row) {
                                var url = '<a class="Part_Undrln" href= "\\BRT\\CycleCount\\Detail?programId=' + row[0] + '&program=' + row[1] + '&frmDt=' + row[6] + '&toDate=' + '&no=' + no + '&calender=Days' + '&rptCode=107' + '&menuTitle=Cycle Count' + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "title": "Total Pass", "width": "70px", "className": "text-right", "targets": 4 },
                        { "title": "Total Fail", "width": "60px", "className": "text-right", "targets": 5 },
                        { "title": "For Date", "width": "60px", "className": "text-right", "targets": 6 }
                    ]


                    //For Displaying  Footer Sum
                    var footerfunc = function () {
                        var api = this.api();
                        $(api.column(3).footer()).html(thousands_separators(api.column(3).data().sum()));
                        $(api.column(4).footer()).html(thousands_separators(api.column(4).data().sum()));
                        $(api.column(5).footer()).html(thousands_separators(api.column(5).data().sum()));
                    }

                    ToggleDataList(true);
                    MakeFrameGrid('lstCCAccuracy', data.lstCCAccuracy, 0, columnDef, false, true, true, footerfunc, false, false, false);
                }

                else if (calender == "Weeks") {
                    var columnDef1 = [
                        { "title": "Program Id", "width": "60px", "targets": 0, "visible": false },
                        { "title": "Program", "width": "60px", "targets": 1 },
                        { "title": "Site", "targets": 2 },
                        {
                            "title": "Total Count", "width": "70px", "className": "text-right", "targets": 3,
                            render: function (data, type, row) {
                                var url = '<a class="Part_Undrln" href= "\\BRT\\CycleCount\\Detail?programId=' + row[0] + '&program=' + row[1] + '&frmDt=' + row[6] + '&toDate=' + '&no=' + no + '&calender=Weeks' + '&rptCode=107' + '&menuTitle=Cycle Count' + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "title": "Total Pass", "width": "70px", "className": "text-right", "targets": 4 },
                        { "title": "Total Fail", "width": "60px", "className": "text-right", "targets": 5 },
                        { "title": "Week Start Date", "width": "90px", "className": "text-right", "targets": 6 }
                    ]
                    //For Displaying  Footer Sum
                    var footerfunc1 = function () {
                        var api = this.api();
                        $(api.column(3).footer()).html(thousands_separators(api.column(3).data().sum()));
                        $(api.column(4).footer()).html(thousands_separators(api.column(4).data().sum()));
                        $(api.column(5).footer()).html(thousands_separators(api.column(5).data().sum()));
                    }

                    ToggleDataList(true);
                    MakeFrameGrid('lstCCAccuracy', data.lstCCAccuracy, 0, columnDef1, false, true, true, footerfunc1, false, false, false);

                }

                else if (calender == "Months") {
                    var columnDef2 = [
                        { "title": "Program Id", "width": "60px", "targets": 0, "visible": false },
                        { "title": "Program", "width": "60px", "targets": 1 },
                        { "title": "Site", "targets": 2 },
                        {
                            "title": "Total Count", "width": "70px", "className": "text-right", "targets": 3,
                            render: function (data, type, row) {
                                var url = '<a class="Part_Undrln" href= "\\BRT\\CycleCount\\Detail?programId=' + row[0] + '&program=' + row[1] + '&frmDt=' + row[6] + '&toDate=' + '&no=' + no + '&calender=Months' + '&rptCode=107' + '&menuTitle=Cycle Count' + '&page=list" target=_blank > ' + data + '</a>';
                                return url;
                            }
                        },
                        { "title": "Total Pass", "width": "70px", "className": "text-right", "targets": 4 },
                        { "title": "Total Fail", "width": "60px", "className": "text-right", "targets": 5 },
                        { "title": "For Month", "width": "60px", "className": "text-right", "targets": 6 }


                    ]
                    //For Displaying  Footer Sum
                    var footerfunc2 = function () {
                        var api = this.api();
                        $(api.column(3).footer()).html(thousands_separators(api.column(3).data().sum()));
                        $(api.column(4).footer()).html(thousands_separators(api.column(4).data().sum()));
                        $(api.column(5).footer()).html(thousands_separators(api.column(5).data().sum()));
                    }

                    ToggleDataList(true);
                    MakeFrameGrid('lstCCAccuracy', data.lstCCAccuracy, 0, columnDef2, false, true, true, footerfunc2, false, false, false);

                }

                if (data["ErrorMessage"] != null) {
                    $('.dataTables_empty > p').text(data["ErrorMessage"]);
                }
            },
            onerror: function (r) { r },
            failure: function (r) { r }
        });

         function MakeFrameGrid(tableId, data, tableHeight, columns, buttonId, search, isScrollX, footerFunction, isFramed, reportTitle, isSqlDoc, showPaging) {
             var startTime = performance.now();
        var isFooter = footerFunction === undefined || footerFunction === false ? false : true;
        isFramed = isFramed === undefined || isFramed === false ? false : true;
        isScrollX = isScrollX === undefined ? false : true;
        if (search === undefined) { search = true; }
        reportTitle = reportTitle === undefined ? $('.box-title').text() : reportTitle;
        showPaging = showPaging === undefined ? true : false;

        var gridHeight = 0;
        var gridButtonsClass = '';
        //var gridButtonSize = 0;
        gridButtonsClass = 'btn-header btn-box-tool';
        gridSearchBoxClass = 'bg-white';
        gridButtonSize = 20;

        var layoutHeader = $('nav').innerHeight();
        //var topHeader = $('#topHeader').innerHeight();
        var cardHeader = $('.box-header').innerHeight();
        var canvas = $('.canvas').innerHeight();
        var tableHeader = $('#' + tableId + ' > thead').innerHeight();
        var tableFooter = 0;
        var cardFooterH = 30;

             
        if (showPaging)
            cardFooterH = 50;

        //if (isFooter === true)
        //    tableFooter = 24;

        var browserHeight = window.innerHeight;
        tableFooter = tableFooter === undefined ? 0 : tableFooter;
             gridHeight = browserHeight - (cardHeader + canvas + tableHeader + layoutHeader + tableFooter + cardFooterH);

        //For SQL Documentation
        var boxtool;
        if (search === true) {
            if (isFramed) {
                $('#trHeadSearch').empty();
                boxtool = '<input class="txtSearch-frame" id="txtFrameSearch" type="text" placeholder="Search.." style="padding-left: 10px !important;" >';
                $('#trHeadSearch').append(boxtool);
            }
            else {
                $('#' + buttonId).empty();
                if (isSqlDoc === true)
                    AddSqlDoc(buttonId);
                boxtool = '<input class="txtSearch-frame" id="txtFrameSearch' + tableId + '" type="text" placeholder="Search.." style="padding-left: 10px !important;" >';
                $('#' + buttonId).append(boxtool);
            }
        }
        else {
            if (isFramed) {
                $('#trHeadSearch').empty();
                boxtool = '<input class="txtSearch-frame" id="txtFrameSearch" type="text" placeholder="Search.." style="padding-left: 10px !important;" >';
                $('#trHeadSearch').append(boxtool);
            }
            else {
                $('#' + buttonId).empty();
                if (isSqlDoc === true)
                    AddSqlDoc(buttonId);
            }
        }

        var table = $('#' + tableId).DataTable({
            order: [],
            data: data,
            destroy: true,
            columns: columns,
            bInfo: showPaging,
            paging: showPaging,
            ordering: true,
            searching: search,
            deferRender: true,
            pagingType: 'full',
            pageLength: 100,
            scrollCollapse: false,
            scrollX: isScrollX,
            scrollY: gridHeight,
            footerCallback: footerFunction,
            language: {
                emptyTable: "<p style=\"text-align:left;\">No record(s) found.</p>",
                zeroRecords: "<p style=\"text-align:left;\">No matching record(s) found</p>",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                oPaginate: {
                    sNext: '<i class="fa fa-forward"></i>',
                    sPrevious: '<i class="fa fa-backward"></i>',
                    sFirst: '<i class="fa fa-step-backward"></i>',
                    sLast: '<i class="fa fa-step-forward"></i>'
                }
            },
            "dom": "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-sm-5'i><'#designedBy.col-sm-3'><'col-sm-4'p>>", // Added By Tahir
            buttons: [
                {
                    extend: 'copyHtml5',
                    footer: true,
                    text: '<span><span class="fa-stack"><i class="fa fa-circle fa-stack-2x" style="color: rgb(244, 164, 37);"></i><i class="fa fa-copy fa-stack-1x" style="color: white;"></i></span></span>',
                    titleAttr: 'Copy',
                    title: reportTitle,
                    filename: 'DataExport',
                    exportOptions: {
                        columns: 'th:not(.notexport)'
                    }
                },
                {
                    extend: 'excelHtml5',
                    footer: true,
                    text: '<span><span class="fa-stack"><i class="fa fa-circle fa-stack-2x" style="color: rgb(0, 179, 98);"></i><i class="fa fa-file-excel fa-stack-1x" style="color: white;"></i></span></span>',
                    titleAttr: 'Export to excel',
                    title: reportTitle,
                    filename: 'DataExport',
                    exportOptions: {
                        columns: 'th:not(.notexport)'
                    },
                    customize: function (xlsx) {
                        var sheet = xlsx.xl.worksheets['sheet1.xml'];
                        var excelColumns = [];

                        header = $("row[r=2]", sheet);

                        cols = header.find("c");
                        cols.each(function () {
                            t = $(this).find("t").text();
                            if (t.includes("Serial") || t.includes("Customer Ref."))
                                excelColumns.push($(this).attr("r"));
                        });
                        $(excelColumns).each(function () {
                            var cell = this.substring(0, 1);
                            $('row:gt(1) c[r^="' + cell + '"]', sheet).each(function () {
                                $(this).removeAttr('s');
                                $(this).attr('t', 'inlineStr');
                                $(this).find('v').replaceWith('<is><t>' + $(this).text() + '</t></is>');
                            });
                        });

                    }
                },
                {
                    extend: 'print',
                    footer: true,
                    text: '<span><span class="fa-stack"><i class="fa fa-circle fa-stack-2x" style="color: rgb(0, 204, 255);"></i><i class="fa fa-print fa-stack-1x" style="color: white;"></i></span></span>',
                    titleAttr: 'Print',
                    title: '',
                    messageTop: function () { return '<h4>' + reportTitle + '</h4>'; },
                    filename: 'DataExport',
                    exportOptions: {
                        columns: 'th:not(.notexport)'
                    }
                }

            ],
            select: true
        });

        table.buttons().container()
            .appendTo('#' + buttonId);

        table.button(0).nodes().removeClass('btn btn-default buttons-copy buttons-html5');
        table.button(0).nodes().addClass(gridButtonsClass);

        table.button(1).nodes().removeClass('btn btn-default buttons-excel buttons-html5');
        table.button(1).nodes().addClass(gridButtonsClass);

        table.button(2).nodes().removeClass('btn btn-default buttons-excel buttons-html5');
        table.button(2).nodes().addClass(gridButtonsClass);

        $('#txtFrameSearch' + tableId).on('keyup change', function () {
            table.search(this.value).draw();
        });
        $('.dataTables_filter').hide();
             table.columns.adjust().draw();

             var endTime = performance.now();
             var elapsedTimeInSeconds = (endTime - startTime) / 1000;

             $.ajax({
                 cache: false,
                 type: 'POST',
                 url: '/Home/SaveLog',
                 data: {
                     gridExecutionTime: elapsedTimeInSeconds
                 },
                 success: function () {
                     //console.log('Value sent to controller!');
                 },
                 error: function () {
                     //console.log('Error sending value to controller!');
                 }
             }); //Added by Huzaifa


    }
    }

    function DrawMeChart(chartId, data, title, chartType) {
        var calender = $('#calender option:selected').text();

        chartId.data = [];
        window.myBar = new Chart(chartId, {
            type: chartType,
            data: data,
            options: {
                legend: {
                    display: true,
                    labels: {
                        fontColor: '#000000',
                    },

                },
                title: {
                    display: true,
                    text: title,
                    fontColor: '#000000',
                },
                responsive: true,
                scales: {
                    scaleLabel: {
                        fontColor: '#000000'
                    },
                    xAxes: [{
                        stacked: false,
                        barThickness: 50,
                        maxBarThickness: 28,
                        minBarLength: 16,

                        ticks: {
                            fontColor: '#000000',
                            padding: 10,
                            autoSkip: false,
                            maxRotation: 35,
                            minRotation: 35
                        },
                        scaleLabel: {
                            display: true,
                            labelString: calender + '⇧',
                            fontColor: '#000000',
                            fontFamily: 'font/serif_bold',
                            fontWeight: '700',
                        },
                    }],
                    yAxes: [{
                        stacked: false,
                        ticks: {
                            fontColor: '#000000',
                            min: 0,
                            
                        },
                        gridLines: {
                            display: true,
                        }
                    }]
                   

                },
            }
        });
    }

        //Change dafault color
    Chart.defaults.global.defaultFontColor = "#fff";

    function GenereteSummaryData(summaryData) {
        var dataChart = summaryData;
        $.each(dataChart, function (index, value) {
            if (index == 0) {
                $.each(value, function (index, value) {
                    if (index > 0)
                        label.push(value);
                });
            }
            else if (index == 1) {
                value = value == '' ? '0' : value;
                $.each(value, function (index, value) {

                    if (index > 0)
                        Pass.push(value);
                });
            }
            else if (index == 2){
                value = value == '' ? '0' : value;
                $.each(value, function (index, value) {

                    if (index > 0)
                        Fail.push(value);
                });
            }
            else if (index == 4) {
                value = value == '' ? '0' : value;
                $.each(value, function (index, value) {

                    if (index > 0)
                        percentage.push(value);

                });
            }
        });
    }
</script>





